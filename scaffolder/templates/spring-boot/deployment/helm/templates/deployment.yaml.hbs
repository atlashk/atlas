apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{projectName}}
  labels:
    app.kubernetes.io/name: {{projectName}}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{projectName}}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{projectName}}
    spec:
      containers:
        - name: app
          image: {{projectName}}:latest
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 8080
