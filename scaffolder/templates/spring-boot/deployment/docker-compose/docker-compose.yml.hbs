
version: '3.8'
services:
  app:
    build: .
    ports:
      - "8080:8080"
    environment:
      {{#if (eq stack.database 'postgresql')}}
      - SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/{{projectName}}
      - SPRING_DATASOURCE_USERNAME=postgres
      - SPRING_DATASOURCE_PASSWORD=password
      {{/if}}
      {{#if (eq stack.database 'mysql')}}
      - SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/{{projectName}}
      - SPRING_DATASOURCE_USERNAME=root
      - SPRING_DATASOURCE_PASSWORD=password
      {{/if}}
    depends_on:
      {{#if (eq stack.database 'postgresql')}}- db{{/if}}
      {{#if (eq stack.database 'mysql')}}- db{{/if}}

  {{#if (eq stack.database 'postgresql')}}
  db:
    image: postgres:15-alpine
    environment:
      - POSTGRES_DB={{projectName}}
      - POSTGRES_PASSWORD=password
    ports:
      - "5432:5432"
  {{/if}}
  
  {{#if (eq stack.database 'mysql')}}
  db:
    image: mysql:8.0
    environment:
      - MYSQL_DATABASE={{projectName}}
      - MYSQL_ROOT_PASSWORD=password
    ports:
      - "3306:3306"
  {{/if}}
