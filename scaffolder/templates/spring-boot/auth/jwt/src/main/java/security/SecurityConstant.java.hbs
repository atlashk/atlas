package {{basePackage}}.security;

import lombok.experimental.UtilityClass;

@UtilityClass
public class SecurityConstant {

  public static final String SIGNING_ALGORITHM = "{{jwt.signingAlgorithm}}";
  public static final long ACCESS_TOKEN_TTL_SECONDS = {{jwt.accessTokenTtlSeconds}};
  public static final long REFRESH_TOKEN_TTL_SECONDS = {{jwt.refreshTokenTtlSeconds}};
  public static final String ISSUER = "{{projectName}}";
  public static final String AUDIENCE = "{{projectName}}";

  public static final String CLIENT_TOKEN_TRANSPORT_TYPE = "{{jwt.clientTokenTransport.type}}";

  public static final String HEADER_NAME =
      {{#if (eq jwt.clientTokenTransport.type 'authorization_header')}}"{{jwt.clientTokenTransport.headerName}}"{{else}}null{{/if}};
  public static final String HEADER_PREFIX =
      {{#if (eq jwt.clientTokenTransport.type 'authorization_header')}}"{{jwt.clientTokenTransport.prefix}}"{{else}}null{{/if}};

  public static final String ACCESS_TOKEN_COOKIE_NAME =
      {{#if (eq jwt.clientTokenTransport.type 'cookie')}}"{{jwt.clientTokenTransport.accessTokenCookieName}}"{{else}}null{{/if}};
  public static final String REFRESH_TOKEN_COOKIE_NAME =
      {{#if (eq jwt.clientTokenTransport.type 'cookie')}}"{{jwt.clientTokenTransport.refreshTokenCookieName}}"{{else}}null{{/if}};
}

