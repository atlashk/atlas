{
  "id": null,
  "title": "Metrics Dashboard",
  "tags": [
    "metrics",
    "resources",
    "jvm",
    "api"
  ],
  "style": "dark",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Service Health Status",
      "type": "stat",
      "targets": [
        {
          "expr": "up{job=~\".*-service-metrics|.*-server-metrics\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "API Request Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(api_latency_ms_count{job=~\".*-service-metrics\"}[5m])",
          "legendFormat": "{{service}} - {{endpoint}} (Custom)",
          "refId": "A"
        },
        {
          "expr": "rate(http_server_requests_seconds_count{job=~\".*-service-metrics|.*-server-metrics\"}[5m])",
          "legendFormat": "{{job}} - {{uri}} (Spring Boot)",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "yAxes": [
        {
          "label": "Requests/sec",
          "min": 0
        }
      ]
    },
    {
      "id": 3,
      "title": "API Response Time (95th percentile)",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(api_latency_ms_bucket{job=~\".*-service-metrics\"}[5m]))",
          "legendFormat": "{{service}} - {{endpoint}} (Custom)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{job=~\".*-service-metrics|.*-server-metrics\"}[5m])) * 1000",
          "legendFormat": "{{job}} - {{uri}} (Spring Boot)",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "yAxes": [
        {
          "label": "Milliseconds",
          "min": 0
        }
      ]
    },
    {
      "id": 4,
      "title": "API Error Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(api_latency_ms_count{job=~\".*-service-metrics\",http_status=~\"4..|5..\"}[5m]) / rate(api_latency_ms_count{job=~\".*-service-metrics\"}[5m]) * 100",
          "legendFormat": "{{service}} - {{endpoint}} (Custom)",
          "refId": "A"
        },
        {
          "expr": "rate(http_server_requests_seconds_count{job=~\".*-service-metrics|.*-server-metrics\",status=~\"4..|5..\"}[5m]) / rate(http_server_requests_seconds_count{job=~\".*-service-metrics|.*-server-metrics\"}[5m]) * 100",
          "legendFormat": "{{job}} - {{uri}} (Spring Boot)",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "yAxes": [
        {
          "label": "Error Rate (%)",
          "min": 0,
          "max": 100
        }
      ]
    },
    {
      "id": 5,
      "title": "API Requests by HTTP Status",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(api_latency_ms_count{job=~\".*-service-metrics\",http_status=~\"2..\"}[5m])",
          "legendFormat": "{{service}} - 2xx Success",
          "refId": "A"
        },
        {
          "expr": "rate(api_latency_ms_count{job=~\".*-service-metrics\",http_status=~\"4..\"}[5m])",
          "legendFormat": "{{service}} - 4xx Client Error",
          "refId": "B"
        },
        {
          "expr": "rate(api_latency_ms_count{job=~\".*-service-metrics\",http_status=~\"5..\"}[5m])",
          "legendFormat": "{{service}} - 5xx Server Error",
          "refId": "C"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "yAxes": [
        {
          "label": "Requests/sec",
          "min": 0
        }
      ]
    },
    {
      "id": 6,
      "title": "JVM Memory Usage",
      "type": "graph",
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=~\".*-service-metrics|.*-server-metrics\",area=\"heap\"} / jvm_memory_max_bytes{job=~\".*-service-metrics|.*-server-metrics\",area=\"heap\"} * 100",
          "legendFormat": "{{job}} - Heap Usage %",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "yAxes": [
        {
          "label": "Percentage",
          "min": 0,
          "max": 100
        }
      ]
    },
    {
      "id": 7,
      "title": "JVM Memory Details",
      "type": "graph",
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=~\".*-service-metrics|.*-server-metrics\",area=\"heap\"} / 1024 / 1024",
          "legendFormat": "{{job}} - Heap Used (MB)",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_max_bytes{job=~\".*-service-metrics|.*-server-metrics\",area=\"heap\"} / 1024 / 1024",
          "legendFormat": "{{job}} - Heap Max (MB)",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "yAxes": [
        {
          "label": "Memory (MB)",
          "min": 0
        }
      ]
    },
    {
      "id": 8,
      "title": "JVM Garbage Collection",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_count{job=~\".*-service-metrics|.*-server-metrics\"}[5m])",
          "legendFormat": "{{job}} - {{gc}} GC Events/sec",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "yAxes": [
        {
          "label": "GC Events/sec",
          "min": 0
        }
      ]
    },
    {
      "id": 9,
      "title": "JVM Threads",
      "type": "graph",
      "targets": [
        {
          "expr": "jvm_threads_live_threads{job=~\".*-service-metrics|.*-server-metrics\"}",
          "legendFormat": "{{job}} - Live Threads",
          "refId": "A"
        },
        {
          "expr": "jvm_threads_daemon_threads{job=~\".*-service-metrics|.*-server-metrics\"}",
          "legendFormat": "{{job}} - Daemon Threads",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "yAxes": [
        {
          "label": "Threads",
          "min": 0
        }
      ]
    },
    {
      "id": 10,
      "title": "CPU Usage",
      "type": "graph",
      "targets": [
        {
          "expr": "system_cpu_usage{job=~\".*-service-metrics|.*-server-metrics\"} * 100",
          "legendFormat": "{{job}} - System CPU %",
          "refId": "A"
        },
        {
          "expr": "process_cpu_usage{job=~\".*-service-metrics|.*-server-metrics\"} * 100",
          "legendFormat": "{{job}} - Process CPU %",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "yAxes": [
        {
          "label": "CPU Usage (%)",
          "min": 0,
          "max": 100
        }
      ]
    },
    {
      "id": 11,
      "title": "Thread Pool Usage",
      "type": "graph",
      "targets": [
        {
          "expr": "tomcat_threads_busy_threads{job=~\".*-service-metrics|.*-server-metrics\"}",
          "legendFormat": "{{job}} - Busy Threads",
          "refId": "A"
        },
        {
          "expr": "tomcat_threads_config_max_threads{job=~\".*-service-metrics|.*-server-metrics\"}",
          "legendFormat": "{{job}} - Max Threads",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "yAxes": [
        {
          "label": "Threads",
          "min": 0
        }
      ]
    },
    {
      "id": 12,
      "title": "Database Connection Pool",
      "type": "graph",
      "targets": [
        {
          "expr": "hikaricp_connections_active{job=~\".*-service-metrics\"}",
          "legendFormat": "{{job}} - Active Connections",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{job=~\".*-service-metrics\"}",
          "legendFormat": "{{job}} - Idle Connections",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_max{job=~\".*-service-metrics\"}",
          "legendFormat": "{{job}} - Max Connections",
          "refId": "C"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 46
      },
      "yAxes": [
        {
          "label": "Connections",
          "min": 0
        }
      ]
    },
    {
      "id": 13,
      "title": "Cache Metrics",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(cache_gets_total{result=\"hit\"}[5m])",
          "legendFormat": "Cache Hits/sec",
          "refId": "A"
        },
        {
          "expr": "rate(cache_gets_total{result=\"miss\"}[5m])",
          "legendFormat": "Cache Misses/sec",
          "refId": "B"
        },
        {
          "expr": "rate(cache_puts_total[5m])",
          "legendFormat": "Cache Puts/sec",
          "refId": "C"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 46
      },
      "yAxes": [
        {
          "label": "Operations/sec",
          "min": 0
        }
      ]
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "query": "label_values(up{job=~\".*-service-metrics|.*-server-metrics\"}, job)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "refresh": "10s",
  "schemaVersion": 27,
  "version": 1,
  "links": []
}