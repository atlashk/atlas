{
  "id": null,
  "title": "Logs Dashboard",
  "tags": [
    "logs",
    "applications"
  ],
  "style": "dark",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Log Volume by Service",
      "type": "graph",
      "targets": [
        {
          "expr": "sum by (service_name) (count_over_time({service_name=~\".*\"}[1m]))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "yAxes": [
        {
          "label": "Log Lines/min",
          "min": 0
        }
      ]
    },
    {
      "id": 2,
      "title": "Log Levels Distribution",
      "type": "piechart",
      "targets": [
        {
          "expr": "sum by (level) (count_over_time({service_name=~\".*\"} | json | __error__=\"\" [5m]))",
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "Error Logs",
      "type": "logs",
      "targets": [
        {
          "expr": "{service_name=~\"$service\"} |= \"ERROR\"",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 4,
      "title": "Warning Logs",
      "type": "logs",
      "targets": [
        {
          "expr": "{service_name=~\"$service\"} |= \"WARN\"",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 5,
      "title": "Error Rate by Service",
      "type": "graph",
      "targets": [
        {
          "expr": "sum by (service_name) (rate({service_name=~\".*\"} |= \"ERROR\" [5m]))",
          "legendFormat": "{{service_name}} - Errors/sec",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "yAxes": [
        {
          "label": "Errors/sec",
          "min": 0
        }
      ]
    },
    {
      "id": 6,
      "title": "Log Search",
      "type": "logs",
      "targets": [
        {
          "expr": "{service_name=~\"$service\"} |~ \"$search_query\"",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 7,
      "title": "Recent Application Logs",
      "type": "logs",
      "targets": [
        {
          "expr": "{service_name=~\"$service\"}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "query": "label_values(service_name)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "datasource": "Loki"
      },
      {
        "name": "search_query",
        "type": "textbox",
        "label": "Search Query",
        "description": "Enter text to search in logs"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "refresh": "10s",
  "schemaVersion": 27,
  "version": 1,
  "links": []
}