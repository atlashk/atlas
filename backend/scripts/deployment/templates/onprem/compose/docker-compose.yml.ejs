<%
  const apiClient = (stack['api-client'] || 'rest-restclient').toLowerCase();
  const apiClientPrefix = (apiClient.split('-')[0] || 'rest');
  const authServer = (stack['auth-server'] || '').toLowerCase();
  const datasource = (stack.datasource || '').toLowerCase();
  const kvStore = (stack['kv-store'] || '').toLowerCase();
  const messaging = (stack.messaging || '').toLowerCase();
  const search = (stack.search || '').toLowerCase();
  const storage = (stack.storage || '').toLowerCase();
  const notificationEmail = (stack.notification.email || '').toLowerCase();
  const observabilityLoggingStack = (stack.observability.logging.stack || '').toLowerCase();
  const observabilityMetrics = (stack.observability.metrics || '').toLowerCase();
  const observabilityTracing = (stack.observability.tracing || '').toLowerCase();
  const reverseProxy = (stack['reverse-proxy'] || '').toLowerCase();

  const hasSpringSecurityJwt = authServer === 'spring-security-jwt';
  const hasMysql = datasource === 'mysql';
  const hasPostgres = datasource === 'postgres' || datasource === 'postgresql';
  const hasRedis = kvStore === 'redis';
  const hasKafka = messaging === 'kafka';
  const hasRabbit = messaging === 'rabbitmq';
  const hasElasticsearch = search === 'elasticsearch';
  const hasMinio = storage === 'minio';
  const hasSmtp4dev = notificationEmail === 'spring';
  const hasLoki = observabilityLoggingStack === 'loki';
  const hasPrometheus = observabilityMetrics === 'prometheus';
  const hasZipkin = observabilityTracing === 'zipkin';
  const hasGrafana = hasLoki || hasPrometheus || hasZipkin;
  const hasNginx = reverseProxy === 'nginx';
%>
services:

  <%_ if (hasMysql) { -%>
  mysql:
    container_name: mysql
    image: mysql:8.0
    ports:
      - "3306:3306"
    environment:
      - MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD:-secret123456}
      - MYSQL_USER=${MYSQL_USER:-atlas}
      - MYSQL_PASSWORD=${MYSQL_PASSWORD:-secret123456}
    volumes:
      - ./config/mysql/initdb.sh:/docker-entrypoint-initdb.d/initdb.sh
      - mysql-data:/var/lib/mysql
    command: --default-authentication-plugin=mysql_native_password
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h localhost -u root -p\"$MYSQL_ROOT_PASSWORD\" || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - atlas-network
  <%_ } -%>

  <%_ if (hasPostgres) { -%>
  postgres:
    container_name: postgres
    image: postgres:14
    ports:
      - "5432:5432"
    environment:
      - POSTGRES_USER=${POSTGRES_USER:-atlas}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-secret123456}
    volumes:
      - ./config/postgres/initdb.sh:/docker-entrypoint-initdb.d/initdb.sh
      - postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U \"$POSTGRES_USER\" -h localhost || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - atlas-network
  <%_ } -%>

  <%_ if (hasRedis) { -%>
  redis:
    container_name: redis
    image: redis:7
    ports:
      - "6379:6379"
    volumes:
      - redis-data:/var/lib/redis
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 10s
    networks:
      - atlas-network
  <%_ } -%>

  <%_ if (hasKafka) { -%>
  kafka:
    container_name: kafka
    image: confluentinc/cp-kafka:7.9.0
    ports:
      - "9092:9092"
      - "9101:9101"
    environment:
      - KAFKA_NODE_ID=1
      - KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
      - KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092
      - KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
      - KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
      - KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
      - KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
      - KAFKA_JMX_PORT=9101
      - KAFKA_JMX_HOSTNAME=localhost
      - KAFKA_PROCESS_ROLES=broker,controller
      - KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:29093
      - KAFKA_LISTENERS=PLAINTEXT://kafka:29092,CONTROLLER://kafka:29093,PLAINTEXT_HOST://0.0.0.0:9092
      - KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
      - KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
      - KAFKA_LOG_DIRS=/tmp/kraft-combined-logs
      - CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
    volumes:
      - kafka-data:/var/lib/kafka/data
    healthcheck:
      test: ["CMD", "kafka-broker-api-versions", "--bootstrap-server", "localhost:9092"]
      interval: 10s
      timeout: 10s
      retries: 5
      start_period: 60s
    networks:
      - atlas-network
  <%_ } -%>

  <%_ if (hasRabbit) { -%>
  rabbitmq:
    container_name: rabbitmq
    build:
      context: rabbitmq
      dockerfile: ./config/rabbitmq/Dockerfile
    ports:
      - "5672:5672"
      - "15672:15672"
    environment:
      - RABBITMQ_DEFAULT_USER=${RABBITMQ_USER:-atlas}
      - RABBITMQ_DEFAULT_PASS=${RABBITMQ_PASSWORD:-secret123456}
    volumes:
      - rabbitmq-data:/var/lib/rabbitmq
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - atlas-network
  <%_ } -%>

  <%_ if (hasMinio) { -%>
  minio:
    container_name: minio
    image: minio/minio:latest
    ports:
      - "9000:9000"
      - "9001:9001"
    environment:
      - MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY:-atlas}
      - MINIO_SECRET_KEY=${MINIO_SECRET_KEY:-secret123456}
    command: server /data --console-address ":9001"
    volumes:
      - minio-data:/data
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000/minio/health/live"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s
    networks:
      - atlas-network
  <%_ } -%>

  <%_ if (hasElasticsearch) { -%>
  elasticsearch:
    container_name: elasticsearch
    image: docker.elastic.co/elasticsearch/elasticsearch:9.2.0
    ports:
      - "9200:9200"
      - "9300:9300"
    environment:
      - discovery.type=single-node
      - xpack.security.enabled=true
      - ELASTIC_PASSWORD=${ELASTICSEARCH_PASSWORD:-secret123456}
    volumes:
      - elasticsearch-data:/usr/share/elasticsearch/data
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:9200/_cluster/health?wait_for_status=yellow || exit 1"]
      interval: 10s
      timeout: 10s
      retries: 10
      start_period: 60s
    networks:
      - atlas-network
  <%_ } -%>

  <%_ if (hasSmtp4dev) { -%>
  smtp4dev:
    container_name: smtp4dev
    image: rnwood/smtp4dev:latest
    ports:
      - "5000:80"
      - "25:25"
      - "143:143"
    volumes:
      - smtp4dev-data:/smtp4dev
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:80 || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - atlas-network
  <%_ } -%>

  <%_ if (hasPrometheus) { -%>
  prometheus:
    container_name: prometheus
    image: prom/prometheus:main
    ports:
      - "9090:9090"
    command:
      - '--config.file=/etc/prometheus/prometheus-config.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--web.console.libraries=/etc/prometheus/console_libraries'
      - '--web.console.templates=/etc/prometheus/consoles'
      - '--storage.tsdb.retention.time=15d'
      - '--web.enable-lifecycle'
    volumes:
      - ./config/prometheus/config.yml:/etc/prometheus/prometheus-config.yml:ro
      - prometheus-data:/prometheus
    healthcheck:
      test: ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:9090/-/healthy || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - atlas-network
  <%_ } -%>

  <%_ if (hasLoki) { -%>
  loki:
    container_name: loki
    image: grafana/loki:main
    ports:
      - "3100:3100"
    command: -config.file=/etc/loki/local-config.yaml
    healthcheck:
      test: ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:3100/ready || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - atlas-network

  promtail:
    container_name: promtail
    image: grafana/promtail:main
    command: -config.file=/etc/promtail/config.yml
    volumes:
      - ./config/promtail/config.yml:/etc/promtail/config.yml:ro
      <%_ if (hasSpringSecurityJwt) { -%>
      - auth-server-log:/var/log/auth-server
      <%_ } -%>
      - user-service-log:/var/log/user-service
      - product-service-log:/var/log/product-service
      - order-service-log:/var/log/order-service
      - payment-service-log:/var/log/payment-service
      - notification-service-log:/var/log/notification-service
      - eureka-server-log:/var/log/eureka-server
      - api-gateway-log:/var/log/api-gateway
    healthcheck:
      test: [ "CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:9080/metrics || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - atlas-network
  <%_ } -%>

  <%_ if (hasGrafana) { -%>
  grafana:
    container_name: grafana
    image: grafana/grafana-oss:main
    ports:
      - "3000:3000"
    environment:
      - GF_SECURITY_ADMIN_USER=${GRAFANA_ADMIN_USER:-atlas}
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD:-secret123456}
      - GF_PATHS_PROVISIONING=/etc/grafana/provisioning
      - GF_INSTALL_PLUGINS=grafana-piechart-panel,grafana-worldmap-panel,grafana-clock-panel
    volumes:
      - grafana-data:/var/lib/grafana
      - ./config/grafana/provisioning:/etc/grafana/provisioning:ro
      - ./config/grafana/dashboards:/etc/grafana/dashboards:ro
    healthcheck:
      test: ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 60s
    networks:
      - atlas-network
  <%_ } -%>

  <%_ if (hasZipkin) { -%>
  zipkin:
    container_name: zipkin
    image: openzipkin/zipkin
    ports:
      - "9411:9411"
    environment:
      - STORAGE_TYPE=mem
    healthcheck:
      test: ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:9411/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - atlas-network
  <%_ } -%>

  eureka-server:
    container_name: eureka-server
    image: atlas-eureka-server
    ports:
      - "8761:8761"
    volumes:
      - eureka-server-log:/var/log/eureka-server
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:8761/actuator/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    networks:
      - atlas-network

<%_ if (hasSpringSecurityJwt) { -%>
  auth-server:
    container_name: auth-server
    image: atlas-auth-server
    ports:
      - "8091:8091"
    depends_on:
      eureka-server:
        condition: service_healthy
      <%_ if (hasMysql) { -%>
      mysql:
        condition: service_healthy
      <%_ } -%>
      <%_ if (hasPostgres) { -%>
      postgres:
        condition: service_healthy
      <%_ } -%>
      <%_ if (hasRedis) { -%>
      redis:
        condition: service_healthy
      <%_ } -%>
    environment:
      - EUREKA_DEFAULT_ZONE=http://eureka-server:8761/eureka
      <%_ if (hasMysql) { -%>
      - DB_URL=jdbc:mysql://mysql:3306/db_auth?useUnicode=yes&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
      - DB_USERNAME=${MYSQL_USERNAME:-atlas}
      - DB_PASSWORD=${MYSQL_PASSWORD:-secret123456}
      <%_ } else if (hasPostgres) { -%>
      - DB_URL=jdbc:postgresql://postgres:5432/db_auth
      - DB_USERNAME=${POSTGRES_USERNAME:-atlas}
      - DB_PASSWORD=${POSTGRES_PASSWORD:-secret123456}
      <%_ } -%>
      <%_ if (hasRedis) { -%>
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      <%_ } -%>
      <%_ if (hasZipkin) { -%>
      - ZIPKIN_ENDPOINT=http://zipkin:9411/api/v2/spans
      <%_ } -%>
    volumes:
      - auth-server-log:/var/log/auth-server
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:8091/actuator/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    networks:
      - atlas-network
<%_ } -%>

  user-service:
    container_name: user-service
    image: atlas-user-service
    ports:
      - "8081:8081"
    depends_on:
      eureka-server:
        condition: service_healthy
      <%_ if (hasMysql) { -%>
      mysql:
        condition: service_healthy
      <%_ } -%>
      <%_ if (hasPostgres) { -%>
      postgres:
        condition: service_healthy
      <%_ } -%>
      <%_ if (hasRedis) { -%>
      redis:
        condition: service_healthy
      <%_ } -%>
      <%_ if (hasKafka) { -%>
      kafka:
        condition: service_healthy
      <%_ } -%>
      <%_ if (hasRabbit) { -%>
      rabbitmq:
        condition: service_healthy
      <%_ } -%>
    environment:
      - EUREKA_DEFAULT_ZONE=http://eureka-server:8761/eureka
      <%_ if (hasMysql) { -%>
      - DB_URL=jdbc:mysql://mysql:3306/db_user?useUnicode=yes&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
      - DB_USERNAME=${MYSQL_USERNAME:-atlas}
      - DB_PASSWORD=${MYSQL_PASSWORD:-secret123456}
      <%_ } else if (hasPostgres) { -%>
      - DB_URL=jdbc:postgresql://postgres:5432/db_user
      - DB_USERNAME=${POSTGRES_USERNAME:-atlas}
      - DB_PASSWORD=${POSTGRES_PASSWORD:-secret123456}
      <%_ } -%>
      <%_ if (hasRedis) { -%>
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      <%_ } -%>
      <%_ if (hasKafka) { -%>
      - KAFKA_BOOTSTRAP_SERVERS=kafka:29092
      <%_ } else if (hasRabbit) { -%>
      - RABBITMQ_HOST=rabbitmq
      - RABBITMQ_PORT=5672
      - RABBITMQ_USERNAME=${RABBITMQ_USERNAME:-atlas}
      - RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD:-secret123456}
      <%_ } -%>
      <%_ if (apiClientPrefix === 'grpc') { -%>
      - GRPC_CLIENT_PRODUCT_ADDRESS=static://product-service:50052
      <%_ } else { -%>
      - API_CLIENT_REST_PRODUCT_SERVICE_BASE_URL=http://product-service:8082
      <%_ } -%>
      <%_ if (hasZipkin) { -%>
      - ZIPKIN_ENDPOINT=http://zipkin:9411/api/v2/spans
      <%_ } -%>
    volumes:
      - user-service-log:/var/log/user-service
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:8081/actuator/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    networks:
      - atlas-network

  product-service:
    container_name: product-service
    image: atlas-product-service
    ports:
      - "8082:8082"
    depends_on:
      eureka-server:
        condition: service_healthy
      <%_ if (hasMysql) { -%>
      mysql:
        condition: service_healthy
      <%_ } -%>
      <%_ if (hasPostgres) { -%>
      postgres:
        condition: service_healthy
      <%_ } -%>
      <%_ if (hasRedis) { -%>
      redis:
        condition: service_healthy
      <%_ } -%>
      <%_ if (hasKafka) { -%>
      kafka:
        condition: service_healthy
      <%_ } -%>
      <%_ if (hasRabbit) { -%>
      rabbitmq:
        condition: service_healthy
      <%_ } -%>
      <%_ if (hasElasticsearch) { -%>
      elasticsearch:
        condition: service_healthy
      <%_ } -%>
    environment:
      - EUREKA_DEFAULT_ZONE=http://eureka-server:8761/eureka
      <%_ if (hasMysql) { -%>
      - DB_URL=jdbc:mysql://mysql:3306/db_product?useUnicode=yes&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
      - DB_USERNAME=${MYSQL_USERNAME:-atlas}
      - DB_PASSWORD=${MYSQL_PASSWORD:-secret123456}
      <%_ } else if (hasPostgres) { -%>
      - DB_URL=jdbc:postgresql://postgres:5432/db_product
      - DB_USERNAME=${POSTGRES_USERNAME:-atlas}
      - DB_PASSWORD=${POSTGRES_PASSWORD:-secret123456}
      <%_ } -%>
      <%_ if (hasRedis) { -%>
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      <%_ } -%>
      <%_ if (hasKafka) { -%>
      - KAFKA_BOOTSTRAP_SERVERS=kafka:29092
      <%_ } else if (hasRabbit) { -%>
      - RABBITMQ_HOST=rabbitmq
      - RABBITMQ_PORT=5672
      - RABBITMQ_USERNAME=${RABBITMQ_USERNAME:-atlas}
      - RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD:-secret123456}
      <%_ } -%>
      <%_ if (hasElasticsearch) { -%>
      - ELASTICSEARCH_HOST=elasticsearch
      - ELASTICSEARCH_PORT=9200
      - ELASTICSEARCH_USERNAME=${ELASTICSEARCH_USERNAME:-elastic}
      - ELASTICSEARCH_PASSWORD=${ELASTICSEARCH_PASSWORD:-secret123456}
      <%_ } -%>
      <%_ if (hasMinio) { -%>
      - MINIO_ENDPOINT=http://minio:9000
      - MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY:-atlas}
      - MINIO_SECRET_KEY=${MINIO_SECRET_KEY:-secret123456}
      <%_ } -%>
      <%_ if (hasZipkin) { -%>
      - ZIPKIN_ENDPOINT=http://zipkin:9411/api/v2/spans
      <%_ } -%>
    volumes:
      - product-service-log:/var/log/product-service
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:8082/actuator/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    networks:
      - atlas-network

  order-service:
    container_name: order-service
    image: atlas-order-service
    ports:
      - "8083:8083"
    depends_on:
      eureka-server:
        condition: service_healthy
      <%_ if (hasMysql) { -%>
      mysql:
        condition: service_healthy
      <%_ } -%>
      <%_ if (hasPostgres) { -%>
      postgres:
        condition: service_healthy
      <%_ } -%>
      <%_ if (hasRedis) { -%>
      redis:
        condition: service_healthy
      <%_ } -%>
      <%_ if (hasKafka) { -%>
      kafka:
        condition: service_healthy
      <%_ } -%>
      <%_ if (hasRabbit) { -%>
      rabbitmq:
        condition: service_healthy
      <%_ } -%>
    environment:
      - EUREKA_DEFAULT_ZONE=http://eureka-server:8761/eureka
      <%_ if (hasMysql) { -%>
      - DB_URL=jdbc:mysql://mysql:3306/db_order?useUnicode=yes&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
      - DB_USERNAME=${MYSQL_USERNAME:-atlas}
      - DB_PASSWORD=${MYSQL_PASSWORD:-secret123456}
      <%_ } else if (hasPostgres) { -%>
      - DB_URL=jdbc:postgresql://postgres:5432/db_order
      - DB_USERNAME=${POSTGRES_USERNAME:-atlas}
      - DB_PASSWORD=${POSTGRES_PASSWORD:-secret123456}
      <%_ } -%>
      <%_ if (hasRedis) { -%>
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      <%_ } -%>
      <%_ if (hasKafka) { -%>
      - KAFKA_BOOTSTRAP_SERVERS=kafka:29092
      <%_ } else if (hasRabbit) { -%>
      - RABBITMQ_HOST=rabbitmq
      - RABBITMQ_PORT=5672
      - RABBITMQ_USERNAME=${RABBITMQ_USERNAME:-atlas}
      - RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD:-secret123456}
      <%_ } -%>
      <%_ if (apiClientPrefix === 'grpc') { -%>
      - GRPC_CLIENT_USER_ADDRESS=static://user-service:50051
      - GRPC_CLIENT_PRODUCT_ADDRESS=static://product-service:50052
      <%_ } else { -%>
      - API_CLIENT_REST_USER_SERVICE_BASE_URL=http://user-service:8081
      - API_CLIENT_REST_PRODUCT_SERVICE_BASE_URL=http://product-service:8082
      <%_ } -%>
      <%_ if (hasZipkin) { -%>
      - ZIPKIN_ENDPOINT=http://zipkin:9411/api/v2/spans
      <%_ } -%>
    volumes:
      - order-service-log:/var/log/order-service
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:8083/actuator/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    networks:
      - atlas-network

  payment-service:
    container_name: payment-service
    image: atlas-payment-service
    ports:
      - "8084:8084"
    depends_on:
      eureka-server:
        condition: service_healthy
      <%_ if (hasMysql) { -%>
      mysql:
        condition: service_healthy
      <%_ } -%>
      <%_ if (hasPostgres) { -%>
      postgres:
        condition: service_healthy
      <%_ } -%>
      <%_ if (hasRedis) { -%>
      redis:
        condition: service_healthy
      <%_ } -%>
      <%_ if (hasKafka) { -%>
      kafka:
        condition: service_healthy
      <%_ } -%>
      <%_ if (hasRabbit) { -%>
      rabbitmq:
        condition: service_healthy
      <%_ } -%>
    environment:
      - EUREKA_DEFAULT_ZONE=http://eureka-server:8761/eureka
      <%_ if (hasMysql) { -%>
      - DB_URL=jdbc:mysql://mysql:3306/db_payment?useUnicode=yes&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
      - DB_USERNAME=${MYSQL_USERNAME:-atlas}
      - DB_PASSWORD=${MYSQL_PASSWORD:-secret123456}
      <%_ } else if (hasPostgres) { -%>
      - DB_URL=jdbc:postgresql://postgres:5432/db_payment
      - DB_USERNAME=${POSTGRES_USERNAME:-atlas}
      - DB_PASSWORD=${POSTGRES_PASSWORD:-secret123456}
      <%_ } -%>
      <%_ if (hasRedis) { -%>
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      <%_ } -%>
      <%_ if (hasKafka) { -%>
      - KAFKA_BOOTSTRAP_SERVERS=kafka:29092
      <%_ } else if (hasRabbit) { -%>
      - RABBITMQ_HOST=rabbitmq
      - RABBITMQ_PORT=5672
      - RABBITMQ_USERNAME=${RABBITMQ_USERNAME:-atlas}
      - RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD:-secret123456}
      <%_ } -%>
      <%_ if (hasZipkin) { -%>
      - ZIPKIN_ENDPOINT=http://zipkin:9411/api/v2/spans
      <%_ } -%>
    volumes:
      - payment-service-log:/var/log/payment-service
    healthcheck:
      test: [ "CMD-SHELL", "curl -f http://localhost:8084/actuator/health || exit 1" ]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    networks:
      - atlas-network

  notification-service:
    container_name: notification-service
    image: atlas-notification-service
    ports:
      - "8085:8085"
    depends_on:
      eureka-server:
        condition: service_healthy
      <%_ if (hasMysql) { -%>
      mysql:
        condition: service_healthy
      <%_ } -%>
      <%_ if (hasPostgres) { -%>
      postgres:
        condition: service_healthy
      <%_ } -%>
      <%_ if (hasRedis) { -%>
      redis:
        condition: service_healthy
      <%_ } -%>
      <%_ if (hasKafka) { -%>
      kafka:
        condition: service_healthy
      <%_ } -%>
      <%_ if (hasRabbit) { -%>
      rabbitmq:
        condition: service_healthy
      <%_ } -%>
    environment:
      - EUREKA_DEFAULT_ZONE=http://eureka-server:8761/eureka
      <%_ if (hasMysql) { -%>
      - DB_URL=jdbc:mysql://mysql:3306/db_notification?useUnicode=yes&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
      - DB_USERNAME=${MYSQL_USERNAME:-atlas}
      - DB_PASSWORD=${MYSQL_PASSWORD:-secret123456}
      <%_ } else if (hasPostgres) { -%>
      - DB_URL=jdbc:postgresql://postgres:5432/db_notification
      - DB_USERNAME=${POSTGRES_USERNAME:-atlas}
      - DB_PASSWORD=${POSTGRES_PASSWORD:-secret123456}
      <%_ } -%>
      <%_ if (hasRedis) { -%>
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      <%_ } -%>
      <%_ if (hasKafka) { -%>
      - KAFKA_BOOTSTRAP_SERVERS=kafka:29092
      <%_ } else if (hasRabbit) { -%>
      - RABBITMQ_HOST=rabbitmq
      - RABBITMQ_PORT=5672
      - RABBITMQ_USERNAME=${RABBITMQ_USERNAME:-atlas}
      - RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD:-secret123456}
      <%_ } -%>
      <%_ if (hasSmtp4dev) { -%>
      - MAIL_SERVER_HOST=smtp4dev
      <%_ } -%>
      <%_ if (hasZipkin) { -%>
      - ZIPKIN_ENDPOINT=http://zipkin:9411/api/v2/spans
      <%_ } -%>
    volumes:
      - notification-service-log:/var/log/notification-service
    healthcheck:
      test: [ "CMD-SHELL", "curl -f http://localhost:8085/actuator/health || exit 1" ]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    networks:
      - atlas-network

  api-gateway:
    container_name: api-gateway
    image: atlas-api-gateway
    ports:
      - "8080:8080"
    depends_on:
      <%_ if (hasRedis) { -%>
      - redis
      <%_ } -%>
      - eureka-server
      <%_ if (hasSpringSecurityJwt) { -%>
      - auth-server
      <%_ } -%>
      - user-service
      - product-service
      - order-service
      - payment-service
      - notification-service
    environment:
      - EUREKA_DEFAULT_ZONE=http://eureka-server:8761/eureka
      <%_ if (hasRedis) { -%>
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      <%_ } -%>
      <%_ if (hasSpringSecurityJwt) { -%>
      - JWK_SET_URI=http://auth-server:8091/.well-known/jwks.json
      <%_ } -%>
      <%_ if (hasZipkin) { -%>
      - ZIPKIN_ENDPOINT=http://zipkin:9411/api/v2/spans
      <%_ } -%>
    volumes:
      - api-gateway-log:/var/log/api-gateway
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:8080/actuator/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    networks:
      - atlas-network

  <%_ if (hasNginx) { -%>
  nginx:
    container_name: nginx
    image: nginx:latest
    ports:
      - "80:80"
    volumes:
      - ./config/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./config/nginx/conf.d/atlas.conf:/etc/nginx/conf.d/atlas.conf:ro
      - nginx-logs:/var/log/nginx
    healthcheck:
      test: ["CMD", "nginx", "-t"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - atlas-network
  <%_ } -%>

networks:
  atlas-network:
    driver: bridge
    name: atlas-network

volumes:
  eureka-server-log:
  <%_ if (hasSpringSecurityJwt) { -%>
  auth-server-log:
  <%_ } -%>
  user-service-log:
  product-service-log:
  order-service-log:
  payment-service-log:
  notification-service-log:
  api-gateway-log:
  <%_ if (hasNginx) { -%>
  nginx-logs:
  <%_ } -%>
  <%_ if (hasMysql) { -%>
  mysql-data:
  <%_ } -%>
  <%_ if (hasPostgres) { -%>
  postgres-data:
  <%_ } -%>
  <%_ if (hasRedis) { -%>
  redis-data:
  <%_ } -%>
  <%_ if (hasKafka) { -%>
  kafka-data:
  <%_ } -%>
  <%_ if (hasRabbit) { -%>
  rabbitmq-data:
  <%_ } -%>
  <%_ if (hasElasticsearch) { -%>
  elasticsearch-data:
  <%_ } -%>
  <%_ if (hasMinio) { -%>
  minio-data:
  <%_ } -%>
  <%_ if (hasPrometheus) { -%>
  prometheus-data:
  <%_ } -%>
  <%_ if (hasGrafana) { -%>
  grafana-data:
  <%_ } -%>
  <%_ if (hasSmtp4dev) { -%>
  smtp4dev-data:
  <%_ } -%>

# (All configuration files are now provided via templates under config/)
