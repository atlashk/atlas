<%
  const authServer = (stack['auth-server'] || '').toLowerCase();
  const hasSpringSecurityJwt = authServer === 'spring-security-jwt';
%>
server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /var/log/promtail-positions.yaml

clients:
  - url: http://loki:3100/loki/api/v1/push

scrape_configs:
  - job_name: eureka-server
    static_configs:
      - targets:
          - localhost
        labels:
          service_name: eureka-server
          __path__: /var/log/eureka-server/*.log
  <%_ if (hasSpringSecurityJwt) { -%>
  - job_name: auth-server
    static_configs:
      - targets:
          - localhost
        labels:
          service_name: auth-server
          __path__: /var/log/auth-server/*.log
  <%_ } -%>
  - job_name: user-service
    static_configs:
      - targets:
          - localhost
        labels:
          service_name: user-service
          __path__: /var/log/user-service/*.log
  - job_name: product-service
    static_configs:
      - targets:
          - localhost
        labels:
          service_name: product-service
          __path__: /var/log/product-service/*.log
  - job_name: order-service
    static_configs:
      - targets:
          - localhost
        labels:
          service_name: order-service
          __path__: /var/log/order-service/*.log
  - job_name: payment-service
    static_configs:
      - targets:
          - localhost
        labels:
          service_name: payment-service
          __path__: /var/log/payment-service/*.log
  - job_name: notification-service
    static_configs:
      - targets:
          - localhost
        labels:
          service_name: notification-service
          __path__: /var/log/notification-service/*.log
  - job_name: api-gateway
    static_configs:
      - targets:
          - localhost
        labels:
          service_name: api-gateway
          __path__: /var/log/api-gateway/*.log
