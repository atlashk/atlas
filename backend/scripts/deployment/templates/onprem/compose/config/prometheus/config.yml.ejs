<%
  const authServer = (stack['auth-server'] || '').toLowerCase();
  const hasSpringSecurityJwt = authServer === 'spring-security-jwt';
%>
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'eureka-server-metrics'
    static_configs:
      - targets: [ 'eureka-server:8761' ]
    metrics_path: '/actuator/prometheus'
  <%_ if (hasSpringSecurityJwt) { -%>
  - job_name: 'auth-server-metrics'
    static_configs:
      - targets: [ 'auth-server:8091' ]
    metrics_path: '/actuator/prometheus'
  <%_ } -%>
  - job_name: 'user-service-metrics'
    static_configs:
      - targets: [ 'user-service:8081' ]
    metrics_path: '/actuator/prometheus'
  - job_name: 'product-service-metrics'
    static_configs:
      - targets: [ 'product-service:8082' ]
    metrics_path: '/actuator/prometheus'
  - job_name: 'order-service-metrics'
    static_configs:
      - targets: [ 'order-service:8083' ]
    metrics_path: '/actuator/prometheus'
  - job_name: 'payment-service-metrics'
    static_configs:
      - targets: [ 'payment-service:8084' ]
    metrics_path: '/actuator/prometheus'
  - job_name: 'notification-service-metrics'
    static_configs:
      - targets: [ 'notification-service:8085' ]
    metrics_path: '/actuator/prometheus'
  - job_name: 'api-gateway-metrics'
    static_configs:
      - targets: [ 'api-gateway:8080' ]
    metrics_path: '/actuator/prometheus'
