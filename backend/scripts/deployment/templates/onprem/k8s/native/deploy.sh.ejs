<%
  const notificationEmail = (stack.notification.email || '').toLowerCase();
  const observabilityLoggingStack = (stack.observability.logging.stack || '').toLowerCase();
  const observabilityMetrics = (stack.observability.metrics || '').toLowerCase();
  const observabilityTracing = (stack.observability.tracing || '').toLowerCase();
  const reverseProxy = (stack['reverse-proxy'] || '').toLowerCase();

  const hasSmtp4dev = notificationEmail === 'spring';
  const hasLoki = observabilityLoggingStack === 'loki';
  const hasPrometheus = observabilityMetrics === 'prometheus';
  const hasZipkin = observabilityTracing === 'zipkin';
  const hasGrafana = hasLoki || hasPrometheus || hasZipkin;
  const hasNginx = reverseProxy === 'nginx';
%>
#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# Atlas On-Premises Kubernetes Deployment Script (Template, Simplified)
# =============================================================================
# This script checks prerequisites, builds services (optional), creates the
# namespace, installs NGINX Ingress (if selected), and applies the rendered
# manifests.
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../../../../" && pwd)"
NAMESPACE="atlas"
MANIFESTS_DIR="$SCRIPT_DIR/services"

SKIP_BUILD=false

show_help() {
  echo "Usage: $0 [--skip-build]"
  echo ""
  echo "Simplified Atlas Kubernetes deploy script"
  echo "  --skip-build        Skip backend and Docker image builds"
}

parse_arguments() {
  while [[ $# -gt 0 ]]; do
    case $1 in
      -h|--help)
        show_help; exit 0;;
      --skip-build)
        SKIP_BUILD=true; shift;;
      *)
        echo "Unknown option: $1" >&2
        echo "Use --help for usage information" >&2
        exit 1;;
    esac
  done
}

check_prerequisites() {
  echo "Checking prerequisites..."
  if ! command -v kubectl >/dev/null 2>&1; then
    echo "kubectl is not installed" >&2; exit 1
  fi
  if ! kubectl cluster-info >/dev/null 2>&1; then
    echo "Cannot connect to Kubernetes cluster" >&2; exit 1
  fi
  if [[ "$SKIP_BUILD" == false ]]; then
    if ! command -v java >/dev/null 2>&1; then
      echo "Java is not installed. Please install Java 17 or later." >&2; exit 1
    fi
    if ! docker info >/dev/null 2>&1; then
      echo "Docker is not running. Please start Docker." >&2; exit 1
    fi
  fi
  echo "Prerequisites check passed"
}

build_services() {
  echo "Building services..."
  local build_script="$PROJECT_ROOT/backend/scripts/buildSrc/build.sh"
  if [[ ! -f "$build_script" ]]; then
    echo "Build script not found: $build_script" >&2; exit 1
  fi
  chmod +x "$build_script" || true
  if "$build_script"; then
    echo "Build completed successfully"
  else
    echo "Build failed" >&2; exit 1
  fi
}

create_namespace() {
  if kubectl get namespace "$NAMESPACE" >/dev/null 2>&1; then
    echo "Namespace '$NAMESPACE' already exists"
  else
    echo "Creating namespace '$NAMESPACE'"
    kubectl create namespace "$NAMESPACE"
  fi
}

install_ingress_controller() {
  <% if (hasNginx) { %>
  echo "Ensuring NGINX Ingress Controller is installed..."

  # Detect cluster provider
  local provider="baremetal"
  if kubectl get nodes -o jsonpath='{.items[0].metadata.labels}' 2>/dev/null | grep -q 'ingress-ready=true'; then
    provider="kind"
  fi

  # Check if already installed
  if kubectl get namespace ingress-nginx >/dev/null 2>&1; then
    echo "NGINX Ingress Controller namespace exists, checking deployment..."
    if kubectl get deployment ingress-nginx-controller -n ingress-nginx >/dev/null 2>&1; then
      echo "NGINX Ingress Controller already deployed"
      return 0
    fi
  fi

  # Install based on provider
  echo "Installing NGINX Ingress Controller ($provider provider)..."
  local manifest_url
  if [[ "$provider" == "kind" ]]; then
    manifest_url="https://raw.githubusercontent.com/kubernetes/ingress-nginx/main/deploy/static/provider/kind/deploy.yaml"
  else
    manifest_url="https://raw.githubusercontent.com/kubernetes/ingress-nginx/main/deploy/static/provider/cloud/deploy.yaml"
  fi

  if ! kubectl apply -f "$manifest_url"; then
    echo "Failed to install NGINX Ingress Controller" >&2
    exit 1
  fi

  # Wait for readiness
  echo "Waiting for NGINX Ingress Controller readiness (up to 5 minutes)..."
  if ! kubectl wait \
    --namespace ingress-nginx \
    --for=condition=ready pod \
    --selector=app.kubernetes.io/component=controller \
    --timeout=300s; then
    echo "Warning: NGINX Ingress Controller did not become ready within timeout" >&2
    echo "Check status with: kubectl get pods -n ingress-nginx" >&2
    exit 1
  fi

  echo "NGINX Ingress Controller is ready"
  <% } else { %>
  echo "Reverse proxy not set to NGINX; skipping ingress controller install"
  <% } %>
}

apply_manifests() {
  echo "Applying Kubernetes manifests in namespace '$NAMESPACE'..."
  if [[ -d "$MANIFESTS_DIR/infrastructure" ]]; then
    kubectl apply -n "$NAMESPACE" -f "$MANIFESTS_DIR/infrastructure"
  fi
  if [[ -d "$MANIFESTS_DIR/observability" ]]; then
    kubectl apply -n "$NAMESPACE" -f "$MANIFESTS_DIR/observability"
  fi
  if [[ -d "$MANIFESTS_DIR/application" ]]; then
    kubectl apply -n "$NAMESPACE" -f "$MANIFESTS_DIR/application"
  fi
  if [[ -d "$MANIFESTS_DIR/ingress" ]]; then
    kubectl apply -n "$NAMESPACE" -f "$MANIFESTS_DIR/ingress"
  fi
}

show_access_information() {
  echo "Service Access URLs:"
  echo "  API Gateway:   http://api.atlas.local"
  <% if (hasGrafana) { %>
  echo "  Grafana:       http://grafana.atlas.local (admin/secret123456)"
  <% } %>
  <% if (hasPrometheus) { %>
  echo "  Prometheus:    http://prometheus.atlas.local"
  <% } %>
  <% if (hasZipkin) { %>
  echo "  Zipkin:        http://zipkin.atlas.local"
  <% } %>
  <% if (hasSmtp4dev) { %>
  echo "  SMTP4Dev:      http://smtp4dev.atlas.local"
  <% } %>
}

main() {
  parse_arguments "$@"
  check_prerequisites

  if [[ "$SKIP_BUILD" == false ]]; then
    build_services
  else
    echo "Skipping build step (--skip-build provided)"
  fi

  create_namespace
  install_ingress_controller
  apply_manifests
  show_access_information
  echo "Deployment completed successfully. Namespace: $NAMESPACE"
}

main "$@"
