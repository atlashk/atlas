<%
  const apiClient = (stack['api-client'] || 'rest-restclient').toLowerCase();
  const apiClientPrefix = (apiClient.split('-')[0] || 'rest');
  const datasource = (stack.datasource || '').toLowerCase();
  const kvStore = (stack['kv-store'] || '').toLowerCase();
  const messaging = (stack.messaging || '').toLowerCase();
  const search = (stack.search || '').toLowerCase();
  const storage = (stack.storage || '').toLowerCase();
  const notificationEmail = ((stack.notification && stack.notification.email) || '').toLowerCase();
  const observabilityLoggingStack = ((stack.observability && stack.observability.logging && stack.observability.logging.stack) || '').toLowerCase();
  const observabilityMetrics = ((stack.observability && stack.observability.metrics) || '').toLowerCase();
  const observabilityTracing = ((stack.observability && stack.observability.tracing) || '').toLowerCase();
  const reverseProxy = (stack.reverseProxy || '').toLowerCase();

  const hasMysql = datasource === 'mysql';
  const hasPostgres = datasource === 'postgres' || datasource === 'postgresql';
  const hasRedis = kvStore === 'redis';
  const hasKafka = messaging === 'kafka';
  const hasRabbit = messaging === 'rabbitmq';
  const hasElasticsearch = search === 'elasticsearch';
  const hasMinio = storage === 'minio';
  const hasSmtp4dev = notificationEmail === 'spring';
  const hasLoki = observabilityLoggingStack === 'loki';
  const hasPrometheus = observabilityMetrics === 'prometheus';
  const hasZipkin = observabilityTracing === 'zipkin';
  const hasGrafana = hasLoki || hasPrometheus || hasZipkin;
  const hasNginx = reverseProxy === 'nginx';
%>
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: api-gateway-logs
  labels:
    app: api-gateway
    tier: application
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
  storageClassName: hostpath
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: api-gateway
  labels:
    app: api-gateway
    tier: application
spec:
  replicas: 1
  selector:
    matchLabels:
      app: api-gateway
  template:
    metadata:
      labels:
        app: api-gateway
        tier: application
    spec:
      containers:
        - name: api-gateway
          image: atlas-api-gateway:latest
          imagePullPolicy: Never
          ports:
            - containerPort: 8080
              name: http
          env:
            <% if (hasRedis) { %>
            - name: REDIS_HOST
              value: "redis"
            - name: REDIS_PORT
              value: "6379"
            <% } %>
            <% if (hasZipkin) { %>
            - name: ZIPKIN_ENDPOINT
              value: "http://zipkin:9411/api/v2/spans"
            <% } %>
          livenessProbe:
            httpGet:
              path: /actuator/health/liveness
              port: 8080
              scheme: HTTP
            initialDelaySeconds: 240
            periodSeconds: 45
            timeoutSeconds: 15
            failureThreshold: 10
            successThreshold: 1
          readinessProbe:
            httpGet:
              path: /actuator/health/readiness
              port: 8080
              scheme: HTTP
            initialDelaySeconds: 180
            periodSeconds: 5
            timeoutSeconds: 3
            successThreshold: 1
            failureThreshold: 6
          startupProbe:
            httpGet:
              path: /actuator/health
              port: 8080
              scheme: HTTP
            initialDelaySeconds: 120
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 18
          resources:
            requests:
              cpu: "200m"
              memory: "512Mi"
            limits:
              cpu: "500m"
              memory: "1Gi"
          volumeMounts:
            - name: api-gateway-logs
              mountPath: /var/log/api-gateway
      volumes:
        - name: api-gateway-logs
          persistentVolumeClaim:
            claimName: api-gateway-logs
      terminationGracePeriodSeconds: 30
---
apiVersion: v1
kind: Service
metadata:
  name: api-gateway
  labels:
    app: api-gateway
    tier: application
spec:
  selector:
    app: api-gateway
  ports:
    - port: 8080
      targetPort: 8080
      name: http
  type: ClusterIP
