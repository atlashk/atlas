<%
  const datasource = (stack.datasource || '').toLowerCase();
  const messaging = (stack.messaging || '').toLowerCase();
  const storage = (stack.storage || '').toLowerCase();
  const notificationEmail = (stack.notificationEmail || (stack.notification && stack.notification.email) || '').toLowerCase();
  const observabilityLoggingStack = (stack.observabilityLoggingStack || (stack.observability && stack.observability.logging && stack.observability.logging.stack) || '').toLowerCase();
  const observabilityMetrics = (stack.observabilityMetrics || (stack.observability && stack.observability.metrics) || '').toLowerCase();
  const observabilityTracing = (stack.observabilityTracing || (stack.observability && stack.observability.tracing) || '').toLowerCase();
  const reverseProxy = (stack.reverseProxy || '').toLowerCase();
  const search = (stack.search || '').toLowerCase();

  const hasRedis = true; // Always included per deploy.sh
  const hasMysql = datasource === 'mysql';
  const hasPostgres = datasource === 'postgres' || datasource === 'postgresql';
  const hasKafka = messaging === 'kafka';
  const hasRabbit = messaging === 'rabbitmq';
  const hasMinio = storage === 'minio';
  const hasSmtp4dev = notificationEmail === 'spring';
  const hasLoki = observabilityLoggingStack === 'loki';
  const hasPrometheus = observabilityMetrics === 'prometheus';
  const hasZipkin = observabilityTracing === 'zipkin';
  const hasNginx = reverseProxy === 'nginx';
  const hasGrafana = hasLoki || hasPrometheus || hasZipkin;
  const hasElasticsearch = search === 'elasticsearch';
%>
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: payment-service-logs
  labels:
    app: payment-service
    tier: application
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
  storageClassName: hostpath
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: payment-service
  labels:
    app: payment-service
    tier: application
spec:
  replicas: 1
  selector:
    matchLabels:
      app: payment-service
  template:
    metadata:
      labels:
        app: payment-service
        tier: application
    spec:
      containers:
        - name: payment-service
          image: atlas-payment-service:latest
          imagePullPolicy: Never
          envFrom:
            - configMapRef:
                name: payment-service-config
            - secretRef:
                name: payment-service-secret
          env:
            <% if (hasMysql) { %>
            - name: DB_URL
              value: "jdbc:mysql://mysql:3306/db_payment?useUnicode=yes&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false"
            - name: DB_USERNAME
              value: "root"
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: mysql-secret
                  key: mysql-root-password
            - name: DB_QUARTZ_URL
              value: "jdbc:mysql://mysql:3306/db_quartz?useUnicode=yes&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false"
            - name: DB_QUARTZ_USERNAME
              value: "root"
            - name: DB_QUARTZ_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: mysql-secret
                  key: mysql-root-password
            <% } else if (hasPostgres) { %>
            - name: DB_URL
              value: "jdbc:postgresql://postgres:5432/db_payment"
            - name: DB_USERNAME
              value: "root"
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: postgres-secret
                  key: postgres-password
            - name: DB_QUARTZ_URL
              value: "jdbc:postgresql://postgres:5432/db_quartz"
            - name: DB_QUARTZ_USERNAME
              value: "root"
            - name: DB_QUARTZ_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: postgres-secret
                  key: postgres-password
            <% } %>
            <% if (hasRedis) { %>
            - name: REDIS_HOST
              value: "redis"
            - name: REDIS_PORT
              value: "6379"
            <% } %>
            <% if (hasKafka) { %>
            - name: KAFKA_BOOTSTRAP_SERVERS
              value: "kafka:29092"
            <% } else if (hasRabbit) { %>
            - name: RABBITMQ_HOST
              value: "rabbitmq"
            - name: RABBITMQ_PORT
              value: "5672"
            - name: RABBITMQ_USERNAME
              value: "admin"
            - name: RABBITMQ_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: rabbitmq-secret
                  key: rabbitmq-default-pass
            <% } %>
            <% if (hasZipkin) { %>
            - name: ZIPKIN_ENDPOINT
              value: "http://zipkin:9411/api/v2/spans"
            <% } %>
          ports:
            - containerPort: 8084
              name: http
          livenessProbe:
            httpGet:
              path: /actuator/health/liveness
              port: 8084
              scheme: HTTP
            initialDelaySeconds: 240
            periodSeconds: 45
            timeoutSeconds: 15
            failureThreshold: 10
            successThreshold: 1
          readinessProbe:
            httpGet:
              path: /actuator/health/readiness
              port: 8084
              scheme: HTTP
            initialDelaySeconds: 180
            periodSeconds: 5
            timeoutSeconds: 3
            successThreshold: 1
            failureThreshold: 6
          startupProbe:
            httpGet:
              path: /actuator/health
              port: 8084
              scheme: HTTP
            initialDelaySeconds: 120
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 18
          resources:
            requests:
              cpu: "200m"
              memory: "512Mi"
            limits:
              cpu: "500m"
              memory: "1Gi"
          volumeMounts:
            - name: payment-service-logs
              mountPath: /var/log/payment-service
      volumes:
        - name: payment-service-logs
          persistentVolumeClaim:
            claimName: payment-service-logs
      terminationGracePeriodSeconds: 30
---
apiVersion: v1
kind: Service
metadata:
  name: payment-service
  labels:
    app: payment-service
    tier: application
spec:
  selector:
    app: payment-service
  ports:
    - port: 8084
      targetPort: 8084
      name: http
  type: ClusterIP