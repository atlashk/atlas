<%
  const authServer = (stack['auth-server'] || '').toLowerCase();
  const kvStore = (stack['kv-store'] || '').toLowerCase();
  const observabilityLoggingStack = (stack.observability.logging.stack || '').toLowerCase();
  const observabilityTracing = (stack.observability.tracing || '').toLowerCase();

  const hasSpringSecurityJwt = authServer === 'spring-security-jwt';
  const hasKeycloak = authServer === 'keycloak';
  const hasRedis = kvStore === 'redis';
  const hasLoki = observabilityLoggingStack === 'loki';
  const hasZipkin = observabilityTracing === 'zipkin';
%>
# Log volume changed to emptyDir for Promtail compatibility
# PersistentVolumeClaim removed - logs now use emptyDir volume
apiVersion: apps/v1
kind: Deployment
metadata:
  name: api-gateway
  labels:
    app: api-gateway
    tier: application
spec:
  replicas: 1
  selector:
    matchLabels:
      app: api-gateway
  template:
    metadata:
      labels:
        app: api-gateway
        tier: application
    spec:
      containers:
        - name: api-gateway
          image: atlas-api-gateway:latest
          imagePullPolicy: Never
          ports:
            - containerPort: 8080
              name: http
          env:
            <% if (hasRedis) { %>
            - name: REDIS_HOST
              value: "redis"
            - name: REDIS_PORT
              value: "6379"
            <% } %>
            <% if (hasSpringSecurityJwt) { %>
            - name: AUTH_SERVER_URI
              value: "http://auth-server:8091"
            <% } %>
            <% if (hasKeycloak) { %>
              - name: KEYCLOAK_BASE_URL
              value: "http://keycloak:8443"
            <% } %>
            <% if (hasZipkin) { %>
            - name: ZIPKIN_ENDPOINT
              value: "http://zipkin:9411/api/v2/spans"
            <% } %>
          # startupProbe gives the Spring Boot app up to 5 min (30 × 10 s) to finish starting
          # before liveness/readiness probes are allowed to run. This prevents premature restarts.
          startupProbe:
            httpGet:
              path: /actuator/health/liveness
              port: 8080
              scheme: HTTP
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 30
          # livenessProbe restarts the container if the app becomes unresponsive after startup.
          # Quick failure detection (3 × 30 s) without being overly aggressive.
          livenessProbe:
            httpGet:
              path: /actuator/health/liveness
              port: 8080
              scheme: HTTP
            initialDelaySeconds: 0
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 3
            successThreshold: 1
          # readinessProbe removes the pod from service endpoints while it is still starting
          # or if it becomes temporarily unavailable. Checks every 10 s for fast traffic routing.
          readinessProbe:
            httpGet:
              path: /actuator/health/readiness
              port: 8080
              scheme: HTTP
            initialDelaySeconds: 0
            periodSeconds: 10
            timeoutSeconds: 3
            successThreshold: 1
            failureThreshold: 3
          resources:
            requests:
              cpu: "200m"
              memory: "512Mi"
            limits:
              cpu: "500m"
              memory: "1Gi"
          volumeMounts:
            - name: api-gateway-logs
              mountPath: /var/log/api-gateway
        <% if (hasLoki) { %>
        # Promtail sidecar for log collection
        - name: promtail
          image: grafana/promtail:main
          imagePullPolicy: IfNotPresent
          args:
            - -config.file=/etc/promtail/promtail.yml
            - -config.expand-env
          env:
            - name: APP_NAME
              value: "api-gateway"
          ports:
            - containerPort: 9080
              name: http
          livenessProbe:
            httpGet:
              path: /ready
              port: 9080
            initialDelaySeconds: 30
            periodSeconds: 30
            timeoutSeconds: 10
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /ready
              port: 9080
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 3
          resources:
            requests:
              cpu: "50m"
              memory: "64Mi"
            limits:
              cpu: "100m"
              memory: "128Mi"
          volumeMounts:
            - name: promtail-config
              mountPath: /etc/promtail
            - name: api-gateway-logs
              mountPath: /var/log/api-gateway
              readOnly: true
        <% } %>
      volumes:
        - name: api-gateway-logs
          emptyDir: {}
        <% if (hasLoki) { %>
        - name: promtail-config
          configMap:
            name: promtail-config
        <% } %>
      terminationGracePeriodSeconds: 30
---
apiVersion: v1
kind: Service
metadata:
  name: api-gateway
  labels:
    app: api-gateway
    tier: application
spec:
  selector:
    app: api-gateway
  ports:
    - port: 8080
      targetPort: 8080
      name: http
  type: ClusterIP
