<configuration>
  <!-- Spring Property Definition - must be defined before use -->
  <springProperty name="SERVICE_NAME" scope="context" source="spring.application.name"/>
  <property name="LOG_DIR" value="/var/log/${SERVICE_NAME}"/>

  <!-- Console adapter -->
  <appender class="ch.qos.logback.core.ConsoleAppender" name="CONSOLE">
    <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
      <layout
        class="org.atlas.libs.observability.logging.logback.MaskingPatternLayout">
        <Pattern>${CONSOLE_LOG_PATTERN}</Pattern>
      </layout>
    </encoder>
  </appender>

  <!-- Rolling file adapter -->
  <appender class="ch.qos.logback.core.rolling.RollingFileAppender" name="FILE">
    <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
      <layout
        class="org.atlas.libs.observability.logging.logback.MaskingPatternLayout">
        <pattern>${FILE_LOG_PATTERN}</pattern>
      </layout>
    </encoder>

    <file>${LOG_DIR}/${SERVICE_NAME}.log</file>

    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <!-- Rollover daily and when the file size reaches 100MB -->
      <fileNamePattern>${LOG_DIR}/${SERVICE_NAME}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>100MB</maxFileSize>
      <maxHistory>30</maxHistory>
      <totalSizeCap>3GB</totalSizeCap>
    </rollingPolicy>
  </appender>

  <!-- use Spring default values -->
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <!-- Logger for specific packages -->
  <logger additivity="false" level="DEBUG" name="org.atlas">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </logger>

  <logger additivity="false" level="DEBUG" name="reactor.netty.http.client">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </logger>

  <!-- Spring Security -->
  <logger additivity="false" level="DEBUG" name="org.springframework.security">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </logger>

  <!-- Spring Cloud Gateway -->
  <logger additivity="false" level="INFO" name="org.springframework.security.web.server.context.WebSessionServerSecurityContextRepository">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </logger>
  <logger additivity="false" level="INFO" name="org.springframework.security.web.server.util.matcher">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </logger>

  <!-- Spring AI -->
  <logger additivity="false" level="DEBUG" name="org.springframework.ai.chat.client.advisor">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </logger>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>
</configuration>
