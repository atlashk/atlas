# ==============================================================
# Copy this file to terraform.tfvars and fill in your values
#   cp terraform.tfvars.example terraform.tfvars
#
# WARNING: Do NOT commit terraform.tfvars to git
#          (already listed in .gitignore)
# ==============================================================

# AWS region to deploy into
# Recommended: us-east-1 (Singapore) — low latency for Southeast Asia
aws_region = "us-east-1"

# Project name — appears in the name of every AWS resource
project_name = "atlas"

# Deployment environment: "dev" | "staging" | "production"
environment = "dev"

# Kubernetes version
kubernetes_version = "1.35"

# Number of Availability Zones (2 or 3)
# dev: 2 AZs to reduce cost
# production: 3 AZs for higher availability
availability_zones_count = 2

# VPC CIDR block
vpc_cidr = "10.0.0.0/16"

# ------------------------------------------------------------------
# Node Group: default — runs all workloads
# t3.large: 2 vCPU, 8 GB RAM
# ------------------------------------------------------------------
node_group = {
  instance_types = ["t3.large"]
  min_size       = 2
  max_size       = 3
  desired_size   = 2
  disk_size_gb   = 30
}

# ------------------------------------------------------------------
# Admin IAM principals
# ------------------------------------------------------------------
# List of IAM ARNs that should receive cluster-admin access via
# EKS Access Entries. Add your AWS root account, break-glass IAM
# users, or CI/CD roles here.
#
# The root account ARN always follows the pattern:
#   arn:aws:iam::<account-id>:root
#
# Retrieve your account ID:
#   aws sts get-caller-identity --query Account --output text
#
# admin_iam_principals = [
#   "arn:aws:iam::123456789012:root",
#   "arn:aws:iam::123456789012:user/alice",
# ]
