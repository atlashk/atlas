<%
  const observabilityLoggingStack = (stack.observability.logging.stack || '').toLowerCase();
  const hasLoki = observabilityLoggingStack === 'loki';
%>
<% if (hasLoki) { -%>
---
# Promtail Service Account
apiVersion: v1
kind: ServiceAccount
metadata:
  name: promtail
  labels:
    app: promtail
    tier: observability
  annotations:
    description: "Service account for Promtail log collection"
---
# Promtail RBAC
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: promtail
  labels:
    app: promtail
    tier: observability
rules:
  - apiGroups: [""]
    resources: ["pods", "pods/log"]
    verbs: ["get", "list", "watch"]
  - apiGroups: [""]
    resources: ["nodes"]
    verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: promtail
  labels:
    app: promtail
    tier: observability
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: promtail
subjects:
  - kind: ServiceAccount
    name: promtail
    namespace: default
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: promtail-config
  labels:
    app: promtail
    tier: observability
data:
  promtail.yml: |
    server:
      http_listen_port: 9080
      grpc_listen_port: 0
      log_level: info
    
    positions:
      filename: /tmp/positions.yaml
      sync_period: 10s
    
    clients:
      - url: http://loki:3100/loki/api/v1/push
        batchwait: 1s
        batchsize: 1048576
    
    scrape_configs:
      - job_name: application-logs
        static_configs:
          - targets:
              - localhost
            labels:
              job: application-logs
              app: ${APP_NAME}
              tier: application
              namespace: atlas
              __path__: /var/log/${APP_NAME}/${APP_NAME}.log
<% } -%>
