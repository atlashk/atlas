<%
  const authServer = (stack['auth-server'] || '').toLowerCase();
  const hasSpringSecurityJwt = authServer === 'spring-security-jwt';
  const hasKeycloak = authServer === 'keycloak'
%>
#!/bin/bash
set -e

echo "Initializing databases and granting privileges to ${MYSQL_USER}"

cat <<EOF | mysql -uroot -p"${MYSQL_ROOT_PASSWORD}"
<%_ if (hasSpringSecurityJwt) { -%>
CREATE DATABASE IF NOT EXISTS db_auth;
<%_ } -%>
<%_ if (hasKeycloak) { -%>
CREATE DATABASE IF NOT EXISTS db_keycloak;
<%_ } -%>
CREATE DATABASE IF NOT EXISTS db_notification;
CREATE DATABASE IF NOT EXISTS db_order;
CREATE DATABASE IF NOT EXISTS db_payment;
CREATE DATABASE IF NOT EXISTS db_product;
CREATE DATABASE IF NOT EXISTS db_user;

CREATE USER IF NOT EXISTS '${MYSQL_USER}'@'%' IDENTIFIED BY '${MYSQL_PASSWORD}';
ALTER USER '${MYSQL_USER}'@'%' IDENTIFIED WITH mysql_native_password BY '${MYSQL_PASSWORD}';

<%_ if (hasSpringSecurityJwt) { -%>
GRANT ALL PRIVILEGES ON db_auth.* TO '${MYSQL_USER}'@'%';
<%_ } -%>
<%_ if (hasKeycloak) { -%>
GRANT ALL PRIVILEGES ON db_keycloak.* TO '${MYSQL_USER}'@'%';
<%_ } -%>
GRANT ALL PRIVILEGES ON db_notification.* TO '${MYSQL_USER}'@'%';
GRANT ALL PRIVILEGES ON db_order.* TO '${MYSQL_USER}'@'%';
GRANT ALL PRIVILEGES ON db_payment.* TO '${MYSQL_USER}'@'%';
GRANT ALL PRIVILEGES ON db_product.* TO '${MYSQL_USER}'@'%';
GRANT ALL PRIVILEGES ON db_user.* TO '${MYSQL_USER}'@'%';
FLUSH PRIVILEGES;
EOF
