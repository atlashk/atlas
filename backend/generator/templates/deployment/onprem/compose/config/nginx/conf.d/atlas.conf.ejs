<%
  // Derive flags similar to docker-compose.yml.ejs
  const authServer = (stack['auth-server'] || '').toLowerCase();
  const notificationEmail = (stack.notification.email || '').toLowerCase();
  const storage = (stack.storage || '').toLowerCase();
  const observabilityLoggingStack = (stack.observability.logging.stack || '').toLowerCase();
  const observabilityMetrics = (stack.observability.metrics || '').toLowerCase();
  const observabilityTracing = (stack.observability.tracing || '').toLowerCase();

  const hasKeycloak = authServer === 'keycloak'
  const hasSmtp4dev = notificationEmail === 'spring';
  const hasMinio = storage === 'minio';
  const hasLoki = observabilityLoggingStack === 'loki';
  const hasPrometheus = observabilityMetrics === 'prometheus';
  const hasZipkin = observabilityTracing === 'zipkin';
  const hasGrafana = hasLoki || hasPrometheus || hasZipkin;
%>

# Atlas reverse proxy configuration

server {
    listen 80;
    server_name api.atlas.local;

    location / {
        proxy_pass http://api-gateway:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

<% if (hasKeycloak) { %>
server {
    listen 80;
    server_name keycloak.atlas.local;

    location / {
        proxy_pass http://keycloak:8443;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
<% } %>

<% if (hasSmtp4dev) { %>
server {
    listen 80;
    server_name smtp4dev.atlas.local;

    location / {
        proxy_pass http://smtp4dev:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
<% } %>

<% if (hasMinio) { %>
server {
    listen 80;
    server_name minio.atlas.local;

    location / {
        proxy_pass http://minio:9001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
<% } %>

<% if (hasPrometheus) { %>
server {
    listen 80;
    server_name prometheus.atlas.local;

    location / {
        proxy_pass http://prometheus:9090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
<% } %>

<% if (hasZipkin) { %>
server {
    listen 80;
    server_name zipkin.atlas.local;

    location / {
        proxy_pass http://zipkin:9411;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

<% if (hasGrafana) { %>
server {
    listen 80;
    server_name grafana.atlas.local;

    location / {
        proxy_pass http://grafana:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
<% } %>
<% } %>
