#!/bin/bash
set -euo pipefail

# =============================================================================
# CONFIGURATION
# =============================================================================

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_ROOT="$(cd "$SCRIPT_DIR/../../../" && pwd)"
readonly PROJECT_NAME="{{dotenv.PROJECT_NAME}}"
readonly APP_STACK="{{#if appStack}}{{appStack}}{{/if}}"
readonly NAMESPACE="{{dotenv.PROJECT_NAME}}"
readonly ROLLOUT_TIMEOUT="120s"

# =============================================================================
# UTILITIES
# =============================================================================

die() { echo "Error: $1" >&2; exit 1; }
info() { echo "==> $1"; }

command_exists() { command -v "$1" >/dev/null 2>&1; }

# =============================================================================
# USAGE
# =============================================================================

show_usage() {
  cat <<EOF
Usage: $0 <service-name>

Rebuild and redeploy a single service to Kubernetes

Arguments:
  <service-name>     Service name to rebuild (required)

Available services:
{{#each services}}
  - {{this.name}}
{{/each}}

Examples:
  $0 identity-service
  $0 api-gateway
EOF
}

parse_arguments() {
  [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { show_usage; exit 0; }

  SERVICE_NAME="${1:-}"
  [[ -z "$SERVICE_NAME" ]] && { echo "Error: Missing required argument <service-name>" >&2; echo; show_usage; exit 1; }
}

# =============================================================================
# PREREQUISITES
# =============================================================================

check_prerequisites() {
  command_exists kubectl || die "kubectl is not installed"
  kubectl cluster-info >/dev/null 2>&1 || die "Cannot connect to Kubernetes cluster"
  command_exists docker || die "Docker is not installed"
}

# =============================================================================
# BUILD
# =============================================================================

resolve_service_paths() {
  if [[ "$SERVICE_NAME" == "api-gateway" ]]; then
    MODULE_PATH="backend/services/api-gateway/spring-cloud-gateway/spring-cloud-gateway-server"
    IMAGE_NAME="${PROJECT_NAME}/api-gateway"
    GRADLE_TASK=":services:api-gateway:spring-cloud-gateway:spring-cloud-gateway-server:bootJar"
  else
    local base_name="${SERVICE_NAME%-service}"
    MODULE_PATH="backend/services/${SERVICE_NAME}/${base_name}-bootstrap"
    IMAGE_NAME="${PROJECT_NAME}/${SERVICE_NAME}"
    GRADLE_TASK=":services:${SERVICE_NAME}:${base_name}-bootstrap:bootJar"
  fi
}

build_jar() {
  info "Building JAR for $SERVICE_NAME..."
  cd "$PROJECT_ROOT/backend"
  chmod +x gradlew
  ./gradlew "$GRADLE_TASK" -x test -PappStack="$APP_STACK"
}

build_docker_image() {
  info "Building Docker image..."
  cd "$PROJECT_ROOT/$MODULE_PATH"
  docker build -t "${IMAGE_NAME}:latest" .
}

# =============================================================================
# CLUSTER
# =============================================================================

load_image_to_cluster() {
  local context
  context="$(kubectl config current-context 2>/dev/null || true)"

  case "$context" in
    minikube)
      if command_exists minikube; then
        info "Loading image into Minikube..."
        minikube image load "${IMAGE_NAME}:latest"
        return 0
      fi
      ;;
    kind-*)
      if command_exists kind; then
        local cluster_name="${context#kind-}"
        info "Loading image into Kind cluster '$cluster_name'..."
        kind load docker-image "${IMAGE_NAME}:latest" --name "$cluster_name"
        return 0
      fi
      ;;
  esac

  info "Image built locally (cluster auto-load not available for this context)"
}

restart_deployment() {
  if ! kubectl get deployment "$SERVICE_NAME" -n "$NAMESPACE" >/dev/null 2>&1; then
    echo "Deployment '$SERVICE_NAME' not found in namespace '$NAMESPACE'" >&2
    echo "Available deployments:"
    kubectl get deployments -n "$NAMESPACE" --no-headers | awk '{print "  - " $1}'
    exit 1
  fi

  info "Restarting deployment..."
  kubectl rollout restart deployment "$SERVICE_NAME" -n "$NAMESPACE"

  info "Waiting for rollout to complete..."
  kubectl rollout status deployment "$SERVICE_NAME" -n "$NAMESPACE" --timeout="$ROLLOUT_TIMEOUT"

  echo
  info "Deployment status:"
  kubectl get pods -n "$NAMESPACE" -l "app=$SERVICE_NAME"
}

# =============================================================================
# MAIN
# =============================================================================

main() {
  parse_arguments "$@"
  check_prerequisites

  echo "Rebuilding service: $SERVICE_NAME"

  resolve_service_paths
  build_jar
  build_docker_image
  load_image_to_cluster
  restart_deployment

  echo
  echo "Successfully rebuilt and restarted $SERVICE_NAME"
}

main "$@"
