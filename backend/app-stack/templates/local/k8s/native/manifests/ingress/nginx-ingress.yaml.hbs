{{#hasService "reverse-proxy" "nginx"}}
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: nginx-ingress
  namespace: atlas
  labels:
    app: nginx-ingress
    tier: frontend
  annotations:
    nginx.ingress.kubernetes.io/rewrite-target: /
    nginx.ingress.kubernetes.io/ssl-redirect: "false"
    nginx.ingress.kubernetes.io/force-ssl-redirect: "false"
    nginx.ingress.kubernetes.io/upstream-vhost: $http_host
    nginx.ingress.kubernetes.io/proxy-set-headers: "atlas-proxy-headers"
spec:
  ingressClassName: nginx
  rules:
    - host: api.atlas.local
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: api-gateway
                port:
                  number: 8080
{{#hasGrafana}}
    - host: grafana.atlas.local
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: grafana
                port:
                  number: 3000
{{/hasGrafana}}
{{#hasObservability "tracing" "zipkin"}}
    - host: zipkin.atlas.local
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: zipkin
                port:
                  number: 9411
{{/hasObservability}}
{{#hasService "notification.email" "spring"}}
    - host: smtp4dev.atlas.local
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: smtp4dev
                port:
                  number: 80
{{/hasService}}
{{#hasService "identity" "keycloak"}}
    - host: keycloak.atlas.local
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: keycloak
                port:
                  number: 8080
{{/hasService}}
{{#hasService "storage" "minio"}}
    - host: minio.atlas.local
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: minio
                port:
                  number: 9001
{{/hasService}}
{{#hasObservability "metrics" "prometheus"}}
    - host: prometheus.atlas.local
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: prometheus
                port:
                  number: 9090
{{/hasObservability}}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: nginx-ingress-config
  namespace: atlas
  labels:
    app: nginx-ingress
    tier: frontend
data:
  X-Forwarded-Host: $http_host
  X-Forwarded-Proto: $scheme
  X-Real-IP: $remote_addr
  X-Forwarded-For: $proxy_add_x_forwarded_for
  Host: $http_host
{{/hasService}}
