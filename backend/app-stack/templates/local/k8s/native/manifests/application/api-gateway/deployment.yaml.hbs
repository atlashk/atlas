apiVersion: apps/v1
kind: Deployment
metadata:
  name: api-gateway
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: api-gateway
spec:
  replicas: 1
  selector:
    matchLabels:
      app: api-gateway
  template:
    metadata:
      labels:
        app: api-gateway
    spec:
      serviceAccountName: namespace-reader
      containers:
        - name: api-gateway
          image: {{dotenv.PROJECT_NAME}}/api-gateway:latest
          imagePullPolicy: Never
          ports:
            - name: http
              containerPort: 8080
          env:
            {{#hasService "kv-store" "redis"}}
            - name: REDIS_HOST
              value: "redis"
            - name: REDIS_PORT
              value: "6379"
            {{/hasService}}
            {{#hasService "identity" "jwt"}}
            - name: JWK_SET_URI
              value: "http://identity-service:8081/.well-known/jwks.json"
            {{/hasService}}
            {{#hasService "identity" "keycloak"}}
            - name: KEYCLOAK_BASE_URL
              value: "http://keycloak:8080"
            - name: KEYCLOAK_REALM
              valueFrom:
                configMapKeyRef:
                  name: keycloak-config
                  key: keycloak-realm
            {{/hasService}}
            {{#hasService "observability.tracing" "zipkin"}}
            - name: ZIPKIN_ENDPOINT
              value: "http://zipkin:9411/api/v2/spans"
            {{/hasService}}
          startupProbe:
            httpGet:
              path: /actuator/health/liveness
              port: http
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 30
          livenessProbe:
            httpGet:
              path: /actuator/health/liveness
              port: http
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /actuator/health/readiness
              port: http
            periodSeconds: 15
            timeoutSeconds: 5
            failureThreshold: 3
          resources:
            requests:
              cpu: "200m"
              memory: "512Mi"
            limits:
              cpu: "500m"
              memory: "1Gi"
          volumeMounts:
            - name: api-gateway-logs
              mountPath: /var/log/api-gateway
      volumes:
        - name: api-gateway-logs
          emptyDir: {} # Log volume changed to emptyDir for Promtail compatibility
      terminationGracePeriodSeconds: 30
