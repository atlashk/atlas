apiVersion: v1
kind: Service
metadata:
  name: identity-service
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: identity-service
spec:
  selector:
    app: identity-service
  type: ClusterIP
  ports:
    - name: http
      port: 8081
      targetPort: http
    {{#hasService "internal" "grpc"}}
    - name: grpc
      port: 50051
      targetPort: grpc
    {{/hasService}}
