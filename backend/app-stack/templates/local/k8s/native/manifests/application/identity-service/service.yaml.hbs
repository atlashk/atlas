apiVersion: v1
kind: Service
metadata:
  name: identity-service
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: identity-service
spec:
  selector:
    app: identity-service
  type: ClusterIP
  ports:
    - port: 8081
      targetPort: 8081
      name: http
    {{#hasService "internal" "grpc"}}
    - port: 50051
      targetPort: 50051
      name: grpc
    {{/hasService}}
