apiVersion: apps/v1
kind: Deployment
metadata:
  name: order-service
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: order-service
    tier: backend
spec:
  replicas: 1
  selector:
    matchLabels:
      app: order-service
  template:
    metadata:
      labels:
        app: order-service
        tier: backend
    spec:
      serviceAccountName: cluster-sa
      containers:
        - name: order-service
          image: {{dotenv.PROJECT_NAME}}/order-service:latest
          imagePullPolicy: Never
          ports:
            - containerPort: 8084
              name: http
          env:
            {{#hasService "datasource" "mysql"}}
            - name: DB_URL
              value: "jdbc:mysql://mysql:3306/db_order?useUnicode=yes&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false"
            - name: DB_USERNAME
              valueFrom:
                secretKeyRef:
                  name: mysql
                  key: mysql-user
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: mysql
                  key: mysql-password
            {{/hasService}}
            {{#hasService "datasource" "postgres"}}
            - name: DB_URL
              value: "jdbc:postgresql://postgres:5432/db_order"
            - name: DB_USERNAME
              valueFrom:
                secretKeyRef:
                  name: postgres
                  key: postgres-user
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: postgres
                  key: postgres-password
            {{/hasService}}
            {{#hasService "kv-store" "redis"}}
            - name: REDIS_HOST
              value: "redis"
            - name: REDIS_PORT
              value: "6379"
            {{/hasService}}
            {{#hasService "messaging" "kafka"}}
            - name: KAFKA_BOOTSTRAP_SERVERS
              value: "kafka:29092"
            {{/hasService}}
            {{#hasService "messaging" "rabbitmq"}}
            - name: RABBITMQ_HOST
              value: "rabbitmq"
            - name: RABBITMQ_PORT
              value: "5672"
            - name: RABBITMQ_USERNAME
              valueFrom:
                secretKeyRef:
                  name: rabbitmq
                  key: rabbitmq-user
            - name: RABBITMQ_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: rabbitmq
                  key: rabbitmq-password
            {{/hasService}}
            {{#hasService "internal" "grpc"}}
            - name: API_CLIENT_GRPC_IDENTITY_SERVICE_ADDRESS
              value: "static://identity-service:50051"
            - name: API_CLIENT_GRPC_CATALOG_SERVICE_ADDRESS
              value: "static://catalog-service:50052"
            {{/hasService}}
            {{#hasService "internal" "rest"}}
            - name: API_CLIENT_REST_IDENTITY_SERVICE_BASE_URL
              value: "http://identity-service:8081"
            - name: API_CLIENT_REST_CATALOG_SERVICE_BASE_URL
              value: "http://catalog-service:8082"
            {{/hasService}}
            {{#hasService "observability.tracing" "zipkin"}}
            - name: ZIPKIN_ENDPOINT
              value: "http://zipkin:9411/api/v2/spans"
            {{/hasService}}
          # startupProbe gives the Spring Boot app up to 5 min (30 × 10 s) to finish starting
          # before liveness/readiness probes are allowed to run. This prevents premature restarts.
          startupProbe:
            httpGet:
              path: /actuator/health/liveness
              port: 8084
              scheme: HTTP
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 30
          # livenessProbe restarts the container if the app becomes unresponsive after startup.
          # Quick failure detection (3 × 30 s) without being overly aggressive.
          livenessProbe:
            httpGet:
              path: /actuator/health/liveness
              port: 8084
              scheme: HTTP
            initialDelaySeconds: 0
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 3
            successThreshold: 1
          # readinessProbe removes the pod from service endpoints while it is still starting
          # or if it becomes temporarily unavailable. Checks every 10 s for fast traffic routing.
          readinessProbe:
            httpGet:
              path: /actuator/health/readiness
              port: 8084
              scheme: HTTP
            initialDelaySeconds: 0
            periodSeconds: 10
            timeoutSeconds: 3
            successThreshold: 1
            failureThreshold: 3
          resources:
            requests:
              cpu: "200m"
              memory: "512Mi"
            limits:
              cpu: "500m"
              memory: "1Gi"
          volumeMounts:
            - name: order-service-logs
              mountPath: /var/log/order-service
      volumes:
        - name: order-service-logs
          emptyDir: {}
      terminationGracePeriodSeconds: 30
---
apiVersion: v1
kind: Service
metadata:
  name: order-service
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: order-service
    tier: backend
spec:
  selector:
    app: order-service
  ports:
    - port: 8084
      targetPort: 8084
      name: http
  type: ClusterIP
