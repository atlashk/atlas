apiVersion: apps/v1
kind: Deployment
metadata:
  name: payment-service
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: payment-service
    tier: backend
spec:
  replicas: 1
  selector:
    matchLabels:
      app: payment-service
  template:
    metadata:
      labels:
        app: payment-service
        tier: backend
    spec:
      serviceAccountName: cluster-mgmt
      containers:
        - name: payment-service
          image: {{dotenv.PROJECT_NAME}}/payment-service:latest
          imagePullPolicy: Never
          ports:
            - containerPort: 8085
              name: http
          env:
            {{#hasService "datasource" "mysql"}}
            - name: DB_URL
              value: "jdbc:mysql://mysql:3306/db_payment?useUnicode=yes&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false"
            - name: DB_USERNAME
              valueFrom:
                secretKeyRef:
                  name: mysql
                  key: mysql-user
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: mysql
                  key: mysql-password
            {{/hasService}}
            {{#hasService "datasource" "postgres"}}
            - name: DB_URL
              value: "jdbc:postgresql://postgres:5432/db_payment"
            - name: DB_USERNAME
              valueFrom:
                secretKeyRef:
                  name: postgres
                  key: postgres-user
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: postgres
                  key: postgres-password
            {{/hasService}}
            {{#hasService "kv-store" "redis"}}
            - name: REDIS_HOST
              value: "redis"
            - name: REDIS_PORT
              value: "6379"
            {{/hasService}}
            {{#hasService "messaging" "kafka"}}
            - name: KAFKA_BOOTSTRAP_SERVERS
              value: "kafka:29092"
            {{/hasService}}
            {{#hasService "messaging" "rabbitmq"}}
            - name: RABBITMQ_HOST
              value: "rabbitmq"
            - name: RABBITMQ_PORT
              value: "5672"
            - name: RABBITMQ_USERNAME
              valueFrom:
                secretKeyRef:
                  name: rabbitmq
                  key: rabbitmq-user
            - name: RABBITMQ_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: rabbitmq
                  key: rabbitmq-password
            {{/hasService}}
            {{#hasService "observability.tracing" "zipkin"}}
            - name: ZIPKIN_ENDPOINT
              value: "http://zipkin:9411/api/v2/spans"
            {{/hasService}}
            - name: PAYMENT_SIMULATOR_WEBHOOK_URL
              value: "http://api-gateway:8080/services/payment/api/webhook/simulator"
          # startupProbe gives the Spring Boot app up to 4 min (20 × 12 s) to finish starting
          # before liveness/readiness probes are allowed to run. This prevents premature restarts.
          # Optimized for 2-3 min average startup time with ~1 min buffer.
          startupProbe:
            httpGet:
              path: /actuator/health/liveness
              port: 8085
              scheme: HTTP
            periodSeconds: 12
            timeoutSeconds: 5
            failureThreshold: 20
          # livenessProbe restarts the container if the app becomes unresponsive after startup.
          # Quick failure detection (3 × 30 s) without being overly aggressive.
          livenessProbe:
            httpGet:
              path: /actuator/health/liveness
              port: 8085
              scheme: HTTP
            initialDelaySeconds: 0
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 3
            successThreshold: 1
          # readinessProbe removes the pod from service endpoints while it is still starting
          # or if it becomes temporarily unavailable. Slightly relaxed to handle GC pauses.
          readinessProbe:
            httpGet:
              path: /actuator/health/readiness
              port: 8085
              scheme: HTTP
            initialDelaySeconds: 0
            periodSeconds: 15
            timeoutSeconds: 5
            successThreshold: 1
            failureThreshold: 4
          resources:
            requests:
              cpu: "200m"
              memory: "512Mi"
            limits:
              cpu: "500m"
              memory: "1Gi"
          volumeMounts:
            - name: payment-service-logs
              mountPath: /var/log/payment-service
      volumes:
        - name: payment-service-logs
          emptyDir: {}
      terminationGracePeriodSeconds: 30
---
apiVersion: v1
kind: Service
metadata:
  name: payment-service
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: payment-service
    tier: backend
spec:
  selector:
    app: payment-service
  ports:
    - port: 8085
      targetPort: 8085
      name: http
  type: ClusterIP
