apiVersion: v1
kind: Service
metadata:
  name: catalog-service
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: catalog-service
spec:
  selector:
    app: catalog-service
  type: ClusterIP
  ports:
    - name: http
      port: 8082
      targetPort: http
    {{#hasService "internal" "grpc"}}
    - name: grpc
      port: 50052
      targetPort: grpc
    {{/hasService}}
