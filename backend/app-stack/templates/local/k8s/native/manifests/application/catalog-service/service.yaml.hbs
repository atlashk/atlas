apiVersion: v1
kind: Service
metadata:
  name: catalog-service
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: catalog-service
    tier: backend
spec:
  selector:
    app: catalog-service
  ports:
    - port: 8082
      targetPort: 8082
      name: http
    {{#hasService "internal" "grpc"}}
    - port: 50052
      targetPort: 50052
      name: grpc
    {{/hasService}}
  type: ClusterIP
