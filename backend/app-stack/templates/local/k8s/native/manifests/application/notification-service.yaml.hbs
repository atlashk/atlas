# Log volume changed to emptyDir for Promtail compatibility
# PersistentVolumeClaim removed - logs now use emptyDir volume
apiVersion: apps/v1
kind: Deployment
metadata:
  name: notification-service
  labels:
    app: notification-service
    tier: application
spec:
  replicas: 1
  selector:
    matchLabels:
      app: notification-service
  template:
    metadata:
      labels:
        app: notification-service
        tier: application
    spec:
      containers:
        - name: notification-service
          image: atlas/notification-service:latest
          imagePullPolicy: Never
          ports:
            - containerPort: 8085
              name: http
          env:
            {{#hasService "datasource" "mysql"}}
            - name: DB_URL
              value: "jdbc:mysql://mysql:3306/db_notification?useUnicode=yes&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false"
            - name: DB_USERNAME
              value: "atlas"
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: mysql-secret
                  key: mysql-password
            {{/hasService}}{{#hasService "datasource" "postgres"}}
            - name: DB_URL
              value: "jdbc:postgresql://postgres:5432/db_notification"
            - name: DB_USERNAME
              value: "atlas"
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: postgres-secret
                  key: postgres-password
            {{/hasService}}
            {{#hasService "kv-store" "redis"}}
            - name: REDIS_HOST
              value: "redis"
            - name: REDIS_PORT
              value: "6379"
            {{/hasService}}
            {{#hasService "messaging" "kafka"}}
            - name: KAFKA_BOOTSTRAP_SERVERS
              value: "kafka:29092"
            {{/hasService}}{{#hasService "messaging" "rabbitmq"}}
            - name: RABBITMQ_HOST
              value: "rabbitmq"
            - name: RABBITMQ_PORT
              value: "5672"
            - name: RABBITMQ_USERNAME
              value: "atlas"
            - name: RABBITMQ_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: rabbitmq-secret
                  key: rabbitmq-password
            {{/hasService}}
            {{#hasObservability "tracing" "zipkin"}}
            - name: ZIPKIN_ENDPOINT
              value: "http://zipkin:9411/api/v2/spans"
            {{/hasObservability}}
          # startupProbe gives the Spring Boot app up to 5 min (30 × 10 s) to finish starting
          # before liveness/readiness probes are allowed to run. This prevents premature restarts.
          startupProbe:
            httpGet:
              path: /actuator/health/liveness
              port: 8085
              scheme: HTTP
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 30
          # livenessProbe restarts the container if the app becomes unresponsive after startup.
          # Quick failure detection (3 × 30 s) without being overly aggressive.
          livenessProbe:
            httpGet:
              path: /actuator/health/liveness
              port: 8085
              scheme: HTTP
            initialDelaySeconds: 0
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 3
            successThreshold: 1
          # readinessProbe removes the pod from service endpoints while it is still starting
          # or if it becomes temporarily unavailable. Checks every 10 s for fast traffic routing.
          readinessProbe:
            httpGet:
              path: /actuator/health/readiness
              port: 8085
              scheme: HTTP
            initialDelaySeconds: 0
            periodSeconds: 10
            timeoutSeconds: 3
            successThreshold: 1
            failureThreshold: 3
          resources:
            requests:
              cpu: "200m"
              memory: "512Mi"
            limits:
              cpu: "500m"
              memory: "1Gi"
          volumeMounts:
            - name: notification-service-logs
              mountPath: /var/log/notification-service
        {{#hasObservability "logging.stack" "loki"}}
        # Promtail sidecar for log collection
        - name: promtail
          image: grafana/promtail:main
          imagePullPolicy: IfNotPresent
          args:
            - -config.file=/etc/promtail/promtail.yml
            - -config.expand-env
          env:
            - name: APP_NAME
              value: "notification-service"
          ports:
            - containerPort: 9080
              name: http
          livenessProbe:
            httpGet:
              path: /ready
              port: 9080
            initialDelaySeconds: 30
            periodSeconds: 30
            timeoutSeconds: 10
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /ready
              port: 9080
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 3
          resources:
            requests:
              cpu: "50m"
              memory: "64Mi"
            limits:
              cpu: "100m"
              memory: "128Mi"
          volumeMounts:
            - name: promtail-config
              mountPath: /etc/promtail
            - name: notification-service-logs
              mountPath: /var/log/notification-service
              readOnly: true
        {{/hasObservability}}
      volumes:
        - name: notification-service-logs
          emptyDir: {}
        {{#hasObservability "logging.stack" "loki"}}
        - name: promtail-config
          configMap:
            name: promtail-config
        {{/hasObservability}}
      terminationGracePeriodSeconds: 30
---
apiVersion: v1
kind: Service
metadata:
  name: notification-service
  labels:
    app: notification-service
    tier: application
spec:
  selector:
    app: notification-service
  ports:
    - port: 8085
      targetPort: 8085
      name: http
  type: ClusterIP
