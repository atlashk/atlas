{{#hasService "observability.metrics" "prometheus"}}
apiVersion: v1
kind: ConfigMap
metadata:
  name: prometheus
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: prometheus
data:
  prometheus.yml: |
    global:
      scrape_interval: 5s

    scrape_configs:
      - job_name: 'identity-service'
        metrics_path: '/actuator/prometheus'
        static_configs:
          - targets: ['identity-service:8081']
      - job_name: 'catalog-service'
        metrics_path: '/actuator/prometheus'
        static_configs:
          - targets: ['catalog-service:8082']
      - job_name: 'inventory-service'
        metrics_path: '/actuator/prometheus'
        static_configs:
          - targets: ['inventory-service:8083']
      - job_name: 'order-service'
        metrics_path: '/actuator/prometheus'
        static_configs:
          - targets: ['order-service:8084']
      - job_name: 'payment-service'
        metrics_path: '/actuator/prometheus'
        static_configs:
          - targets: ['payment-service:8085']
      - job_name: 'api-gateway'
        metrics_path: '/actuator/prometheus'
        static_configs:
          - targets: ['api-gateway:8080']
{{/hasService}}
