{{#hasService "observability.logging.stack" "loki"}}
# ServiceAccount: Creates an identity for Promtail to use
# This account will be used by Promtail pods to authenticate with Kubernetes API
apiVersion: v1
kind: ServiceAccount
metadata:
  name: promtail
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: promtail
---
# ClusterRole: Defines permissions that can be applied cluster-wide
# This role grants read-only access to essential Kubernetes resources needed for service discovery and log collection
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: promtail
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: promtail
rules:
  # Allow read access to core Kubernetes resources across all namespaces
  - apiGroups: [""] # Core API group (pods, services, etc.)
    resources:
      - "nodes"        # Read node information
      - "nodes/proxy"  # Access node proxy
      - "services"     # Service endpoints for load balancing
      - "endpoints"    # Backend pods for services
      - "pods"         # Container instances (most important for log collection)
    verbs:
      - "get"    # Retrieve individual resources
      - "list"   # List multiple resources
      - "watch"  # Watch for resource changes (real-time updates)
---
# ClusterRoleBinding: Binds the ClusterRole to subjects (users/groups/service accounts)
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: promtail
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: promtail
subjects:
  # Grant permissions to all ServiceAccounts in the namespace.
  - kind: Group
    name: system:serviceaccounts:{{dotenv.PROJECT_NAME}}
    apiGroup: rbac.authorization.k8s.io
roleRef:
  # Reference to the ClusterRole defined above
  kind: ClusterRole
  name: promtail
  apiGroup: rbac.authorization.k8s.io
{{/hasService}}
