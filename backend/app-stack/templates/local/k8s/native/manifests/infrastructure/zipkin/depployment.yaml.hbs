{{#hasService "observability.tracing" "zipkin"}}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: zipkin
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: zipkin
    tier: backend
spec:
  replicas: 1
  selector:
    matchLabels:
      app: zipkin
  template:
    metadata:
      labels:
        app: zipkin
        tier: backend
    spec:
      containers:
        - name: zipkin
          image: openzipkin/zipkin:latest
          imagePullPolicy: IfNotPresent
          env:
            - name: STORAGE_TYPE
              value: "mem"
          ports:
            - containerPort: 9411
              name: http
          livenessProbe:
            httpGet:
              path: /health
              port: 9411
            initialDelaySeconds: 30
            periodSeconds: 30
            timeoutSeconds: 10
            successThreshold: 1
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /health
              port: 9411
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 5
            successThreshold: 1
            failureThreshold: 3
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: 500m
              memory: 512Mi
{{/hasService}}
