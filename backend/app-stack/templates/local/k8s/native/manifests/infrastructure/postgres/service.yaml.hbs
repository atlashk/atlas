{{#hasService "datasource" "postgres"}}
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: postgres
spec:
  clusterIP: None
  selector:
    app: postgres
  ports:
    - name: postgres
      port: 5432
      targetPort: postgres
{{/hasService}}
