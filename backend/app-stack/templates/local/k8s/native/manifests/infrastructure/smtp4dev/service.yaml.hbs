{{#hasService "notification.email" "spring"}}
apiVersion: v1
kind: Service
metadata:
  name: smtp4dev
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: smtp4dev
spec:
  type: ClusterIP
  selector:
    app: smtp4dev
  ports:
    - name: http
      port: 80
      targetPort: http
    - name: smtp
      port: 25
      targetPort: smtp
{{/hasService}}
