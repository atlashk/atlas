{{#hasService "identity" "keycloak"}}
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-secret
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: keycloak
    tier: backend
type: Opaque
data:
  kc-bootstrap-admin-username: YWRtaW4=
  kc-bootstrap-admin-password: QXRsYXNAMTIzNDU2
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: keycloak-sts
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: keycloak
    tier: backend
spec:
  replicas: 1
  serviceName: keycloak
  selector:
    matchLabels:
      app: keycloak
  template:
    metadata:
      labels:
        app: keycloak
        tier: backend
    spec:
      containers:
        - name: keycloak
          image: quay.io/keycloak/keycloak:26.5.4
          imagePullPolicy: IfNotPresent
          args: ["start-dev"]
          env:
            - name: KC_BOOTSTRAP_ADMIN_USERNAME
              valueFrom:
                secretKeyRef:
                  name: keycloak-secret
                  key: kc-bootstrap-admin-username
            - name: KC_BOOTSTRAP_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: keycloak-secret
                  key: kc-bootstrap-admin-password
            {{#hasService "datasource" "postgres"}}
            - name: KC_DB
              value: "postgres"
            - name: KC_DB_URL
              value: "jdbc:postgresql://postgres:5432/db_keycloak"
            - name: KC_DB_USERNAME
              valueFrom:
                secretKeyRef:
                  name: postgres-secret
                  key: postgres-user
            - name: KC_DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: postgres-secret
                  key: postgres-password
            {{/hasService}}
            {{#hasService "datasource" "mysql"}}
            - name: KC_DB
              value: "mysql"
            - name: KC_DB_URL
              value: "jdbc:mysql://mysql:3306/db_keycloak?useUnicode=yes&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false"
            - name: KC_DB_USERNAME
              value: "atlas"
            - name: KC_DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: mysql-secret
                  key: mysql-password
            {{/hasService}}
            - name: KC_HEALTH_ENABLED
              value: "true"
            - name: KC_HTTP_MANAGEMENT_PORT
              value: "9000"
            - name: KC_METRICS_ENABLED
              value: "true"
          ports:
            - containerPort: 8080
              name: http
            - containerPort: 9000
              name: management
          startupProbe:
            httpGet:
              path: /health/started
              port: 9000
            initialDelaySeconds: 120
            periodSeconds: 10
            timeoutSeconds: 30
            successThreshold: 1
            failureThreshold: 60
          livenessProbe:
            httpGet:
              path: /health/live
              port: 9000
            initialDelaySeconds: 60
            periodSeconds: 30
            timeoutSeconds: 30
            successThreshold: 1
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /health/ready
              port: 9000
            initialDelaySeconds: 30
            periodSeconds: 10
            timeoutSeconds: 30
            successThreshold: 1
            failureThreshold: 3
          resources:
            limits:
              cpu: 2000m
              memory: 2000Mi
            requests:
              cpu: 500m
              memory: 1700Mi
---
apiVersion: v1
kind: Service
metadata:
  name: keycloak
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: keycloak
    tier: backend
spec:
  selector:
    app: keycloak
  ports:
    - port: 8080
      targetPort: 8080
      name: http
  type: ClusterIP
{{/hasService}}
