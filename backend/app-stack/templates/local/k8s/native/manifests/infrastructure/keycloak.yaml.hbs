{{#hasService "identity" "keycloak"}}
apiVersion: v1
kind: Secret
metadata:
  name: keycloak
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: keycloak
    tier: backend
type: Opaque
data:
  kc-bootstrap-admin-username: YXRsYXM=
  kc-bootstrap-admin-password: QXRsYXNAMTIzNDU2
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: keycloak-config
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: keycloak
    tier: backend
data:
  keycloak-realm: "default"
  keycloak-client-id: "default-auth"
  keycloak-client-secret: "9cvF5MPJnwfhEOCwNnQ79RmlkckAsDCj"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: keycloak-import
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: keycloak
    tier: backend
data:
  realm.json: |
    {
      "realm": "default",
      "enabled": true,
      "sslRequired": "none",
      "attributes": {
        "userProfileEnabled": "true"
      },
      "roles": {
        "realm": [
          {
            "name": "admin",
            "description": "Administrator role"
          },
          {
            "name": "user",
            "description": "User role"
          }
        ]
      },
      "components": {
        "org.keycloak.userprofile.UserProfileProvider": [
          {
            "providerId": "declarative-user-profile",
            "config": {
              "kc.user.profile.config": [
                "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]}},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"phoneNumber\",\"displayName\":\"Phone number\",\"validations\":{\"length\":{\"max\":20}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}}],\"groups\":[]}"
              ]
            }
          }
        ]
      },
      "clients": [
        {
          "clientId": "default-auth",
          "name": "default-auth",
          "enabled": true,
          "protocol": "openid-connect",
          "publicClient": false,
          "clientAuthenticatorType": "client-secret",
          "secret": "9cvF5MPJnwfhEOCwNnQ79RmlkckAsDCj",
          "serviceAccountsEnabled": true,
          "directAccessGrantsEnabled": true,
          "standardFlowEnabled": false,
          "implicitFlowEnabled": false,
          "bearerOnly": false,
          "consentRequired": false,
          "fullScopeAllowed": true,
          "defaultClientScopes": [
            "web-origins",
            "acr",
            "profile",
            "email",
            "roles"
          ],
          "optionalClientScopes": [
            "address",
            "phone",
            "offline_access",
            "microprofile-jwt"
          ]
        }
      ],
      "users": [
        {
          "username": "service-account-default-auth",
          "enabled": true,
          "serviceAccountClientId": "default-auth",
          "clientRoles": {
            "realm-management": [
              "view-users",
              "manage-users"
            ]
          }
        }
      ]
    }
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: keycloak
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: keycloak
    tier: backend
spec:
  replicas: 1
  serviceName: keycloak
  selector:
    matchLabels:
      app: keycloak
  template:
    metadata:
      labels:
        app: keycloak
        tier: backend
    spec:
      containers:
        - name: keycloak
          image: quay.io/keycloak/keycloak:26.5.4
          imagePullPolicy: IfNotPresent
          args: ["start-dev", "--import-realm"]
          env:
            - name: KC_HTTP_ENABLED
              value: "true"
            - name: KC_HOSTNAME_STRICT
              value: "false"
            - name: KC_PROXY_HEADERS
              value: "xforwarded"
            - name: KC_BOOTSTRAP_ADMIN_USERNAME
              valueFrom:
                secretKeyRef:
                  name: keycloak
                  key: kc-bootstrap-admin-username
            - name: KC_BOOTSTRAP_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: keycloak
                  key: kc-bootstrap-admin-password
            {{#hasService "datasource" "postgres"}}
            - name: KC_DB
              value: "postgres"
            - name: KC_DB_URL
              value: "jdbc:postgresql://postgres:5432/db_keycloak"
            - name: KC_DB_USERNAME
              valueFrom:
                secretKeyRef:
                  name: postgres
                  key: postgres-user
            - name: KC_DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: postgres
                  key: postgres-password
            {{/hasService}}
            {{#hasService "datasource" "mysql"}}
            - name: KC_DB
              value: "mysql"
            - name: KC_DB_URL
              value: "jdbc:mysql://mysql:3306/db_keycloak?useUnicode=yes&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false"
            - name: KC_DB_USERNAME
              value: "atlas"
            - name: KC_DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: mysql
                  key: mysql-password
            {{/hasService}}
            - name: KC_HEALTH_ENABLED
              value: "true"
            - name: KC_HTTP_MANAGEMENT_PORT
              value: "9000"
            - name: KC_METRICS_ENABLED
              value: "true"
          volumeMounts:
            - name: keycloak-import
              mountPath: /opt/keycloak/data/import
              readOnly: true
          ports:
            - containerPort: 8080
              name: http
            - containerPort: 9000
              name: management
          startupProbe:
            httpGet:
              path: /health/started
              port: 9000
            initialDelaySeconds: 120
            periodSeconds: 10
            timeoutSeconds: 30
            successThreshold: 1
            failureThreshold: 60
          livenessProbe:
            httpGet:
              path: /health/live
              port: 9000
            initialDelaySeconds: 60
            periodSeconds: 30
            timeoutSeconds: 30
            successThreshold: 1
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /health/ready
              port: 9000
            initialDelaySeconds: 30
            periodSeconds: 10
            timeoutSeconds: 30
            successThreshold: 1
            failureThreshold: 3
          resources:
            limits:
              cpu: 2000m
              memory: 2000Mi
            requests:
              cpu: 500m
              memory: 1700Mi
      volumes:
        - name: keycloak-import
          configMap:
            name: keycloak-import
---
apiVersion: v1
kind: Service
metadata:
  name: keycloak
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: keycloak
    tier: backend
spec:
  selector:
    app: keycloak
  ports:
    - port: 8080
      targetPort: 8080
      name: http
  type: ClusterIP
{{/hasService}}
