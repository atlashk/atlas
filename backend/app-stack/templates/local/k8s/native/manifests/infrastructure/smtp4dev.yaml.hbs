{{#hasService "notification.email" "spring"}}
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: smtp4dev
  namespace: atlas
  labels:
    app: smtp4dev
    tier: infrastructure
spec:
  replicas: 1
  serviceName: smtp4dev
  selector:
    matchLabels:
      app: smtp4dev
  template:
    metadata:
      labels:
        app: smtp4dev
        tier: infrastructure
    spec:
      containers:
        - name: smtp4dev
          image: rnwood/smtp4dev:latest
          imagePullPolicy: IfNotPresent
          env:
            - name: ServerOptions__HostName
              value: "smtp4dev"
          ports:
            - containerPort: 80
              name: http
            - containerPort: 25
              name: smtp
          volumeMounts:
            - name: smtp4dev-data
              mountPath: /smtp4dev
          livenessProbe:
            httpGet:
              path: /
              port: 80
            initialDelaySeconds: 30
            periodSeconds: 30
            timeoutSeconds: 10
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /
              port: 80
            initialDelaySeconds: 15
            periodSeconds: 10
            timeoutSeconds: 5
          resources:
            requests:
              cpu: "50m"
              memory: "128Mi"
            limits:
              cpu: "200m"
              memory: "256Mi"
  volumeClaimTemplates:
    - metadata:
        name: smtp4dev-data
        labels:
          app: smtp4dev
          tier: infrastructure
      spec:
        accessModes:
          - ReadWriteOnce
        resources:
          requests:
            storage: 1Gi
---
apiVersion: v1
kind: Service
metadata:
  name: smtp4dev
  namespace: atlas
  labels:
    app: smtp4dev
    tier: infrastructure
spec:
  clusterIP: None
  selector:
    app: smtp4dev
  ports:
    - port: 80
      targetPort: 80
      name: http
    - port: 25
      targetPort: 25
      name: smtp
  type: ClusterIP
{{/hasService}}
