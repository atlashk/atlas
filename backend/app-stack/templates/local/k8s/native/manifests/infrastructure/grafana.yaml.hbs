{{#hasGrafana}}
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: grafana-pvc
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: grafana
    tier: backend
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 2Gi
---
apiVersion: v1
kind: Secret
metadata:
  name: grafana-secret
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: grafana
    tier: backend
type: Opaque
data:
  admin-password: c2VjcmV0MTIzNDU2
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-provisioning-cm
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: grafana
    tier: backend
data:
  datasources.yml: |
    apiVersion: 1

    datasources:
    {{#hasService "observability.metrics" "prometheus"}}
      - name: Prometheus
        type: prometheus
        access: proxy
        url: http://prometheus:9090
        uid: DS_PROMETHEUS
        isDefault: true
        editable: true
        jsonData:
          timeInterval: 5s
          queryTimeout: 60s
          httpMethod: POST
        secureJsonData: { }
    {{/hasService}}
    {{#hasService "observability.logging.stack" "loki"}}
      - name: Loki
        type: loki
        access: proxy
        url: http://loki:3100
        uid: DS_LOKI
        editable: true
        jsonData:
          maxLines: 1000
        secureJsonData: { }
    {{/hasService}}
  
  dashboards.yml: |
    apiVersion: 1

    providers:
      - name: 'Dashboards'
        orgId: 1
        folder: 'Dashboards'
        type: file
        disableDeletion: false
        updateIntervalSeconds: 10
        allowUiUpdates: true
        options:
          path: /etc/grafana/dashboards
---
