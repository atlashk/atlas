{{#hasService "datasource" "mysql"}}
apiVersion: v1
kind: Service
metadata:
  name: mysql
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: mysql
    tier: backend
spec:
  clusterIP: None
  selector:
    app: mysql
  ports:
    - port: 3306
      targetPort: 3306
      name: mysql
  type: ClusterIP
{{/hasService}}
