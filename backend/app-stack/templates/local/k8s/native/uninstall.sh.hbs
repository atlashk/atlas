#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# CONFIGURATION
# =============================================================================

readonly PROJECT_NAME="{{dotenv.PROJECT_NAME}}"
readonly NAMESPACE="{{dotenv.PROJECT_NAME}}"

readonly SERVICES=(
  identity-service
  catalog-service
  inventory-service
  order-service
  payment-service
  api-gateway
)

REMOVE_IMAGES=false
CLUSTER_TYPE=""
CLUSTER_NAME=""

# =============================================================================
# UTILITIES
# =============================================================================

info()  { printf "%b\n" "[INFO] $1"; }
warn()  { printf "%b\n" "[WARN] $1"; }
error() { printf "%b\n" "[ERROR] $1" >&2; exit 1; }

# =============================================================================
# ARGUMENTS
# =============================================================================

usage() {
cat <<EOF
Usage: $0 [OPTIONS]

Clean Kubernetes dev environment

Options:
  --remove-images      Remove project Docker images
  -h, --help           Show this help
EOF
}

parse_args() {
  for arg in "$@"; do
    case "$arg" in
      --remove-images)
        REMOVE_IMAGES=true
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        error "Unknown parameter: $arg"
        ;;
    esac
  done
}

# =============================================================================
# PREREQUISITES
# =============================================================================

check_docker() {
  docker info &>/dev/null || error "Docker is not running"
  info "Docker found and running"
}

check_cluster() {
  command -v kubectl >/dev/null 2>&1 \
    || error "kubectl not found."

  CLUSTER_NAME="$(kubectl config current-context 2>/dev/null || true)"
  [[ -n "$CLUSTER_NAME" ]] \
    || error "No active Kubernetes context."

  case "$CLUSTER_NAME" in
    minikube*)
      CLUSTER_TYPE="minikube"
      command -v minikube >/dev/null 2>&1 \
        || error "minikube binary not found."
      ;;
    docker-desktop*)
      CLUSTER_TYPE="docker-desktop"
      ;;
    *)
      error "Unsupported Kubernetes context: $CLUSTER_NAME"
      ;;
  esac

  kubectl get nodes >/dev/null 2>&1 \
    || error "Cluster not reachable."

  kubectl get nodes --no-headers | grep -q ' Ready' \
    || error "No Ready nodes."
}

check_prerequisites() {
  info "Checking prerequisites..."
  check_docker
  check_cluster
  info "Prerequisites check passed"
}

# =============================================================================
# NAMESPACE CLEANUP
# =============================================================================

delete_namespace() {
  if ! kubectl get namespace "$NAMESPACE" >/dev/null 2>&1; then
    info "Namespace $NAMESPACE not found"
    return
  fi

  info "Deleting namespace $NAMESPACE"
  kubectl delete namespace "$NAMESPACE" --ignore-not-found

  info "Waiting for namespace deletion..."
  while kubectl get namespace "$NAMESPACE" >/dev/null 2>&1; do
    sleep 2
  done

  info "Namespace removed"
}

# =============================================================================
# CLUSTER IMAGE CLEANUP
# =============================================================================

remove_cluster_images() {
  for service in "${SERVICES[@]}"; do
    image="${PROJECT_NAME}/${service}:latest"

    case "$CLUSTER_TYPE" in
      minikube)
        info "Removing $image from Minikube"
        minikube image rm "$image" 2>/dev/null || true
        ;;

      docker-desktop)
        warn "Skipping cluster image removal for Docker Desktop"
        ;;
    esac
  done
}

# =============================================================================
# LOCAL IMAGE CLEANUP
# =============================================================================

remove_local_images() {
  info "Searching local images for ${PROJECT_NAME}..."
  images=$(docker images "${PROJECT_NAME}/*" \
    --format '{{"{{"}}.Repository{{"}}"}}:{{"{{"}}.Tag{{"}}"}}' \
    | grep -v "<none>" || true)
  if [[ -z "$images" ]]; then
    info "No local images found"
    return
  fi

  info "Removing local images..."
  echo "$images" | xargs -r docker rmi -f
  info "Local images removed"
}

# =============================================================================
# DOCKER CLEANUP
# =============================================================================

clean_dangling_images() {
  info "Removing dangling images..."

  docker image prune -f >/dev/null

  info "Dangling images removed"
}

clean_build_cache() {
  info "Cleaning Docker build cache..."

  docker builder prune -f >/dev/null

  info "Docker build cache cleaned"
}

# =============================================================================
# MAIN
# =============================================================================

main() {
  parse_args "$@"
  check_prerequisites

  delete_namespace
  if [[ "$REMOVE_IMAGES" == true ]]; then
    remove_cluster_images
    remove_local_images
  fi
  clean_dangling_images
  clean_build_cache
}

main "$@"
