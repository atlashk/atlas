#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# CONFIGURATION
# =============================================================================

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_NAME="{{dotenv.PROJECT_NAME}}"
readonly NAMESPACE="{{dotenv.PROJECT_NAME}}"
readonly NAMESPACE_TIMEOUT=120

readonly SERVICES=(
  "identity-service"
  "catalog-service"
  "inventory-service"
  "order-service"
  "payment-service"
  "api-gateway"
)

REMOVE_APPLICATION_IMAGES=false
CLUSTER_TYPE=""
CLUSTER_NAME=""

# =============================================================================
# UTILITIES
# =============================================================================

die() { echo "Error: $1" >&2; exit 1; }
info() { echo "$1"; }
warn() { echo "Warning: $1" >&2; }

# =============================================================================
# USAGE
# =============================================================================

show_usage() {
  cat <<EOF
Usage: $0 [OPTIONS]

Uninstall services using Docker Compose

Options:
  --remove-application-images  Remove application Docker images (default: false)
  -h, --help                   Show this help message
EOF
}

parse_arguments() {
  for arg in "$@"; do
    case $arg in
      --remove-application-images) REMOVE_APPLICATION_IMAGES=true ;;
      -h|--help)                   show_usage; exit 0 ;;
      *)                           die "Unknown parameter: $arg" ;;
    esac
  done
}

# =============================================================================
# PREREQUISITES
# =============================================================================

check_cluster() {
  command -v kubectl >/dev/null 2>&1 \
    || die "kubectl not found."

  CLUSTER_NAME="$(kubectl config current-context 2>/dev/null || true)"
  [[ -n "$CLUSTER_NAME" ]] \
    || die "No active Kubernetes context."

  case "$CLUSTER_NAME" in
    minikube*)
      CLUSTER_TYPE="minikube"
      command -v minikube >/dev/null 2>&1 \
        || die "minikube binary not found."
      ;;
    *)
      die "Unsupported Kubernetes context: $CLUSTER_NAME"
      ;;
  esac

  kubectl get nodes >/dev/null 2>&1 \
    || die "Cluster not reachable."

  kubectl get nodes --no-headers | grep -q ' Ready' \
    || die "No Ready nodes."
}

check_prerequisites() {
  info "Checking prerequisites..."
  check_cluster
  info "Prerequisites check passed"
}

# =============================================================================
# CLEANUP
# =============================================================================

wait_for_namespace_deletion() {
  local timeout=$NAMESPACE_TIMEOUT
  while kubectl get namespace "$NAMESPACE" >/dev/null 2>&1 && [[ $timeout -gt 0 ]]; do
    sleep 2
    ((timeout -= 2))
  done

  if kubectl get namespace "$NAMESPACE" >/dev/null 2>&1; then
    warn "Namespace deletion is taking longer than expected"
  else
    info "Namespace '$NAMESPACE' deleted"
  fi
}

remove_namespace() {
  info "Deleting namespace '$NAMESPACE'..."
  kubectl delete namespace "$NAMESPACE" --ignore-not-found=true
  wait_for_namespace_deletion
}

remove_image_from_cluster() {
  local image="$1"

  case "$CLUSTER_TYPE" in
    minikube)
      info "Removing image $image from Minikube..."
      minikube image rm "$image" 2>/dev/null || true
      ;;
    kind)
      info "Removing image $image from Kind cluster '$CLUSTER_NAME'..."
      docker exec "${CLUSTER_NAME}-control-plane" crictl rmi "$image" 2>/dev/null || true
      ;;
  esac
}

remove_application_images() {
  info "Removing ${PROJECT_NAME} application images..."

  # Remove images from cluster
  for service in "${SERVICES[@]}"; do
    local image="$PROJECT_NAME/$service:latest"
    remove_image_from_cluster "$image"
  done

  # Remove local Docker images
  local images
  images=$(docker images --format "\{{.Repository}}:\{{.Tag}}" | grep "^${PROJECT_NAME}/" || true)

  if [[ -z "$images" ]]; then
    info "No ${PROJECT_NAME} images found locally"
    return 0
  fi

  echo "$images" | xargs docker rmi -f 2>/dev/null || true
  info "${PROJECT_NAME} images removed"
}

# =============================================================================
# MAIN
# =============================================================================

main() {
  parse_args "$@"
  check_prerequisites

  # Remove namespace and its resources
  remove_namespace

  # Remove application images if requested
  if [[ "$REMOVE_APPLICATION_IMAGES" == "true" ]]; then
    remove_application_images
  fi
}

main "$@"
