#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# CONFIGURATION
# =============================================================================

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_NAME="{{dotenv.PROJECT_NAME}}"
readonly NAMESPACE="{{dotenv.PROJECT_NAME}}"
readonly NAMESPACE_TIMEOUT=120

readonly SERVICES=(
  "identity-service"
  "catalog-service"
  "inventory-service"
  "order-service"
  "payment-service"
  "api-gateway"
)

REMOVE_APPLICATION_IMAGES=false
CLUSTER_TYPE=""
CLUSTER_NAME=""

# =============================================================================
# UTILITIES
# =============================================================================

die() { echo "Error: $1" >&2; exit 1; }
info() { echo "$1"; }
warn() { echo "Warning: $1" >&2; }

command_exists() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Options:
    --remove-application-images    Remove application Docker images (default: false)
    -h, --help                     Show this help message

Examples:
    $(basename "$0")                              # Uninstall without removing images
    $(basename "$0") --remove-application-images  # Uninstall and remove application images
EOF
  exit 0
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --remove-application-images)
        REMOVE_APPLICATION_IMAGES=true
        shift
        ;;
      -h|--help)
        usage
        ;;
      *)
        die "Unknown option: $1"
        ;;
    esac
  done
}

# =============================================================================
# PREREQUISITES
# =============================================================================

check_prerequisites() {
  info "Checking prerequisites..."
  command_exists kubectl || die "kubectl is not installed"
  kubectl cluster-info >/dev/null 2>&1 || die "Cannot connect to Kubernetes cluster"
  info "Prerequisites check passed"
}

# =============================================================================
# CLUSTER DETECTION
# =============================================================================

detect_cluster() {
  command -v kubectl >/dev/null 2>&1 || return 0

  local context
  context="$(kubectl config current-context 2>/dev/null || true)"

  case "$context" in
    minikube)
      command -v minikube >/dev/null 2>&1 && { CLUSTER_TYPE="minikube"; CLUSTER_NAME="minikube"; }
      ;;
    kind-*)
      command -v kind >/dev/null 2>&1 && { CLUSTER_TYPE="kind"; CLUSTER_NAME="${context#kind-}"; }
      ;;
  esac
}

remove_image_from_cluster() {
  local image="$1"

  case "$CLUSTER_TYPE" in
    minikube)
      info "Removing image $image from Minikube..."
      minikube image rm "$image" 2>/dev/null || true
      ;;
    kind)
      info "Removing image $image from Kind cluster '$CLUSTER_NAME'..."
      docker exec "${CLUSTER_NAME}-control-plane" crictl rmi "$image" 2>/dev/null || true
      ;;
  esac
}

# =============================================================================
# CLEANUP
# =============================================================================

wait_for_namespace_deletion() {
  local timeout=$NAMESPACE_TIMEOUT
  while kubectl get namespace "$NAMESPACE" >/dev/null 2>&1 && [[ $timeout -gt 0 ]]; do
    sleep 2
    ((timeout -= 2))
  done

  if kubectl get namespace "$NAMESPACE" >/dev/null 2>&1; then
    warn "Namespace deletion is taking longer than expected"
  else
    info "Namespace '$NAMESPACE' deleted"
  fi
}

remove_namespace() {
  info "Deleting namespace '$NAMESPACE'..."
  kubectl delete namespace "$NAMESPACE" --ignore-not-found=true
  wait_for_namespace_deletion
}

remove_application_images() {
  info "Removing ${PROJECT_NAME} application images..."

  detect_cluster
  if [[ -n "$CLUSTER_TYPE" ]]; then
    info "Detected Kubernetes context: $CLUSTER_TYPE ($CLUSTER_NAME). Images will be removed from cluster."
  fi

  # Remove images from cluster
  for service in "${SERVICES[@]}"; do
    local image="$PROJECT_NAME/$service:latest"
    remove_image_from_cluster "$image"
  done

  # Remove local Docker images
  local images
  images=$(docker images --format "\{{.Repository}}:\{{.Tag}}" | grep "^${PROJECT_NAME}/" || true)

  if [[ -z "$images" ]]; then
    info "No ${PROJECT_NAME} images found locally"
    return 0
  fi

  echo "$images" | xargs docker rmi -f 2>/dev/null || true
  info "${PROJECT_NAME} images removed"
}

# =============================================================================
# MAIN
# =============================================================================

main() {
  parse_args "$@"
  info "Remove application images: $REMOVE_APPLICATION_IMAGES"

  check_prerequisites

  remove_namespace

  if [[ "$REMOVE_APPLICATION_IMAGES" == "true" ]]; then
    remove_application_images
  fi
}

main "$@"
