#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# CONFIGURATION
# =============================================================================

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_NAME="{{dotenv.PROJECT_NAME}}"
readonly NAMESPACE="{{dotenv.PROJECT_NAME}}"
readonly NAMESPACE_TIMEOUT=120

# =============================================================================
# UTILITIES
# =============================================================================

die() { echo "Error: $1" >&2; exit 1; }
info() { echo "$1"; }
warn() { echo "Warning: $1" >&2; }

command_exists() { command -v "$1" >/dev/null 2>&1; }

# =============================================================================
# PREREQUISITES
# =============================================================================

check_prerequisites() {
  info "Checking prerequisites..."
  command_exists kubectl || die "kubectl is not installed"
  kubectl cluster-info >/dev/null 2>&1 || die "Cannot connect to Kubernetes cluster"
  info "Prerequisites check passed"
}

# =============================================================================
# CLEANUP
# =============================================================================

wait_for_namespace_deletion() {
  local timeout=$NAMESPACE_TIMEOUT
  while kubectl get namespace "$NAMESPACE" >/dev/null 2>&1 && [[ $timeout -gt 0 ]]; do
    sleep 2
    ((timeout -= 2))
  done

  if kubectl get namespace "$NAMESPACE" >/dev/null 2>&1; then
    warn "Namespace deletion is taking longer than expected"
  else
    info "Namespace '$NAMESPACE' deleted"
  fi
}

remove_namespace() {
  info "Deleting namespace '$NAMESPACE'..."
  kubectl delete namespace "$NAMESPACE" --ignore-not-found=true
  wait_for_namespace_deletion
}

remove_application_images() {
  info "Removing ${PROJECT_NAME} application images..."

  local images
  images=$(docker images --format "\{{.Repository}}:\{{.Tag}}" | grep "^${PROJECT_NAME}/" || true)

  if [[ -z "$images" ]]; then
    info "No ${PROJECT_NAME} images found"
    return 0
  fi

  echo "$images" | xargs docker rmi -f 2>/dev/null || true
  info "${PROJECT_NAME} images removed"
}

# =============================================================================
# MAIN
# =============================================================================

main() {
  check_prerequisites
  info "Namespace: $NAMESPACE"
  remove_namespace
  remove_application_images
}

main "$@"
