#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# CONFIGURATION
# =============================================================================

readonly PROJECT_NAME="{{dotenv.PROJECT_NAME}}"
readonly APP_STACK="{{appStack}}"
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
readonly NAMESPACE="$PROJECT_NAME"
readonly MANIFESTS_DIR="$SCRIPT_DIR/manifests"
readonly GRADLEW="$PROJECT_ROOT/backend/gradlew"

readonly SERVICES=(
  "identity-service:$PROJECT_ROOT/backend/services/identity-service/identity-bootstrap"
  "catalog-service:$PROJECT_ROOT/backend/services/catalog-service/catalog-bootstrap"
  "inventory-service:$PROJECT_ROOT/backend/services/inventory-service/inventory-bootstrap"
  "order-service:$PROJECT_ROOT/backend/services/order-service/order-bootstrap"
  "payment-service:$PROJECT_ROOT/backend/services/payment-service/payment-bootstrap"
  "api-gateway:$PROJECT_ROOT/backend/services/api-gateway/spring-cloud-gateway/spring-cloud-gateway-server"
)

SECONDS=0
SKIP_BUILD=false
INFRA_ONLY=false

SKIP_TESTS=true
BUILD_JAR=true
BUILD_DOCKER=true
CLUSTER_TYPE=""
CLUSTER_NAME=""

# =============================================================================
# UTILITIES
# =============================================================================

info()  { printf "%b\n" "[INFO] $1"; }
warn()  { printf "%b\n" "[WARN] $1"; }
error() { printf "%b\n" "[ERROR] $1" >&2; exit 1; }

# =============================================================================
# USAGE
# =============================================================================

show_usage() {
  cat <<EOF
Usage: $0 [OPTIONS]

Atlas Kubernetes deployment script

Options:
  -h, --help              Show this help message
  --skip-build            Skip all build steps
  --infra-only            Apply only infrastructure manifests (implies --skip-build)
  --skip-tests=BOOL       Skip tests during JAR build (default: true)
  --build-jar=BOOL        Build JAR files (default: true)
  --build-docker=BOOL     Build Docker images (default: true)
EOF
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case $1 in
      -h|--help)     show_usage; exit 0 ;;
      --skip-build)  SKIP_BUILD=true; shift ;;
      --infra-only)  INFRA_ONLY=true; SKIP_BUILD=true; shift ;;
      --skip-tests=*)   SKIP_TESTS="${1#*=}"; shift ;;
      --build-jar=*)    BUILD_JAR="${1#*=}"; shift ;;
      --build-docker=*) BUILD_DOCKER="${1#*=}"; shift ;;
      *)                error "Unknown option: $1. Use --help for usage information" ;;
    esac
  done
}

# =============================================================================
# PREREQUISITES
# =============================================================================

check_java() {
  command -v java &>/dev/null || error "Java is not installed or not in PATH"

  local version
  version=$(java -version 2>&1 | head -n 1)

  local major
  if [[ "$version" =~ \"1\.([0-9]+) ]]; then
    major="${BASH_REMATCH[1]}"
  elif [[ "$version" =~ \"([0-9]+) ]]; then
    major="${BASH_REMATCH[1]}"
  else
    major=0
  fi

  [[ $major -ge 17 ]] || error "Java 17 or later is required (found: $version)"
  info "Java found: $version"
}

check_docker() {
  docker info &>/dev/null || error "Docker is not running"
  info "Docker found and running"
}

check_cluster() {
  command -v kubectl >/dev/null 2>&1 \
    || error "kubectl not found."

  CLUSTER_NAME="$(kubectl config current-context 2>/dev/null || true)"
  [[ -n "$CLUSTER_NAME" ]] \
    || error "No active Kubernetes context."

  case "$CLUSTER_NAME" in
    minikube*)
      CLUSTER_TYPE="minikube"
      command -v minikube >/dev/null 2>&1 \
        || error "minikube binary not found."
      ;;
    docker-desktop*)
      CLUSTER_TYPE="docker-desktop"
      ;;
    *)
      error "Unsupported Kubernetes context: $CLUSTER_NAME"
      ;;
  esac

  kubectl get nodes >/dev/null 2>&1 \
    || error "Cluster not reachable."

  kubectl get nodes --no-headers | grep -q ' Ready' \
    || error "No Ready nodes."
}

check_prerequisites() {
  info "Checking prerequisites..."
  if [[ "$SKIP_BUILD" == false && "$BUILD_JAR" == "true" ]]; then
    check_java
  fi
  check_docker
  check_cluster
  info "Prerequisites check passed"
}

# =============================================================================
# BUILD
# =============================================================================

build_jars() {
  [[ "$BUILD_JAR" == "true" ]] || return 0

  info "Starting JAR build process..."
  chmod +x "$GRADLEW"

  local gradle_args=("clean" "build")
  [[ "$SKIP_TESTS" == "true" ]] && gradle_args+=("-x" "test")
  [[ -n "$APP_STACK" ]] && gradle_args+=("-PappStack=$APP_STACK")

  (cd "$PROJECT_ROOT/backend" && "$GRADLEW" "${gradle_args[@]}") || error "Gradle build failed"

  info "JAR build completed successfully."
  echo
}

load_image_to_cluster() {
  local image="$1"

  case "$CLUSTER_TYPE" in
    minikube)
      info "Loading image $image into Minikube..."
      minikube image load "$image"
      ;;
    docker-desktop)
      # Docker Desktop cluster detected; skipping image load for $image
      ;;
  esac
}

build_docker_images() {
  [[ "$BUILD_DOCKER" == "true" ]] || return 0

  info "Starting Docker build process..."

  CLUSTER_NAME="$(kubectl config current-context 2>/dev/null || true)"
  [[ -n "$CLUSTER_NAME" ]] || error "No active Kubernetes context."

  case "$CLUSTER_NAME" in
    minikube*)
      CLUSTER_TYPE="minikube"
      command -v minikube >/dev/null 2>&1 || error "minikube binary not found."
      ;;
    docker-desktop*)
      CLUSTER_TYPE="docker-desktop"
      ;;
    *)
      error "Unsupported Kubernetes context: $CLUSTER_NAME"
      ;;
  esac

  info "Detected Kubernetes context: $CLUSTER_TYPE ($CLUSTER_NAME). Images will be loaded into cluster."

  [[ ${#SERVICES[@]} -eq 0 ]] && error "No services specified to build"

  for entry in "${SERVICES[@]}"; do
    local name="${entry%%:*}"
    local context="${entry#*:}"
    local image="$PROJECT_NAME/$name"

    info "Building Docker image for $image..."
    docker build -t "$image:latest" -t "$image" "$context" || error "Failed to build Docker image for $image"
    load_image_to_cluster "$image:latest"
    info "Built Docker image for $image successfully."
  done

  info "Docker images build process completed successfully."
  echo
}

# =============================================================================
# DEPLOYMENT
# =============================================================================

create_namespace() {
  if kubectl get namespace "$NAMESPACE" >/dev/null 2>&1; then
    info "Namespace '$NAMESPACE' already exists"
  else
    info "Creating namespace '$NAMESPACE'"
    kubectl create namespace "$NAMESPACE"
  fi
}

# Extract resource names from kubectl apply output
extract_resources() {
  local output="$1"
  local pattern="$2"
  echo "$output" | awk '{print $1}' | grep -E "$pattern" || true
}

wait_for_crds() {
  local resources="$1"
  local crd_names
  crd_names=$(echo "$resources" | awk -F'/' '/^customresourcedefinition(\.apiextensions\.k8s\.io)?\//{print $2}')

  [[ -z "$crd_names" ]] && return 0

  info "Waiting for CRDs to be established..."
  local wait_args=()
  while IFS= read -r name; do
    [[ -n "$name" ]] && wait_args+=("customresourcedefinition.apiextensions.k8s.io/$name")
  done <<< "$crd_names"

  [[ ${#wait_args[@]} -gt 0 ]] && kubectl wait --for=condition=Established "${wait_args[@]}" --timeout=0s
}

wait_for_workloads() {
  local resources="$1"
  local workloads
  workloads=$(echo "$resources" |
    sed -E 's/^(deployment|statefulset|daemonset)(\.apps)?\//\1\//' |
    grep -E '^(deployment|statefulset|daemonset)/' || true)

  [[ -z "$workloads" ]] && return 0

  info "Waiting for workloads to finish rollout..."
  while IFS= read -r res; do
    [[ -n "$res" ]] && kubectl -n "$NAMESPACE" rollout status "$res" --timeout=0s
  done <<< "$workloads"
}

wait_for_jobs() {
  local resources="$1"
  local jobs
  jobs=$(echo "$resources" | sed -E 's/^job(\.batch)?\//job\//' | grep -E '^job/' || true)

  [[ -z "$jobs" ]] && return 0

  info "Waiting for jobs to complete..."
  while IFS= read -r res; do
    [[ -n "$res" ]] && kubectl -n "$NAMESPACE" wait --for=condition=complete "$res" --timeout=0s
  done <<< "$jobs"
}

apply_and_wait() {
  local dir="$1"

  [[ -d "$dir" ]] || return 0

  info "Applying manifests from $dir..."
  local output
  output=$(kubectl apply -n "$NAMESPACE" -f "$dir")
  echo "$output"

  local resources
  resources=$(echo "$output" | awk '{print $1}')

  wait_for_crds "$resources"
  wait_for_workloads "$resources"
  wait_for_jobs "$resources"
}

apply_manifests() {
  info "Applying Kubernetes manifests to namespace '$NAMESPACE'..."

  apply_and_wait "$MANIFESTS_DIR/security"

  apply_and_wait "$MANIFESTS_DIR/infrastructure"

  [[ "$INFRA_ONLY" == true ]] && return 0

  apply_and_wait "$MANIFESTS_DIR/application"
}

# =============================================================================
# RUNTIME
# =============================================================================

print_total_time() {
  printf "Total runtime: %02d:%02d:%02d\n" $((SECONDS/3600)) $(((SECONDS%3600)/60)) $((SECONDS%60))
}
trap print_total_time EXIT

# =============================================================================
# MAIN
# =============================================================================

main() {
  parse_args "$@"
  check_prerequisites

  # Build services
  if [[ "$SKIP_BUILD" == true ]]; then
    info "Skipping build step"
  else
    build_jars
    build_docker_images
  fi

  # Deploy services
  create_namespace
  apply_manifests
}

main "$@"
