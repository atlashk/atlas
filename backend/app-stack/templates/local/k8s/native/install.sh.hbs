#!/bin/bash
set -euo pipefail

# =============================================================================
# CONFIGURATION
# =============================================================================

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_ROOT="$(cd "$SCRIPT_DIR/../../../" && pwd)"
readonly NAMESPACE="{{dotenv.PROJECT_NAME}}"
readonly MANIFESTS_DIR="$SCRIPT_DIR/manifests"

SECONDS=0
SKIP_BUILD=false
INFRA_ONLY=false

# =============================================================================
# UTILITIES
# =============================================================================

die() { echo "Error: $1" >&2; exit 1; }
info() { echo "$1"; }
warn() { echo "Warning: $1" >&2; }

command_exists() { command -v "$1" >/dev/null 2>&1; }

# =============================================================================
# ARGUMENT PARSING
# =============================================================================

show_help() {
  cat <<EOF
Usage: $0 [OPTIONS]

Atlas Kubernetes deployment script

Options:
  -h, --help        Show this help message
  --skip-build      Skip backend and Docker image builds
  --infra-only      Apply only infrastructure manifests (implies --skip-build)
EOF
}

parse_arguments() {
  while [[ $# -gt 0 ]]; do
    case $1 in
      -h|--help)     show_help; exit 0 ;;
      --skip-build)  SKIP_BUILD=true; shift ;;
      --infra-only)  INFRA_ONLY=true; SKIP_BUILD=true; shift ;;
      *)             die "Unknown option: $1. Use --help for usage information" ;;
    esac
  done
}

# =============================================================================
# PREREQUISITES
# =============================================================================

check_prerequisites() {
  info "Checking prerequisites..."

  command_exists kubectl || die "kubectl is not installed"
  kubectl cluster-info >/dev/null 2>&1 || die "Cannot connect to Kubernetes cluster"

  if [[ "$SKIP_BUILD" == false ]]; then
    command_exists java || die "Java is not installed. Please install Java 17 or later."
    docker info >/dev/null 2>&1 || die "Docker is not running. Please start Docker."
  fi

  info "Prerequisites check passed"
}

# =============================================================================
# BUILD
# =============================================================================

build_services() {
  info "Building services..."

  local build_script="$SCRIPT_DIR/build.sh"
  [[ -f "$build_script" ]] || die "Build script not found: $build_script"

  chmod +x "$SCRIPT_DIR/"*.sh
  "$build_script" || die "Build failed"

  info "Build completed successfully"
  echo
}

# =============================================================================
# INGRESS CONTROLLER
# =============================================================================

detect_cluster_provider() {
  if kubectl get nodes -o jsonpath='{.items[0].metadata.labels}' 2>/dev/null | grep -q 'ingress-ready=true'; then
    echo "kind"
  else
    echo "cloud"
  fi
}

install_ingress_controller() {
  {{#hasService "reverse-proxy" "nginx"}}
  info "Ensuring NGINX Ingress Controller is installed..."

  # Check if already deployed
  if kubectl get deployment ingress-nginx-controller -n ingress-nginx >/dev/null 2>&1; then
    info "NGINX Ingress Controller already deployed"
    return 0
  fi

  local provider
  provider=$(detect_cluster_provider)
  info "Installing NGINX Ingress Controller ($provider provider)..."

  local manifest_url="https://raw.githubusercontent.com/kubernetes/ingress-nginx/main/deploy/static/provider/${provider}/deploy.yaml"
  kubectl apply -f "$manifest_url" || die "Failed to install NGINX Ingress Controller"

  info "Waiting for NGINX Ingress Controller readiness..."
  kubectl wait \
    --namespace ingress-nginx \
    --for=condition=ready pod \
    --selector=app.kubernetes.io/component=controller \
    --timeout=0s || die "NGINX Ingress Controller did not become ready. Check status with: kubectl get pods -n ingress-nginx"

  info "NGINX Ingress Controller is ready"
  {{else}}
  info "Reverse proxy not set to NGINX; skipping ingress controller install"
  {{/hasService}}
}

# =============================================================================
# DEPLOYMENT
# =============================================================================

create_namespace() {
  if kubectl get namespace "$NAMESPACE" >/dev/null 2>&1; then
    info "Namespace '$NAMESPACE' already exists"
  else
    info "Creating namespace '$NAMESPACE'"
    kubectl create namespace "$NAMESPACE"
  fi
}

# Extract resource names from kubectl apply output
extract_resources() {
  local output="$1"
  local pattern="$2"
  echo "$output" | awk '{print $1}' | grep -E "$pattern" || true
}

wait_for_crds() {
  local resources="$1"
  local crd_names
  crd_names=$(echo "$resources" | awk -F'/' '/^customresourcedefinition(\.apiextensions\.k8s\.io)?\//{print $2}')

  [[ -z "$crd_names" ]] && return 0

  info "Waiting for CRDs to be established..."
  local wait_args=()
  while IFS= read -r name; do
    [[ -n "$name" ]] && wait_args+=("customresourcedefinition.apiextensions.k8s.io/$name")
  done <<< "$crd_names"

  [[ ${#wait_args[@]} -gt 0 ]] && kubectl wait --for=condition=Established "${wait_args[@]}" --timeout=0s
}

wait_for_workloads() {
  local resources="$1"
  local workloads
  workloads=$(echo "$resources" |
    sed -E 's/^(deployment|statefulset|daemonset)(\.apps)?\//\1\//' |
    grep -E '^(deployment|statefulset|daemonset)/' || true)

  [[ -z "$workloads" ]] && return 0

  info "Waiting for workloads to finish rollout..."
  while IFS= read -r res; do
    [[ -n "$res" ]] && kubectl -n "$NAMESPACE" rollout status "$res" --timeout=0s
  done <<< "$workloads"
}

wait_for_jobs() {
  local resources="$1"
  local jobs
  jobs=$(echo "$resources" | sed -E 's/^job(\.batch)?\//job\//' | grep -E '^job/' || true)

  [[ -z "$jobs" ]] && return 0

  info "Waiting for jobs to complete..."
  while IFS= read -r res; do
    [[ -n "$res" ]] && kubectl -n "$NAMESPACE" wait --for=condition=complete "$res" --timeout=0s
  done <<< "$jobs"
}

apply_and_wait() {
  local dir="$1"

  [[ -d "$dir" ]] || return 0

  info "Applying manifests from $dir..."
  local output
  output=$(kubectl apply -n "$NAMESPACE" -f "$dir")
  echo "$output"

  local resources
  resources=$(echo "$output" | awk '{print $1}')

  wait_for_crds "$resources"
  wait_for_workloads "$resources"
  wait_for_jobs "$resources"
}

apply_manifests() {
  info "Applying Kubernetes manifests to namespace '$NAMESPACE'..."

  apply_and_wait "$MANIFESTS_DIR/infrastructure"

  [[ "$INFRA_ONLY" == true ]] && return 0

  apply_and_wait "$MANIFESTS_DIR/application"

  install_ingress_controller
  apply_and_wait "$MANIFESTS_DIR/ingress"
}

# =============================================================================
# RUNTIME
# =============================================================================

print_total_time() {
  printf "Total runtime: %02d:%02d:%02d\n" $((SECONDS/3600)) $(((SECONDS%3600)/60)) $((SECONDS%60))
}
trap print_total_time EXIT

# =============================================================================
# MAIN
# =============================================================================

main() {
  parse_arguments "$@"
  check_prerequisites

  if [[ "$SKIP_BUILD" == true ]]; then
    info "Skipping build step"
  else
    build_services
  fi

  create_namespace
  apply_manifests
}

main "$@"
