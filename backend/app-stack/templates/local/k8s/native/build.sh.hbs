#!/bin/bash
set -euo pipefail

# =============================================================================
# CONFIGURATION
# =============================================================================

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
readonly PROJECT_NAME="{{dotenv.PROJECT_NAME}}"
readonly GRADLEW="$PROJECT_ROOT/backend/gradlew"
readonly APP_STACK="{{#if appStack}}{{appStack}}{{/if}}"

readonly SERVICES=(
  "identity-service:$PROJECT_ROOT/backend/services/identity-service/identity-bootstrap"
  "catalog-service:$PROJECT_ROOT/backend/services/catalog-service/catalog-bootstrap"
  "inventory-service:$PROJECT_ROOT/backend/services/inventory-service/inventory-bootstrap"
  "order-service:$PROJECT_ROOT/backend/services/order-service/order-bootstrap"
  "payment-service:$PROJECT_ROOT/backend/services/payment-service/payment-bootstrap"
  "api-gateway:$PROJECT_ROOT/backend/services/api-gateway/spring-cloud-gateway/spring-cloud-gateway-server"
)

SKIP_TESTS=true
BUILD_JAR=true
BUILD_DOCKER=true
CLUSTER_TYPE=""
CLUSTER_NAME=""

# =============================================================================
# UTILITIES
# =============================================================================

die() { echo "Error: $1" >&2; exit 1; }
info() { echo "$1"; }

# =============================================================================
# USAGE
# =============================================================================

show_usage() {
  cat <<EOF
Usage: $0 [OPTIONS]

Build JAR files and Docker images for all services

Options:
  --skip-tests=BOOL       Skip tests during JAR build (default: true)
  --build-jar=BOOL        Build JAR files (default: true)
  --build-docker=BOOL     Build Docker images (default: true)
  -h, --help              Show this help message

Auto-load: If kubectl context is minikube or kind, images are loaded into cluster

Available services:
$(for s in "${SERVICES[@]}"; do echo "  - ${s%%:*}"; done)

Examples:
  $0                                          # Build JAR files and Docker images
  $0 --build-jar=false --build-docker=true    # Build Docker images only
  $0 --skip-tests=false                       # Build JAR files with tests enabled
EOF
}

parse_arguments() {
  for arg in "$@"; do
    case $arg in
      --skip-tests=*)   SKIP_TESTS="${arg#*=}" ;;
      --build-jar=*)    BUILD_JAR="${arg#*=}" ;;
      --build-docker=*) BUILD_DOCKER="${arg#*=}" ;;
      -h|--help)        show_usage; exit 0 ;;
      *)                die "Unknown parameter: $arg" ;;
    esac
  done
}

# =============================================================================
# CLUSTER DETECTION
# =============================================================================

detect_cluster() {
  command -v kubectl >/dev/null 2>&1 || return 0

  local context
  context="$(kubectl config current-context 2>/dev/null || true)"

  case "$context" in
    minikube)
      command -v minikube >/dev/null 2>&1 && { CLUSTER_TYPE="minikube"; CLUSTER_NAME="minikube"; }
      ;;
    kind-*)
      command -v kind >/dev/null 2>&1 && { CLUSTER_TYPE="kind"; CLUSTER_NAME="${context#kind-}"; }
      ;;
  esac
}

load_image_to_cluster() {
  local image="$1"

  case "$CLUSTER_TYPE" in
    minikube)
      info "Loading image $image into Minikube..."
      minikube image load "$image"
      ;;
    kind)
      info "Loading image $image into Kind cluster '$CLUSTER_NAME'..."
      kind load docker-image "$image" --name "$CLUSTER_NAME"
      ;;
  esac
}

# =============================================================================
# BUILD
# =============================================================================

build_jars() {
  [[ "$BUILD_JAR" == "true" ]] || return 0

  info "Starting JAR build process..."
  chmod +x "$GRADLEW"

  local gradle_args=("clean" "build")
  [[ "$SKIP_TESTS" == "true" ]] && gradle_args+=("-x" "test")
  [[ -n "$APP_STACK" ]] && gradle_args+=("-PappStack=$APP_STACK")

  (cd "$PROJECT_ROOT/backend" && "$GRADLEW" "${gradle_args[@]}") || die "Gradle build failed"

  info "JAR build completed successfully."
  echo
}

build_docker_images() {
  [[ "$BUILD_DOCKER" == "true" ]] || return 0

  info "Starting Docker build process..."

  detect_cluster
  if [[ -n "$CLUSTER_TYPE" ]]; then
    info "Detected Kubernetes context: $CLUSTER_TYPE ($CLUSTER_NAME). Images will be loaded into cluster."
  else
    info "No supported Kubernetes context detected. Images will be built locally."
  fi

  [[ ${#SERVICES[@]} -eq 0 ]] && die "No services specified to build"

  for entry in "${SERVICES[@]}"; do
    local name="${entry%%:*}"
    local context="${entry#*:}"
    local image="$PROJECT_NAME/$name"

    info "Building Docker image for $image..."
    docker build -t "$image:latest" -t "$image" "$context" || die "Failed to build Docker image for $image"
    load_image_to_cluster "$image:latest"
    info "Built Docker image for $image successfully."
  done

  info "Docker images build process completed successfully."
  cleanup_dangling_images
  echo
}

cleanup_dangling_images() {
  info "Cleaning up dangling images..."

  local dangling
  dangling=$(docker images -f "dangling=true" -q 2>/dev/null || true)

  if [[ -n "$dangling" ]]; then
    docker rmi $dangling 2>/dev/null || info "Some dangling images could not be removed (possibly in use)"
  else
    info "No dangling images to clean up."
  fi
}

# =============================================================================
# MAIN
# =============================================================================

main() {
  parse_arguments "$@"
  build_jars
  build_docker_images
  info "Build process completed successfully."
}

main "$@"
