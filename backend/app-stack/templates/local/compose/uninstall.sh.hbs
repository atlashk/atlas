#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# CONFIGURATION
# =============================================================================

readonly PROJECT_NAME="{{dotenv.PROJECT_NAME}}"
readonly APP_STACK="{{appStack}}"
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yml"

DOCKER_COMPOSE_CMD=""
REMOVE_APPLICATION_IMAGES=false

# =============================================================================
# UTILITIES
# =============================================================================

die() { echo "Error: $1" >&2; exit 1; }
info() { echo "$1"; }

# =============================================================================
# USAGE
# =============================================================================

show_usage() {
  cat <<EOF
Usage: $0 [OPTIONS]

Uninstall services using Docker Compose

Options:
  --remove-application-images  Remove application Docker images (default: false)
  -h, --help                   Show this help message
EOF
}

parse_arguments() {
  for arg in "$@"; do
    case $arg in
      --remove-application-images) REMOVE_APPLICATION_IMAGES=true ;;
      -h|--help)                   show_usage; exit 0 ;;
      *)                           die "Unknown parameter: $arg" ;;
    esac
  done
}

# =============================================================================
# PREREQUISITES
# =============================================================================

check_docker() {
  docker info &>/dev/null || die "Docker is not running"
  info "Docker found and running"
}

check_docker_compose() {
  if command -v docker-compose &>/dev/null; then
    DOCKER_COMPOSE_CMD="docker-compose"
    info "Docker Compose (standalone) found"
  elif docker compose version &>/dev/null; then
    DOCKER_COMPOSE_CMD="docker compose"
    info "Docker Compose (plugin) found"
  else
    die "Docker Compose is not installed. Please install Docker Compose or ensure Docker Desktop is running"
  fi
}

check_prerequisites() {
  info "Checking prerequisites..."
  check_docker
  check_docker_compose
  info "Prerequisites check passed"
}

# =============================================================================
# CLEANUP
# =============================================================================

remove_containers() {
  info "Stopping and removing containers and volumes..."
  $DOCKER_COMPOSE_CMD -f "$COMPOSE_FILE" -p "$PROJECT_NAME" down -v
}

remove_application_images() {
  info "Removing ${PROJECT_NAME} application images..."

  local images
  images=$(docker images --format "\{{.Repository}}:\{{.Tag}}" | grep "^${PROJECT_NAME}/" || true)

  if [[ -z "$images" ]]; then
    info "No ${PROJECT_NAME} images found"
    return 0
  fi

  echo "$images" | xargs docker rmi -f 2>/dev/null || true
  info "${PROJECT_NAME} images removed"
}

# =============================================================================
# MAIN
# =============================================================================

main() {
  parse_arguments "$@"
  check_prerequisites

  info "Uninstalling services for project: $PROJECT_NAME, app stack: $APP_STACK"

  # Remove containers and their volumes
  remove_containers

  # Remove application images if requested
  if [[ "$REMOVE_APPLICATION_IMAGES" == "true" ]]; then
    remove_application_images
  fi
}

main "$@"
