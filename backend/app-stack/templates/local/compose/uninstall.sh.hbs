#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# CONFIGURATION
# =============================================================================

readonly PROJECT_NAME="{{dotenv.PROJECT_NAME}}"
readonly APP_STACK="{{appStack}}"
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yml"

DOCKER_COMPOSE_CMD=""
REMOVE_IMAGES=false

# =============================================================================
# UTILITIES
# =============================================================================

info()  { printf "%b\n" "[INFO] $1"; }
warn()  { printf "%b\n" "[WARN] $1"; }
error() { printf "%b\n" "[ERROR] $1" >&2; exit 1; }

# =============================================================================
# USAGE
# =============================================================================

show_usage() {
cat <<EOF
Usage: $0 [OPTIONS]

Clean Docker Compose stack

Options:
  --remove-images   Remove Docker images
  -h, --help        Show this help message
EOF
}

parse_args() {
  for arg in "$@"; do
    case "$arg" in
      --remove-images)
        REMOVE_IMAGES=true
        ;;
      -h|--help)
        show_usage
        exit 0
        ;;
      *)
        die "Unknown parameter: $arg"
        ;;
    esac
  done
}

# =============================================================================
# PREREQUISITES
# =============================================================================

check_docker() {
  docker info >/dev/null 2>&1 || die "Docker is not running"
  info "Docker is running"
}

check_docker_compose() {

  if command -v docker-compose >/dev/null 2>&1; then
    DOCKER_COMPOSE_CMD="docker-compose"
  elif docker compose version >/dev/null 2>&1; then
    DOCKER_COMPOSE_CMD="docker compose"
  else
    die "Docker Compose not found"
  fi

  info "Using: $DOCKER_COMPOSE_CMD"
}

check_prerequisites() {
  info "Checking prerequisites..."
  check_docker
  check_docker_compose
  info "Prerequisites check passed"
}

# =============================================================================
# DOCKER CLEANUP
# =============================================================================

remove_containers() {
  info "Stopping and removing containers..."

  $DOCKER_COMPOSE_CMD -f "$COMPOSE_FILE" -p "$PROJECT_NAME" down --remove-orphans -v
}

remove_networks() {
  info "Removing unused project networks..."

  docker network ls \
    --filter "name=${PROJECT_NAME}" \
    --format "{{"{{"}}.Name{{"}}"}}" \
    | xargs -r docker network rm >/dev/null 2>&1 || true
}

remove_images() {
  info "Removing local images..."

  images=$(docker images "${PROJECT_NAME}/*" \
    --format '{{"{{"}}.Repository{{"}}"}}:{{"{{"}}.Tag{{"}}"}}' \
    | grep -v "<none>" || true)
  if [[ -z "$images" ]]; then
    info "No local images found"
    return
  fi

  echo "$images" | xargs -r docker rmi -f
}

remove_dangling_images() {
  info "Removing dangling images..."

  docker image prune -f >/dev/null
}

remove_build_cache() {
  info "Removing Docker build cache..."

  docker builder prune -f >/dev/null
}

# =============================================================================
# MAIN
# =============================================================================

main() {
  parse_args "$@"
  check_prerequisites

  remove_containers
  remove_networks
  if [[ "$REMOVE_IMAGES" == true ]]; then
    remove_images
  fi
  remove_dangling_images
  remove_build_cache
}

main "$@"
