#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# CONFIGURATION
# =============================================================================

readonly PROJECT_NAME="{{dotenv.PROJECT_NAME}}"
readonly APP_STACK="{{appStack}}"
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
readonly GRADLEW="$PROJECT_ROOT/backend/gradlew"
readonly COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yml"

DOCKER_COMPOSE_CMD=""

# =============================================================================
# UTILITIES
# =============================================================================

die() { echo "Error: $1" >&2; exit 1; }
info() { echo "==> $1"; }

# =============================================================================
# USAGE
# =============================================================================

show_usage() {
  cat <<EOF
Usage: $0 <service-name>

Rebuild and redeploy a single service using Docker Compose

Arguments:
  <service-name>     Service name to rebuild (required)

Available services:
{{#each services}}
  - {{this.name}}
{{/each}}

Examples:
  $0 identity-service
  $0 api-gateway
EOF
}

parse_arguments() {
  [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { show_usage; exit 0; }

  SERVICE_NAME="${1:-}"
  [[ -z "$SERVICE_NAME" ]] && { echo "Error: Missing required argument <service-name>" >&2; echo; show_usage; exit 1; }
}

# =============================================================================
# PREREQUISITES
# =============================================================================

check_java() {
  command -v java &>/dev/null || die "Java is not installed or not in PATH"

  local version
  version=$(java -version 2>&1 | head -n 1)

  local major
  if [[ "$version" =~ \"1\.([0-9]+) ]]; then
    major="${BASH_REMATCH[1]}"
  elif [[ "$version" =~ \"([0-9]+) ]]; then
    major="${BASH_REMATCH[1]}"
  else
    major=0
  fi

  [[ $major -ge 17 ]] || die "Java 17 or later is required (found: $version)"
  info "Java found: $version"
}

check_docker() {
  docker info &>/dev/null || die "Docker is not running"
  info "Docker found and running"
}

check_docker_compose() {
  if command -v docker-compose &>/dev/null; then
    DOCKER_COMPOSE_CMD="docker-compose"
    info "Docker Compose (standalone) found"
  elif docker compose version &>/dev/null; then
    DOCKER_COMPOSE_CMD="docker compose"
    info "Docker Compose (plugin) found"
  else
    die "Docker Compose is not installed. Please install Docker Compose or ensure Docker Desktop is running"
  fi
}

check_prerequisites() {
  info "Checking prerequisites..."
  check_java
  check_docker
  check_docker_compose
  info "Prerequisites check passed"
}

# =============================================================================
# BUILD
# =============================================================================

resolve_service_paths() {
  if [[ "$SERVICE_NAME" == "api-gateway" ]]; then
    MODULE_PATH="backend/services/api-gateway/spring-cloud-gateway/spring-cloud-gateway-server"
    IMAGE_NAME="${PROJECT_NAME}/api-gateway"
  {{#hasService "service-discovery" "eureka"}}
  elif [[ "$SERVICE_NAME" == "eureka-server" ]]; then
    MODULE_PATH="backend/platform/discovery-server/eureka-server"
    IMAGE_NAME="${PROJECT_NAME}/eureka-server"
  {{/hasService}}
  else
    local base_name="${SERVICE_NAME%-service}"
    MODULE_PATH="backend/services/${SERVICE_NAME}/${base_name}-bootstrap"
    IMAGE_NAME="${PROJECT_NAME}/${SERVICE_NAME}"
  fi
}

build_jar() {
  [[ -z "$SERVICE_NAME" ]] && die "No service specified to build"

  info "Building JAR for $SERVICE_NAME..."
  chmod +x "$GRADLEW"

  local gradle_args=("clean" "build" "-x" "test")
  [[ -n "$APP_STACK" ]] && gradle_args+=("-PappStack=$APP_STACK")

  (cd "$PROJECT_ROOT/backend" && "$GRADLEW" "${gradle_args[@]}" -p "$PROJECT_ROOT/$MODULE_PATH") || die "Gradle build failed for $SERVICE_NAME"

  info "JAR build for $SERVICE_NAME completed successfully."
}

build_docker_image() {
  info "Building Docker image for $IMAGE_NAME..."

  docker rmi "${IMAGE_NAME}:latest" 2>/dev/null || true
  docker build --no-cache -t "${IMAGE_NAME}:latest" -t "${IMAGE_NAME}" "$PROJECT_ROOT/$MODULE_PATH" || die "Failed to build Docker image for $IMAGE_NAME"

  info "Built Docker image for $IMAGE_NAME successfully."
}

# =============================================================================
# DEPLOYMENT
# =============================================================================

cleanup_dangling_images() {
  info "Cleaning up dangling images..."

  local dangling
  dangling=$(docker images -f "dangling=true" -q 2>/dev/null || true)

  if [[ -n "$dangling" ]]; then
    docker rmi $dangling 2>/dev/null || info "Some dangling images could not be removed (possibly in use)"
  else
    info "No dangling images to clean up."
  fi
}

restart_service() {
  info "Stopping old container..."
  $DOCKER_COMPOSE_CMD -f "$COMPOSE_FILE" -p "$PROJECT_NAME" stop "$SERVICE_NAME" 2>/dev/null || true
  $DOCKER_COMPOSE_CMD -f "$COMPOSE_FILE" -p "$PROJECT_NAME" rm -f "$SERVICE_NAME" 2>/dev/null || true

  info "Starting service with new image..."
  $DOCKER_COMPOSE_CMD -f "$COMPOSE_FILE" -p "$PROJECT_NAME" up -d "$SERVICE_NAME"

  echo
  info "Service status:"
  $DOCKER_COMPOSE_CMD -f "$COMPOSE_FILE" -p "$PROJECT_NAME" ps "$SERVICE_NAME"
}

# =============================================================================
# MAIN
# =============================================================================

main() {
  parse_arguments "$@"

  check_prerequisites

  info "Rebuilding service: $SERVICE_NAME..."

  resolve_service_paths
  build_jar
  build_docker_image
  cleanup_dangling_images
  restart_service

  echo
  info "Successfully rebuilt and restarted $SERVICE_NAME"
}

main "$@"
