#!/bin/bash

# Ensures that the script exits immediately if any command fails, or if you try to use an undefined variable.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
PROJECT_NAME="{{dotenv.PROJECT_NAME}}"
GRADLEW="$PROJECT_ROOT/backend/gradlew"

# Service definitions with name and build context
SERVICES=(
    "identity-service:$PROJECT_ROOT/backend/services/identity-service/identity-bootstrap"
    "catalog-service:$PROJECT_ROOT/backend/services/catalog-service/catalog-bootstrap"
    "inventory-service:$PROJECT_ROOT/backend/services/inventory-service/inventory-bootstrap"
    "order-service:$PROJECT_ROOT/backend/services/order-service/order-bootstrap"
    "payment-service:$PROJECT_ROOT/backend/services/payment-service/payment-bootstrap"
    "api-gateway:$PROJECT_ROOT/backend/services/api-gateway/spring-cloud-gateway/spring-cloud-gateway-server"
{{#hasService "service-discovery" "eureka"}}
    "eureka-server:$PROJECT_ROOT/backend/platform/discovery-server/eureka-server"
{{/hasService}}
)

# Default values
SKIP_TESTS="true"
BUILD_JAR="true"
BUILD_DOCKER="true"
APP_STACK="{{#if appStack}}{{appStack}}{{/if}}"

# Usage function
usage() {
    echo "Usage: $0 [OPTIONS]"
    echo "Options:"
    echo "  --skip-tests=BOOL       Skip tests during JAR build (default: true)"
    echo "  --build-jar=BOOL        Build JAR files (default: true)"
    echo "  --build-docker=BOOL     Build Docker images (default: true)"
    echo "  -h, --help              Show this help message"
    echo ""
    echo "Available services:"
    for service in "${SERVICES[@]}"; do
        name="${service%%:*}"
        echo "    - $name"
    done
    echo ""
    echo "Examples:"
    echo "  $0                                          # Build JAR files and Docker images"
    echo "  $0 --build-jar=false --build-docker=true    # Build Docker images only"
    echo "  $0 --skip-tests=false                       # Build JAR files with tests enabled"
}

# Parse named parameters
for arg in "$@"; do
    case $arg in
        --skip-tests=*)
            SKIP_TESTS="${arg#*=}"
            ;;
        --build-jar=*)
            BUILD_JAR="${arg#*=}"
            ;;
        --build-docker=*)
            BUILD_DOCKER="${arg#*=}"
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown parameter: $arg" >&2
            usage
            exit 1
            ;;
    esac
done

# Build JAR files if requested
if [ "$BUILD_JAR" = "true" ]; then
    echo "Starting JAR build process..."
    
    # Ensure gradlew is executable
    chmod +x "$GRADLEW"

    # Prepare Gradle arguments as array
    GRADLE_ARGS=("clean" "build")
    if [ "$SKIP_TESTS" = "true" ]; then
        GRADLE_ARGS+=("-x" "test")
    fi

    # Add app stack parameter if provided
    if [ -n "$APP_STACK" ]; then
        GRADLE_ARGS+=("-PappStack=$APP_STACK")
    fi

    # Build with Gradle
    echo "Starting Gradle build..."
    if (cd "$PROJECT_ROOT/backend" && "$GRADLEW" "${GRADLE_ARGS[@]}"); then
        echo "Gradle build completed successfully."
    else
        echo "Gradle build failed." >&2
        exit 1
    fi
    
    echo "JAR build completed successfully."
    echo
fi

# Build Docker images if requested
if [ "$BUILD_DOCKER" = "true" ]; then
    echo "Starting Docker build process..."

    # Validate services
    if [ "${#SERVICES[@]}" -eq 0 ]; then
        echo "No services specified to build." >&2
        exit 1
    fi

    # Build images
    for service_entry in "${SERVICES[@]}"; do
        service_name="${service_entry%%:*}"
        build_context="${service_entry#*:}"
        image_name="$PROJECT_NAME/$service_name"

        echo "Building Docker image for $image_name..."
        if ! docker build -t "$image_name:latest" -t "$image_name" "$build_context"; then
            echo "Failed to build Docker image for $image_name." >&2
            exit 1
        fi
        echo "Built Docker image for $image_name successfully."
    done

    echo "Docker images build process completed successfully."
    
    # Cleanup dangling images
    echo "Cleaning up dangling images..."
    if dangling_images=$(docker images -f "dangling=true" -q); then
        if [ -n "$dangling_images" ]; then
            echo "Removing dangling images..."
            docker rmi $dangling_images 2>/dev/null || echo "Some dangling images could not be removed (possibly in use)."
        else
            echo "No dangling images to clean up."
        fi
    else
        echo "No dangling images found."
    fi
    echo "Cleanup completed."
    echo
fi

echo "Build process completed successfully."
