services:

{{#hasService "datasource" "mysql"}}
  mysql:
    container_name: mysql
    image: mysql:8.0
    ports:
      - "3306:3306"
    environment:
      - MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD:-Atlas@123456}
      - MYSQL_USER=${MYSQL_USER:-atlas}
      - MYSQL_PASSWORD=${MYSQL_PASSWORD:-Atlas@123456}
    volumes:
      - ./config/mysql/initdb.sh:/docker-entrypoint-initdb.d/initdb.sh
      - mysql-data:/var/lib/mysql
    command: --default-authentication-plugin=mysql_native_password
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h localhost -u root -p\"$MYSQL_ROOT_PASSWORD\" || exit 1"]
      interval: 10s
      timeout: 10s
      retries: 10
      start_period: 60s
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasService "datasource" "postgres"}}
  postgres:
    container_name: postgres
    image: postgres:14
    ports:
      - "5432:5432"
    environment:
      - POSTGRES_USER=${POSTGRES_USER:-atlas}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-Atlas@123456}
    volumes:
      - ./config/postgres/initdb.sh:/docker-entrypoint-initdb.d/initdb.sh
      - postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $POSTGRES_USER"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasService "kv-store" "redis"}}
  redis:
    container_name: redis
    image: redis:7
    ports:
      - "6379:6379"
    volumes:
      - redis-data:/data
    command: redis-server --appendonly yes
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasService "messaging" "kafka"}}
  kafka:
    container_name: kafka
    image: confluentinc/cp-kafka:7.9.0
    ports:
      - "9092:9092"
      - "9093:9093"
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: 'CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT'
      KAFKA_ADVERTISED_LISTENERS: 'PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092'
      KAFKA_PROCESS_ROLES: 'broker,controller'
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_CONTROLLER_QUORUM_VOTERS: '1@kafka:29093'
      KAFKA_LISTENERS: 'PLAINTEXT://kafka:29092,CONTROLLER://kafka:29093,PLAINTEXT_HOST://0.0.0.0:9092'
      KAFKA_INTER_BROKER_LISTENER_NAME: 'PLAINTEXT'
      KAFKA_CONTROLLER_LISTENER_NAMES: 'CONTROLLER'
      CLUSTER_ID: 'MkU3OEVBNTcwNTJENDM2Qk'
    volumes:
      - kafka-data:/var/lib/kafka/data
    healthcheck:
      test: ["CMD-SHELL", "kafka-broker-api-versions --bootstrap-server localhost:9092 || exit 1"]
      interval: 10s
      timeout: 10s
      retries: 5
      start_period: 30s
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasService "messaging" "rabbitmq"}}
  rabbitmq:
    container_name: rabbitmq
    image: rabbitmq:3-management-alpine
    ports:
      - "5672:5672"
      - "15672:15672"
    environment:
      - RABBITMQ_DEFAULT_USER=${RABBITMQ_USER:-atlas}
      - RABBITMQ_DEFAULT_PASS=${RABBITMQ_PASSWORD:-Atlas@123456}
    volumes:
      - rabbitmq-data:/var/lib/rabbitmq
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasService "identity" "keycloak"}}
  keycloak:
    container_name: keycloak
    image: quay.io/keycloak/keycloak:26.5.4
    ports:
      - "8443:8080"
    environment:
      - KC_BOOTSTRAP_ADMIN_USERNAME=${KC_BOOTSTRAP_ADMIN_USERNAME:-atlas}
      - KC_BOOTSTRAP_ADMIN_PASSWORD=${KC_BOOTSTRAP_ADMIN_PASSWORD:-Atlas@123456}
      - KC_HTTP_ENABLED=true
      - KC_HOSTNAME_STRICT=false
      - KC_PROXY_HEADERS=xforwarded
      - KC_HEALTH_ENABLED=true
      - KC_HTTP_MANAGEMENT_PORT=9000
      {{#hasService "datasource" "postgres"}}
      - KC_DB=postgres
      - KC_DB_URL=jdbc:postgresql://postgres:5432/db_keycloak
      - KC_DB_USERNAME=${POSTGRES_USER:-atlas}
      - KC_DB_PASSWORD=${POSTGRES_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "datasource" "mysql"}}
      - KC_DB=mysql
      - KC_DB_URL=jdbc:mysql://mysql:3306/db_keycloak
      - KC_DB_USERNAME=${MYSQL_USER:-atlas}
      - KC_DB_PASSWORD=${MYSQL_PASSWORD:-Atlas@123456}
      {{/hasService}}
    volumes:
      - ./config/keycloak/import:/opt/keycloak/data/import:ro
    command:
      - start-dev
      - --import-realm
    healthcheck:
      test:
        - "CMD-SHELL"
        - |
          exec 3<>/dev/tcp/127.0.0.1/9000 || exit 1;
          echo -e "GET /health/ready HTTP/1.0\r\nHost: localhost\r\n\r\n" >&3;
          if timeout 3 cat <&3 | grep -q "\"status\": \"UP\""; then
            exit 0
          else
            exit 1
          fi
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 120s
    depends_on:
      {{#hasService "datasource" "postgres"}}
      postgres:
        condition: service_healthy
      {{/hasService}}
      {{#hasService "datasource" "mysql"}}
      mysql:
        condition: service_healthy
      {{/hasService}}
    networks:
      - {{dotenv.PROJECT_NAME}}-network

  keycloak-init:
    container_name: keycloak-init
    image: quay.io/keycloak/keycloak:26.5.4
    environment:
      - KC_BOOTSTRAP_ADMIN_USERNAME=${KC_BOOTSTRAP_ADMIN_USERNAME:-atlas}
      - KC_BOOTSTRAP_ADMIN_PASSWORD=${KC_BOOTSTRAP_ADMIN_PASSWORD:-Atlas@123456}
    volumes:
      - ./config/keycloak/keycloak-init.sh:/keycloak-init.sh:ro
    entrypoint: ["/bin/sh", "/keycloak-init.sh"]
    depends_on:
      keycloak:
        condition: service_healthy
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasService "full-text-search" "elasticsearch"}}
  elasticsearch:
    container_name: elasticsearch
    image: docker.elastic.co/elasticsearch/elasticsearch:8.19.11
    ports:
      - "9200:9200"
      - "9300:9300"
    environment:
      - discovery.type=single-node
      - xpack.security.enabled=false
      - "ES_JAVA_OPTS=-Xms512m -Xmx1g"
    volumes:
      - elasticsearch-data:/usr/share/elasticsearch/data
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:9200/_cluster/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 60s
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasService "storage" "minio"}}
  minio:
    container_name: minio
    image: minio/minio:latest
    ports:
      - "9000:9000"
      - "9001:9001"
    environment:
      - MINIO_ROOT_USER=${MINIO_ROOT_USER:-minioadmin}
      - MINIO_ROOT_PASSWORD=${MINIO_ROOT_PASSWORD:-Atlas@123456}
    volumes:
      - minio-data:/data
    command: server /data --console-address ":9001"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000/minio/health/live"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - {{dotenv.PROJECT_NAME}}-network

  minio-init:
    container_name: minio-init
    image: minio/mc:latest
    environment:
      - MINIO_ENDPOINT=${MINIO_ENDPOINT:-http://minio:9000}
      - MINIO_ROOT_USER=${MINIO_ROOT_USER:-minioadmin}
      - MINIO_ROOT_PASSWORD=${MINIO_ROOT_PASSWORD:-Atlas@123456}
      - MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY:-atlas}
      - MINIO_SECRET_KEY=${MINIO_SECRET_KEY:-Atlas@123456}
    volumes:
      - ./config/minio/minio-init.sh:/minio-init.sh:ro
    entrypoint: ["/bin/sh", "/minio-init.sh"]
    depends_on:
      minio:
        condition: service_healthy
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasService "notification.email" "spring"}}
  smtp4dev:
    container_name: smtp4dev
    image: rnwood/smtp4dev:latest
    ports:
      - "5000:80"
      - "25:25"
    environment:
      - ServerOptions__HostName=smtp4dev
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasService "observability.metrics" "prometheus"}}
  prometheus:
    container_name: prometheus
    image: prom/prometheus:main
    ports:
      - "9090:9090"
    volumes:
      - ./config/prometheus/config.yml:/etc/prometheus/config.yml:ro
      - prometheus-data:/prometheus
    command:
      - '--config.file=/etc/prometheus/config.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--web.console.libraries=/usr/share/prometheus/console_libraries'
      - '--web.console.templates=/usr/share/prometheus/consoles'
    healthcheck:
      test: ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:9090/-/healthy || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasService "observability.logging.stack" "loki"}}
  loki:
    container_name: loki
    image: grafana/loki:main
    ports:
      - "3100:3100"
    volumes:
      - loki-data:/loki
    command: -config.file=/etc/loki/local-config.yaml
    healthcheck:
      test: ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:3100/ready || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - {{dotenv.PROJECT_NAME}}-network

  promtail:
    container_name: promtail
    image: grafana/promtail:main
    command: -config.file=/etc/promtail/config.yml
    volumes:
      - ./config/promtail/config.yml:/etc/promtail/config.yml
      - eureka-server-log:/var/log/eureka-server
      - identity-service-log:/var/log/identity-service
      - catalog-service-log:/var/log/catalog-service
      - inventory-service-log:/var/log/inventory-service
      - order-service-log:/var/log/order-service
      - payment-service-log:/var/log/payment-service
      - api-gateway-log:/var/log/api-gateway
    depends_on:
      - loki
    healthcheck:
      test: [ "CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:9080/metrics || exit 1" ]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasService "observability.tracing" "zipkin"}}
  zipkin:
    container_name: zipkin
    image: openzipkin/zipkin:latest
    ports:
      - "9411:9411"
    environment:
      - STORAGE_TYPE=mem
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasGrafana}}
  grafana:
    container_name: grafana
    image: grafana/grafana-oss:main
    ports:
      - "3000:3000"
    environment:
      - GF_SECURITY_ADMIN_USER=${GRAFANA_ADMIN_USER:-atlas}
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD:-Atlas@123456}
      - GF_PLUGIN_CATALOG_SKIP_TLS_VERIFY=true
    volumes:
      - grafana-data:/var/lib/grafana
      - ./config/grafana/provisioning:/etc/grafana/provisioning:ro
      - ./config/grafana/dashboards:/etc/grafana/dashboards:ro
    healthcheck:
      test: ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 60s
    depends_on:
      {{#hasService "observability.metrics" "prometheus"}}
      - prometheus
      {{/hasService}}
      {{#hasService "observability.logging.stack" "loki"}}
      - loki
      {{/hasService}}
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasGrafana}}

{{#hasService "reverse-proxy" "nginx"}}
  nginx:
    container_name: nginx
    image: nginx:alpine
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./config/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./config/nginx/conf.d:/etc/nginx/conf.d:ro
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#unless infraOnly}}
  eureka-server:
    container_name: eureka-server
    image: {{dotenv.PROJECT_NAME}}/eureka-server:latest
    build:
      context: ../../platform/discovery-server/eureka-server
      dockerfile: Dockerfile
    ports:
      - "8761:8761"
    environment:
      - SPRING_PROFILES_ACTIVE=dev
    volumes:
      - eureka-server-log:/var/log/eureka-server
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8761/actuator/health/readiness"]
      interval: 10s
      timeout: 10s
      retries: 15
      start_period: 180s
    networks:
      - {{dotenv.PROJECT_NAME}}-network

  identity-service:
    container_name: identity-service
    image: {{dotenv.PROJECT_NAME}}/identity-service:latest
    build:
      context: ../../services/identity-service/identity-bootstrap
      dockerfile: Dockerfile
    ports:
      - "8081:8081"
    environment:
      - SPRING_PROFILES_ACTIVE=dev
      {{#hasService "datasource" "mysql"}}
      - SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/db_identity?createDatabaseIfNotExist=true
      - SPRING_DATASOURCE_USERNAME=${MYSQL_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "datasource" "postgres"}}
      - SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/db_identity
      - SPRING_DATASOURCE_USERNAME=${POSTGRES_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "kv-store" "redis"}}
      - SPRING_DATA_REDIS_HOST=redis
      - SPRING_DATA_REDIS_PORT=6379
      {{/hasService}}
      {{#hasService "messaging" "kafka"}}
      - SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
      {{/hasService}}
      {{#hasService "messaging" "rabbitmq"}}
      - SPRING_RABBITMQ_HOST=rabbitmq
      - SPRING_RABBITMQ_PORT=5672
      - SPRING_RABBITMQ_USERNAME=${RABBITMQ_USER:-atlas}
      - SPRING_RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "observability.tracing" "zipkin"}}
      - MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://zipkin:9411/api/v2/spans
      {{/hasService}}
      - EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka
      {{#hasService "identity" "keycloak"}}
      - KEYCLOAK_BASE_URL=http://keycloak:8080
      - KC_BOOTSTRAP_ADMIN_USERNAME=${KC_BOOTSTRAP_ADMIN_USERNAME:-atlas}
      - KC_BOOTSTRAP_ADMIN_PASSWORD=${KC_BOOTSTRAP_ADMIN_PASSWORD:-Atlas@123456}
      # Refer config/keycloak/realm.json file
      - KEYCLOAK_REALM=${KEYCLOAK_REALM:-dev}
      - KEYCLOAK_CLIENT_ID=${KEYCLOAK_CLIENT_ID:-default-auth}
      - KEYCLOAK_CLIENT_SECRET=${KEYCLOAK_CLIENT_SECRET:-9cvF5MPJnwfhEOCwNnQ79RmlkckAsDCj}
      {{/hasService}}
    volumes:
      - identity-service-log:/var/log/identity-service
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8081/actuator/health/readiness"]
      interval: 10s
      timeout: 10s
      retries: 15
      start_period: 180s
    depends_on:
      eureka-server:
        condition: service_healthy
      {{#hasService "datasource" "mysql"}}
      mysql:
        condition: service_healthy
      {{/hasService}}
      {{#hasService "datasource" "postgres"}}
      postgres:
        condition: service_healthy
      {{/hasService}}
      {{#hasService "identity" "keycloak"}}
      keycloak:
        condition: service_healthy
      {{/hasService}}
    networks:
      - {{dotenv.PROJECT_NAME}}-network

  catalog-service:
    container_name: catalog-service
    image: {{dotenv.PROJECT_NAME}}/catalog-service:latest
    build:
      context: ../../services/catalog-service/catalog-bootstrap
      dockerfile: Dockerfile
    ports:
      - "8082:8082"
    environment:
      - SPRING_PROFILES_ACTIVE=dev
      {{#hasService "datasource" "mysql"}}
      - SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/db_catalog?createDatabaseIfNotExist=true
      - SPRING_DATASOURCE_USERNAME=${MYSQL_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "datasource" "postgres"}}
      - SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/db_catalog
      - SPRING_DATASOURCE_USERNAME=${POSTGRES_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "kv-store" "redis"}}
      - SPRING_DATA_REDIS_HOST=redis
      - SPRING_DATA_REDIS_PORT=6379
      {{/hasService}}
      {{#hasService "messaging" "kafka"}}
      - SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
      {{/hasService}}
      {{#hasService "messaging" "rabbitmq"}}
      - SPRING_RABBITMQ_HOST=rabbitmq
      - SPRING_RABBITMQ_PORT=5672
      - SPRING_RABBITMQ_USERNAME=${RABBITMQ_USER:-atlas}
      - SPRING_RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "full-text-search" "elasticsearch"}}
      - ELASTICSEARCH_HOST=elasticsearch
      - ELASTICSEARCH_PORT=9200
      - ELASTICSEARCH_USERNAME=elastic
      - ELASTICSEARCH_PASSWORD=${ELASTICSEARCH_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "storage" "minio"}}
      - MINIO_ENDPOINT=http://minio:9000
      - MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY:-minioadmin}
      - MINIO_SECRET_KEY=${MINIO_SECRET_KEY:-Atlas@123456}
      {{/hasService}}
      {{#hasService "observability.tracing" "zipkin"}}
      - MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://zipkin:9411/api/v2/spans
      {{/hasService}}
      - EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka
    volumes:
      - catalog-service-log:/var/log/catalog-service
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8082/actuator/health/readiness"]
      interval: 10s
      timeout: 10s
      retries: 15
      start_period: 180s
    depends_on:
      eureka-server:
        condition: service_healthy
      {{#hasService "datasource" "mysql"}}
      mysql:
        condition: service_healthy
      {{/hasService}}
      {{#hasService "datasource" "postgres"}}
      postgres:
        condition: service_healthy
      {{/hasService}}
      {{#hasService "full-text-search" "elasticsearch"}}
      elasticsearch:
        condition: service_healthy
      {{/hasService}}
    networks:
      - {{dotenv.PROJECT_NAME}}-network

  inventory-service:
    container_name: inventory-service
    image: {{dotenv.PROJECT_NAME}}/inventory-service:latest
    build:
      context: ../../services/inventory-service/inventory-bootstrap
      dockerfile: Dockerfile
    ports:
      - "8083:8083"
    environment:
      - SPRING_PROFILES_ACTIVE=dev
      {{#hasService "datasource" "mysql"}}
      - SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/db_inventory?createDatabaseIfNotExist=true
      - SPRING_DATASOURCE_USERNAME=${MYSQL_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "datasource" "postgres"}}
      - SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/db_inventory
      - SPRING_DATASOURCE_USERNAME=${POSTGRES_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "kv-store" "redis"}}
      - SPRING_DATA_REDIS_HOST=redis
      - SPRING_DATA_REDIS_PORT=6379
      {{/hasService}}
      {{#hasService "messaging" "kafka"}}
      - SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
      {{/hasService}}
      {{#hasService "messaging" "rabbitmq"}}
      - SPRING_RABBITMQ_HOST=rabbitmq
      - SPRING_RABBITMQ_PORT=5672
      - SPRING_RABBITMQ_USERNAME=${RABBITMQ_USER:-atlas}
      - SPRING_RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "observability.tracing" "zipkin"}}
      - MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://zipkin:9411/api/v2/spans
      {{/hasService}}
      - EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka
    volumes:
      - inventory-service-log:/var/log/inventory-service
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8083/actuator/health/readiness"]
      interval: 10s
      timeout: 10s
      retries: 15
      start_period: 180s
    depends_on:
      eureka-server:
        condition: service_healthy
      {{#hasService "datasource" "mysql"}}
      mysql:
        condition: service_healthy
      {{/hasService}}
      {{#hasService "datasource" "postgres"}}
      postgres:
        condition: service_healthy
      {{/hasService}}
    networks:
      - {{dotenv.PROJECT_NAME}}-network

  order-service:
    container_name: order-service
    image: {{dotenv.PROJECT_NAME}}/order-service:latest
    build:
      context: ../../services/order-service/order-bootstrap
      dockerfile: Dockerfile
    ports:
      - "8084:8084"
    environment:
      - SPRING_PROFILES_ACTIVE=dev
      {{#hasService "datasource" "mysql"}}
      - SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/db_order?createDatabaseIfNotExist=true
      - SPRING_DATASOURCE_USERNAME=${MYSQL_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "datasource" "postgres"}}
      - SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/db_order
      - SPRING_DATASOURCE_USERNAME=${POSTGRES_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "kv-store" "redis"}}
      - SPRING_DATA_REDIS_HOST=redis
      - SPRING_DATA_REDIS_PORT=6379
      {{/hasService}}
      {{#hasService "messaging" "kafka"}}
      - SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
      {{/hasService}}
      {{#hasService "messaging" "rabbitmq"}}
      - SPRING_RABBITMQ_HOST=rabbitmq
      - SPRING_RABBITMQ_PORT=5672
      - SPRING_RABBITMQ_USERNAME=${RABBITMQ_USER:-atlas}
      - SPRING_RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "observability.tracing" "zipkin"}}
      - MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://zipkin:9411/api/v2/spans
      {{/hasService}}
      - EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka
      {{#hasService "internal" "grpc"}}
      - API_CLIENT_GRPC_IDENTITY_SERVICE_ADDRESS=static://identity-service:50051
      - API_CLIENT_GRPC_CATALOG_SERVICE_ADDRESS=static://catalog-service:50052
      {{/hasService}}
      {{#hasService "internal" "rest"}}
      - API_CLIENT_REST_IDENTITY_SERVICE_BASE_URL=http://identity-service:8081
      - API_CLIENT_REST_CATALOG_SERVICE_BASE_URL=http://catalog-service:8082
      {{/hasService}}
    volumes:
      - order-service-log:/var/log/order-service
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8084/actuator/health/readiness"]
      interval: 10s
      timeout: 10s
      retries: 15
      start_period: 180s
    depends_on:
      eureka-server:
        condition: service_healthy
      {{#hasService "datasource" "mysql"}}
      mysql:
        condition: service_healthy
      {{/hasService}}
      {{#hasService "datasource" "postgres"}}
      postgres:
        condition: service_healthy
      {{/hasService}}
    networks:
      - {{dotenv.PROJECT_NAME}}-network

  payment-service:
    container_name: payment-service
    image: {{dotenv.PROJECT_NAME}}/payment-service:latest
    build:
      context: ../../services/payment-service/payment-bootstrap
      dockerfile: Dockerfile
    ports:
      - "8085:8085"
    environment:
      - SPRING_PROFILES_ACTIVE=dev
      {{#hasService "datasource" "mysql"}}
      - SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/db_payment?createDatabaseIfNotExist=true
      - SPRING_DATASOURCE_USERNAME=${MYSQL_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "datasource" "postgres"}}
      - SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/db_payment
      - SPRING_DATASOURCE_USERNAME=${POSTGRES_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "kv-store" "redis"}}
      - SPRING_DATA_REDIS_HOST=redis
      - SPRING_DATA_REDIS_PORT=6379
      {{/hasService}}
      {{#hasService "messaging" "kafka"}}
      - SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
      {{/hasService}}
      {{#hasService "messaging" "rabbitmq"}}
      - SPRING_RABBITMQ_HOST=rabbitmq
      - SPRING_RABBITMQ_PORT=5672
      - SPRING_RABBITMQ_USERNAME=${RABBITMQ_USER:-atlas}
      - SPRING_RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "observability.tracing" "zipkin"}}
      - MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://zipkin:9411/api/v2/spans
      {{/hasService}}
      - EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka
      - PAYMENT_SIMULATOR_WEBHOOK_URL=http://api-gateway:8080/services/payment/api/webhook/simulator
    volumes:
      - payment-service-log:/var/log/payment-service
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8085/actuator/health/readiness"]
      interval: 10s
      timeout: 10s
      retries: 15
      start_period: 180s
    depends_on:
      eureka-server:
        condition: service_healthy
      {{#hasService "datasource" "mysql"}}
      mysql:
        condition: service_healthy
      {{/hasService}}
      {{#hasService "datasource" "postgres"}}
      postgres:
        condition: service_healthy
      {{/hasService}}
    networks:
      - {{dotenv.PROJECT_NAME}}-network

  api-gateway:
    container_name: api-gateway
    image: {{dotenv.PROJECT_NAME}}/api-gateway:latest
    build:
      context: ../../services/api-gateway/spring-cloud-gateway/spring-cloud-gateway-server
      dockerfile: Dockerfile
    ports:
      - "8080:8080"
    environment:
      - SPRING_PROFILES_ACTIVE=dev
      {{#hasService "kv-store" "redis"}}
      - SPRING_DATA_REDIS_HOST=redis
      - SPRING_DATA_REDIS_PORT=6379
      {{/hasService}}
      {{#hasService "observability.tracing" "zipkin"}}
      - MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://zipkin:9411/api/v2/spans
      {{/hasService}}
      - EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka
      {{#hasService "identity" "jwt"}}
      - IDENTITY_SERVICE_URI=http://identity-service:8081
      {{/hasService}}
      {{#hasService "identity" "keycloak"}}
      - KEYCLOAK_BASE_URL=http://keycloak:8080
      - KEYCLOAK_REALM=${KEYCLOAK_REALM:-dev}
      {{/hasService}}
    volumes:
      - api-gateway-log:/var/log/api-gateway
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/actuator/health/readiness"]
      interval: 10s
      timeout: 10s
      retries: 15
      start_period: 180s
    depends_on:
      eureka-server:
        condition: service_healthy
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/unless}}

networks:
  {{dotenv.PROJECT_NAME}}-network:
    driver: bridge

volumes:
{{#hasService "datasource" "mysql"}}
  mysql-data:
{{/hasService}}
{{#hasService "datasource" "postgres"}}
  postgres-data:
{{/hasService}}
{{#hasService "kv-store" "redis"}}
  redis-data:
{{/hasService}}
{{#hasService "messaging" "kafka"}}
  kafka-data:
{{/hasService}}
{{#hasService "messaging" "rabbitmq"}}
  rabbitmq-data:
{{/hasService}}
{{#hasService "full-text-search" "elasticsearch"}}
  elasticsearch-data:
{{/hasService}}
{{#hasService "storage" "minio"}}
  minio-data:
{{/hasService}}
{{#hasService "observability.metrics" "prometheus"}}
  prometheus-data:
{{/hasService}}
{{#hasService "observability.logging.stack" "loki"}}
  loki-data:
  promtail-data:
{{/hasService}}
{{#hasGrafana}}
