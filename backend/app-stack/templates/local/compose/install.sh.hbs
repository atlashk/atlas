#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# CONFIGURATION
# =============================================================================

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
readonly COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yml"
readonly PROJECT_NAME="{{dotenv.PROJECT_NAME}}"

SECONDS=0
SKIP_BUILD=false
DOCKER_COMPOSE_CMD=""

# =============================================================================
# UTILITIES
# =============================================================================

die() { echo "Error: $1" >&2; exit 1; }
info() { echo "$1"; }

# =============================================================================
# USAGE
# =============================================================================

show_usage() {
  cat <<EOF
Usage: $0 [OPTIONS]

Deploy services using Docker Compose

Options:
  --skip-build      Skip service build step
  -h, --help        Show this help message
EOF
}

parse_arguments() {
  while [[ $# -gt 0 ]]; do
    case $1 in
      --skip-build) SKIP_BUILD=true; shift ;;
      -h|--help)    show_usage; exit 0 ;;
      *)            shift ;;
    esac
  done
}

# =============================================================================
# PREREQUISITES
# =============================================================================

check_java() {
  command -v java &>/dev/null || die "Java is not installed or not in PATH"

  local version
  version=$(java -version 2>&1 | head -n 1)

  local major
  if [[ "$version" =~ \"1\.([0-9]+) ]]; then
    major="${BASH_REMATCH[1]}"
  elif [[ "$version" =~ \"([0-9]+) ]]; then
    major="${BASH_REMATCH[1]}"
  else
    major=0
  fi

  [[ $major -ge 17 ]] || die "Java 17 or later is required (found: $version)"
  info "Java found: $version"
}

check_docker() {
  docker info &>/dev/null || die "Docker is not running"
  info "Docker found and running"
}

check_docker_compose() {
  if command -v docker-compose &>/dev/null; then
    DOCKER_COMPOSE_CMD="docker-compose"
    info "Docker Compose (standalone) found"
  elif docker compose version &>/dev/null; then
    DOCKER_COMPOSE_CMD="docker compose"
    info "Docker Compose (plugin) found"
  else
    die "Docker Compose is not installed. Please install Docker Compose or ensure Docker Desktop is running"
  fi
}

check_prerequisites() {
  info "Checking prerequisites..."
  check_java
  check_docker
  check_docker_compose
  info "Prerequisites check passed"
}

# =============================================================================
# BUILD
# =============================================================================

build_services() {
  info "Building services..."

  local build_script="$SCRIPT_DIR/build.sh"
  [[ -f "$build_script" ]] || die "Build script not found: $build_script"

  chmod +x "$SCRIPT_DIR/"*.sh
  "$build_script" || die "Build failed"

  info "Build completed successfully"
  echo
}

# =============================================================================
# DEPLOYMENT
# =============================================================================

deploy_services() {
  info "Deploying services using compose file: $COMPOSE_FILE"

  $DOCKER_COMPOSE_CMD -f "$COMPOSE_FILE" -p "$PROJECT_NAME" up -d || {
    die "Failed to start compose stack. Check logs with: $DOCKER_COMPOSE_CMD -f $COMPOSE_FILE -p $PROJECT_NAME logs"
  }

  info "Compose stack started"
  echo
}

# =============================================================================
# RUNTIME
# =============================================================================

print_total_time() {
  printf "Total runtime: %02d:%02d:%02d\n" $((SECONDS/3600)) $(((SECONDS%3600)/60)) $((SECONDS%60))
}
trap print_total_time EXIT

# =============================================================================
# MAIN
# =============================================================================

main() {
  parse_arguments "$@"

  check_prerequisites

  info "Installing services for project: $PROJECT_NAME, app stack: $APP_STACK"

  if [[ "$SKIP_BUILD" == true ]]; then
    info "Skipping build step"
  else
    build_services
  fi

  deploy_services
}

main "$@"
