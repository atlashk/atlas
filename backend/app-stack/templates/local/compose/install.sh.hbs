#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# CONFIGURATION
# =============================================================================

readonly PROJECT_NAME="{{dotenv.PROJECT_NAME}}"
readonly APP_STACK="{{appStack}}"
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
readonly COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yml"
readonly GRADLEW="$PROJECT_ROOT/backend/gradlew"

readonly SERVICES=(
  "identity-service:$PROJECT_ROOT/backend/services/identity-service/identity-bootstrap"
  "catalog-service:$PROJECT_ROOT/backend/services/catalog-service/catalog-bootstrap"
  "inventory-service:$PROJECT_ROOT/backend/services/inventory-service/inventory-bootstrap"
  "order-service:$PROJECT_ROOT/backend/services/order-service/order-bootstrap"
  "payment-service:$PROJECT_ROOT/backend/services/payment-service/payment-bootstrap"
  "api-gateway:$PROJECT_ROOT/backend/services/api-gateway/spring-cloud-gateway/spring-cloud-gateway-server"
{{#hasService "service-discovery" "eureka"}}
  "eureka-server:$PROJECT_ROOT/backend/platform/discovery-server/eureka-server"
{{/hasService}}
)

SECONDS=0
SKIP_BUILD=false
DOCKER_COMPOSE_CMD=""

SKIP_TESTS=true
BUILD_JAR=true
BUILD_DOCKER=true

# =============================================================================
# UTILITIES
# =============================================================================

info()  { printf "%b\n" "[INFO] $1"; }
warn()  { printf "%b\n" "[WARN] $1"; }
error() { printf "%b\n" "[ERROR] $1" >&2; exit 1; }

# =============================================================================
# USAGE
# =============================================================================

show_usage() {
  cat <<EOF
Usage: $0 [OPTIONS]

Deploy services using Docker Compose

Options:
  --skip-build            Skip all build steps
  --skip-tests=BOOL       Skip tests during JAR build (default: true)
  --build-jar=BOOL        Build JAR files (default: true)
  --build-docker=BOOL     Build Docker images (default: true)
  -h, --help              Show this help message
EOF
}

parse_args() {
  for arg in "$@"; do
    case $arg in
      --skip-build)      SKIP_BUILD=true ;;
      --skip-tests=*)    SKIP_TESTS="${arg#*=}" ;;
      --build-jar=*)     BUILD_JAR="${arg#*=}" ;;
      --build-docker=*)  BUILD_DOCKER="${arg#*=}" ;;
      -h|--help)         show_usage; exit 0 ;;
      *)                 error "Unknown parameter: $arg" ;;
    esac
  done
}

# =============================================================================
# PREREQUISITES
# =============================================================================

check_java() {
  command -v java &>/dev/null || error "Java is not installed or not in PATH"

  local version
  version=$(java -version 2>&1 | head -n 1)

  local major
  if [[ "$version" =~ \"1\.([0-9]+) ]]; then
    major="${BASH_REMATCH[1]}"
  elif [[ "$version" =~ \"([0-9]+) ]]; then
    major="${BASH_REMATCH[1]}"
  else
    major=0
  fi

  [[ $major -ge 17 ]] || error "Java 17 or later is required (found: $version)"
  info "Java found: $version"
}

check_docker() {
  docker info &>/dev/null || error "Docker is not running"
  info "Docker found and running"
}

check_docker_compose() {
  if command -v docker-compose &>/dev/null; then
    DOCKER_COMPOSE_CMD="docker-compose"
    info "Docker Compose (standalone) found"
  elif docker compose version &>/dev/null; then
    DOCKER_COMPOSE_CMD="docker compose"
    info "Docker Compose (plugin) found"
  else
    error "Docker Compose is not installed. Please install Docker Compose or ensure Docker Desktop is running"
  fi
}

check_prerequisites() {
  info "Checking prerequisites..."
  if [[ "$SKIP_BUILD" == false && "$BUILD_JAR" == "true" ]]; then
    check_java
  fi
  check_docker
  check_docker_compose
  info "Prerequisites check passed"
}

# =============================================================================
# BUILD
# =============================================================================

build_jars() {
  [[ "$BUILD_JAR" == "true" ]] || return 0

  info "Starting JAR build process..."
  chmod +x "$GRADLEW"

  local gradle_args=("clean" "build")
  [[ "$SKIP_TESTS" == "true" ]] && gradle_args+=("-x" "test")
  [[ -n "$APP_STACK" ]] && gradle_args+=("-PappStack=$APP_STACK")

  (cd "$PROJECT_ROOT/backend" && "$GRADLEW" "${gradle_args[@]}") || error "Gradle build failed"

  info "JAR build completed successfully."
  echo
}

cleanup_dangling_images() {
  info "Cleaning up dangling images..."

  local dangling
  dangling=$(docker images -f "dangling=true" -q 2>/dev/null || true)

  if [[ -n "$dangling" ]]; then
    docker rmi $dangling 2>/dev/null || info "Some dangling images could not be removed (possibly in use)"
  else
    info "No dangling images to clean up."
  fi
}

build_docker_images() {
  [[ "$BUILD_DOCKER" == "true" ]] || return 0

  info "Starting Docker build process..."
  [[ ${#SERVICES[@]} -eq 0 ]] && error "No services specified to build"

  for entry in "${SERVICES[@]}"; do
    local name="${entry%%:*}"
    local context="${entry#*:}"
    local image="$PROJECT_NAME/$name"

    info "Building Docker image for $image..."
    docker build -t "$image:latest" -t "$image" "$context" || error "Failed to build Docker image for $image"
    info "Built Docker image for $image successfully."
  done

  info "Docker images build process completed successfully."
  cleanup_dangling_images
  echo
}

# =============================================================================
# DEPLOYMENT
# =============================================================================

deploy_services() {
  info "Deploying services using compose file: $COMPOSE_FILE"

  $DOCKER_COMPOSE_CMD -f "$COMPOSE_FILE" -p "$PROJECT_NAME" up -d || {
    error "Failed to start compose stack. Check logs with: $DOCKER_COMPOSE_CMD -f $COMPOSE_FILE -p $PROJECT_NAME logs"
  }

  info "Compose stack started"
  echo
}

# =============================================================================
# RUNTIME
# =============================================================================

print_total_time() {
  printf "Total runtime: %02d:%02d:%02d\n" $((SECONDS/3600)) $(((SECONDS%3600)/60)) $((SECONDS%60))
}
trap print_total_time EXIT

# =============================================================================
# MAIN
# =============================================================================

main() {
  parse_args "$@"
  check_prerequisites

  # Build services
  if [[ "$SKIP_BUILD" == true ]]; then
    info "Skipping build step"
  else
    build_jars
    build_docker_images
  fi

  # Deploy services
  deploy_services
}

main "$@"
