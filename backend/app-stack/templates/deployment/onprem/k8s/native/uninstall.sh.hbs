#!/usr/bin/env bash

# Ensures that the script exits immediately if any command fails, or if you try to use an undefined variable.
set -euo pipefail

# =============================================================================
# Atlas On-Premises Kubernetes Clean Script (Template, Simplified)
# =============================================================================
# Removes Atlas namespace resources and the NGINX Ingress Controller (if used)
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NAMESPACE="atlas"

check_prerequisites() {
  echo "Checking prerequisites..."
  if ! command -v kubectl >/dev/null 2>&1; then
    echo "kubectl is not installed" >&2; exit 1
  fi
  if ! kubectl cluster-info >/dev/null 2>&1; then
    echo "Cannot connect to Kubernetes cluster" >&2; exit 1
  fi
  echo "Prerequisites check passed"
}

remove_namespace() {
  echo "Deleting namespace '$NAMESPACE' (this will remove all resources within)..."
  kubectl delete namespace "$NAMESPACE" --ignore-not-found=true
  echo "Waiting for namespace deletion..."
  local timeout=120
  while kubectl get namespace "$NAMESPACE" >/dev/null 2>&1 && [[ $timeout -gt 0 ]]; do
    sleep 2; ((timeout-=2))
  done
  if kubectl get namespace "$NAMESPACE" >/dev/null 2>&1; then
    echo "Namespace deletion is taking longer than expected"
  else
    echo "Namespace '$NAMESPACE' deleted"
  fi
}

remove_atlas_images() {
    echo "Removing Atlas application images..."
    # Remove all images with atlas/* pattern
    local images=$(docker images --format "\{{.Repository}}:\{{.Tag}}" | grep "^atlas/" || true)
    if [ -n "$images" ]; then
        echo "$images" | xargs docker rmi -f 2>/dev/null || true
        echo "Atlas images removed"
    else
        echo "No Atlas images found to remove"
    fi
}

main() {
  echo "Atlas On-Premise Kubernetes Platform - Cleaning up..."
  check_prerequisites
  echo "Namespace: $NAMESPACE"
  remove_namespace
  remove_atlas_images
  echo "Atlas platform resources cleanup completed successfully!"
}

main "$@"
