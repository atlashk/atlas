{{#hasService "mysql"}}
apiVersion: v1
kind: Secret
metadata:
  name: mysql-secret
  labels:
    app: mysql
    tier: infrastructure
type: Opaque
data:
  mysql-root-password: c2VjcmV0MTIzNDU2
  mysql-password: c2VjcmV0MTIzNDU2
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: mysql-init
  labels:
    app: mysql
    tier: infrastructure
data:
  initdb.sh: |
    #!/bin/bash
    set -e
    cat <<EOF | mysql -uroot -p"${MYSQL_ROOT_PASSWORD}"
    {{#hasService "jwt"}}
    CREATE DATABASE db_iam;
    {{/hasService}}
    CREATE DATABASE db_iam;
    CREATE DATABASE db_notification;
    CREATE DATABASE db_order;
    CREATE DATABASE db_payment;
    CREATE DATABASE db_product;

    {{#hasService "jwt"}}
    GRANT ALL PRIVILEGES ON db_iam.* TO '${MYSQL_USER}'@'%';
    {{/hasService}}
    GRANT ALL PRIVILEGES ON db_iam.* TO '${MYSQL_USER}'@'%';
    GRANT ALL PRIVILEGES ON db_notification.* TO '${MYSQL_USER}'@'%';
    GRANT ALL PRIVILEGES ON db_order.* TO '${MYSQL_USER}'@'%';
    GRANT ALL PRIVILEGES ON db_payment.* TO '${MYSQL_USER}'@'%';
    GRANT ALL PRIVILEGES ON db_product.* TO '${MYSQL_USER}'@'%';
    FLUSH PRIVILEGES;
    EOF
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: mysql
  labels:
    app: mysql
    tier: infrastructure
spec:
  replicas: 1
  serviceName: mysql
  selector:
    matchLabels:
      app: mysql
  template:
    metadata:
      labels:
        app: mysql
        tier: infrastructure
    spec:
      containers:
        - name: mysql
          image: mysql:8.0
          imagePullPolicy: IfNotPresent
          env:
            - name: MYSQL_ROOT_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: mysql-secret
                  key: mysql-root-password
            - name: MYSQL_USER
              value: "atlas"
            - name: MYSQL_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: mysql-secret
                  key: mysql-password
          args:
            - --default-authentication-plugin=mysql_native_password
            - --character-set-server=utf8mb4
            - --collation-server=utf8mb4_unicode_ci
            - --innodb-buffer-pool-size=256M
            - --max-connections=200
          ports:
            - containerPort: 3306
              name: mysql
          volumeMounts:
            - name: mysql-data
              mountPath: /var/lib/mysql
            - name: mysql-init
              mountPath: /docker-entrypoint-initdb.d
              readOnly: true
          livenessProbe:
            exec:
              command:
                - /bin/sh
                - -c
                - 'mysqladmin ping -h 127.0.0.1 -P 3306 -u root -p"$MYSQL_ROOT_PASSWORD"'
            initialDelaySeconds: 30
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 3
          readinessProbe:
            exec:
              command:
                - /bin/sh
                - -c
                - 'mysqladmin ping -h 127.0.0.1 -P 3306 -u root -p"$MYSQL_ROOT_PASSWORD"'
            initialDelaySeconds: 5
            periodSeconds: 5
            timeoutSeconds: 2
            successThreshold: 1
            failureThreshold: 3
          resources:
            requests:
              cpu: "500m"
              memory: "512Mi"
            limits:
              cpu: "1000m"
              memory: "1Gi"
      volumes:
        - name: mysql-init
          configMap:
            name: mysql-init
            defaultMode: 0755
  volumeClaimTemplates:
    - metadata:
        name: mysql-data
        labels:
          app: mysql
          tier: infrastructure
      spec:
        accessModes:
          - ReadWriteOnce
        resources:
          requests:
            storage: 5Gi
---
apiVersion: v1
kind: Service
metadata:
  name: mysql
  labels:
    app: mysql
    tier: infrastructure
spec:
  clusterIP: None
  selector:
    app: mysql
  ports:
    - port: 3306
      targetPort: 3306
      name: mysql
  type: ClusterIP
{{/hasService}}
