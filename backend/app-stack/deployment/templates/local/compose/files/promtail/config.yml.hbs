server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /var/lib/promtail/positions.yaml

clients:
  - url: http://loki:3100/loki/api/v1/push

scrape_configs:
  {{#hasService "service-discovery" "eureka" }}
  - job_name: eureka-server
    static_configs:
      - targets:
          - localhost
        labels:
          service_name: eureka-server
          __path__: /var/log/eureka-server/*.log
  {{/hasService}}
  - job_name: user-service
    static_configs:
      - targets:
          - localhost
        labels:
          service_name: user-service
          __path__: /var/log/user-service/*.log
  - job_name: catalog-service
    static_configs:
      - targets:
          - localhost
        labels:
          service_name: catalog-service
          __path__: /var/log/catalog-service/*.log
  - job_name: inventory-service
    static_configs:
      - targets:
          - localhost
        labels:
          service_name: inventory-service
          __path__: /var/log/inventory-service/*.log
  - job_name: order-service
    static_configs:
      - targets:
          - localhost
        labels:
          service_name: order-service
          __path__: /var/log/order-service/*.log
  - job_name: payment-service
    static_configs:
      - targets:
          - localhost
        labels:
          service_name: payment-service
          __path__: /var/log/payment-service/*.log
  {{#hasService "idp" "spring" }}
  - job_name: authorization-server
    static_configs:
      - targets:
          - localhost
        labels:
          service_name: authorization-server
          __path__: /var/log/authorization-server/*.log
  {{/hasService}}
  - job_name: api-gateway
    static_configs:
      - targets:
          - localhost
        labels:
          service_name: api-gateway
          __path__: /var/log/api-gateway/*.log
