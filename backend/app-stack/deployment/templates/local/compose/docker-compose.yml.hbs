    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:8085/actuator/health/readiness"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 180s
    depends_on:
      eureka-server:
        condition: service_healthy
      {{#hasService "datasource" "mysql"}}
      mysql:
        condition: service_healthy
      {{/hasService}}
      {{#hasService "datasource" "postgres"}}
      postgres:
        condition: service_healthy
      {{/hasService}}
    networks:
      - {{dotenv.PROJECT_NAME}}-network

  eureka-server:
    container_name: eureka-server
    image: {{dotenv.PROJECT_NAME}}/eureka-server:latest
    build:
      context: ../../platform/discovery-server/eureka-server
      dockerfile: Dockerfile
    ports:
      - "8761:8761"
    environment:
      - SPRING_PROFILES_ACTIVE=dev
    volumes:
      - eureka-server-log:/var/log/eureka-server
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:8761/actuator/health/liveness"]
