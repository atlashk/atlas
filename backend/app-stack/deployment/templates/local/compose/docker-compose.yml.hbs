      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 180s
    depends_on:
      eureka-server:
        condition: service_healthy
      {{#hasService "datasource" "mysql"}}
      mysql:
        condition: service_healthy
      {{/hasService}}
      {{#hasService "datasource" "postgres"}}
      postgres:
        condition: service_healthy
      {{/hasService}}
    networks:
      - {{dotenv.PROJECT_NAME}}-network
  {{/hasService}}

  api-gateway:
    container_name: api-gateway
    image: {{dotenv.PROJECT_NAME}}/api-gateway:latest
    build:
      context: ../../services/api-gateway/api-gateway-reactive
      dockerfile: Dockerfile
    ports:
      - "8080:8080"
    environment:
      - SPRING_PROFILES_ACTIVE=dev
      - EUREKA_CLIENT_SERVICE_URL_DEFAULT_ZONE=http://eureka-server:8761/eureka/
      {{#hasService "kv-store" "redis"}}
      - SPRING_DATA_REDIS_HOST=redis
      - SPRING_DATA_REDIS_PORT=6379
      {{/hasService}}
      {{#hasService "observability.tracing" "zipkin"}}
      - MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://zipkin:9411/api/v2/spans
      {{/hasService}}
      {{#hasService "observability.tracing" "tempo"}}
      - OTEL_COLLECTOR_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
      {{/hasService}}
      {{#hasService "idp" "spring"}}
      - JWK_SET_URI=http://authorization-server:8901/.well-known/jwks.json
      {{/hasService}}
    volumes:
      - api-gateway-log:/var/log/api-gateway
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:8080/actuator/health/readiness"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 180s
    depends_on:
      eureka-server:
        condition: service_healthy
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/unless}}

