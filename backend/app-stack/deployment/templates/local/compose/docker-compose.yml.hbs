services:

{{#hasService "datasource" "mysql"}}
  mysql:
    container_name: mysql
    image: mysql:8.0.33
    ports:
      - "3306:3306"
    environment:
      - MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD:-Atlas@123456}
      - MYSQL_USER=${MYSQL_USER:-atlas}
      - MYSQL_PASSWORD=${MYSQL_PASSWORD:-Atlas@123456}
    volumes:
      - ./files/mysql/initdb.sh:/docker-entrypoint-initdb.d/initdb.sh
      - mysql-data:/var/lib/mysql
    command:
      - --default-authentication-plugin=mysql_native_password
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci
      - --innodb-buffer-pool-size=256M
      - --max-connections=200
    healthcheck:
      test: ["CMD-SHELL", "MYSQL_PWD=\"$MYSQL_ROOT_PASSWORD\" mysqladmin ping -h 127.0.0.1 -P 3306 -u root || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 60s
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasService "datasource" "postgres"}}
  postgres:
    container_name: postgres
    image: postgres:14
    ports:
      - "5432:5432"
    environment:
      - POSTGRES_USER=${POSTGRES_USER:-atlas}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-Atlas@123456}
    volumes:
      - ./files/postgres/initdb.sh:/docker-entrypoint-initdb.d/initdb.sh
      - postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U \"$POSTGRES_USER\" -h 127.0.0.1 -d postgres"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 60s
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasService "kv-store" "redis"}}
  redis:
    container_name: redis
    image: redis:7
    ports:
      - "6379:6379"
    volumes:
      - redis-data:/data
    command: redis-server --appendonly yes
    healthcheck:
      test: ["CMD-SHELL", "redis-cli ping | grep PONG"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasService "messaging" "kafka"}}
  kafka:
    container_name: kafka
    image: confluentinc/cp-kafka:7.9.0
    ports:
      - "9092:9092"
      - "9093:9093"
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: 'CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT'
      KAFKA_ADVERTISED_LISTENERS: 'PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092'
      KAFKA_PROCESS_ROLES: 'broker,controller'
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_CONTROLLER_QUORUM_VOTERS: '1@kafka:29093'
      KAFKA_LISTENERS: 'PLAINTEXT://kafka:29092,CONTROLLER://kafka:29093,PLAINTEXT_HOST://0.0.0.0:9092'
      KAFKA_INTER_BROKER_LISTENER_NAME: 'PLAINTEXT'
      KAFKA_CONTROLLER_LISTENER_NAMES: 'CONTROLLER'
      CLUSTER_ID: 'MkU3OEVBNTcwNTJENDM2Qk'
    volumes:
      - kafka-data:/var/lib/kafka/data
    healthcheck:
      test: ["CMD-SHELL", "kafka-broker-api-versions --bootstrap-server localhost:9092"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 60s
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasService "messaging" "rabbitmq"}}
  rabbitmq:
    container_name: rabbitmq
    image: rabbitmq:3-management-alpine
    ports:
      - "5672:5672"
      - "15672:15672"
    environment:
      - RABBITMQ_DEFAULT_USER=${RABBITMQ_USER:-atlas}
      - RABBITMQ_DEFAULT_PASS=${RABBITMQ_PASSWORD:-Atlas@123456}
    volumes:
      - rabbitmq-data:/var/lib/rabbitmq
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "-q", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 60s
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasService "idp" "keycloak"}}
  keycloak:
    container_name: keycloak
    image: quay.io/keycloak/keycloak:26.5.4
    ports:
      - "8443:8080"
    environment:
      - KC_BOOTSTRAP_ADMIN_USERNAME=${KC_BOOTSTRAP_ADMIN_USERNAME:-atlas}
      - KC_BOOTSTRAP_ADMIN_PASSWORD=${KC_BOOTSTRAP_ADMIN_PASSWORD:-Atlas@123456}
      - KC_HTTP_ENABLED=true
      - KC_HOSTNAME_STRICT=false
      - KC_PROXY_HEADERS=xforwarded
      - KC_HEALTH_ENABLED=true
      - KC_HTTP_MANAGEMENT_PORT=9000
      {{#hasService "datasource" "postgres"}}
      - KC_DB=postgres
      - KC_DB_URL=jdbc:postgresql://postgres:5432/db_keycloak
      - KC_DB_USERNAME=${POSTGRES_USER:-atlas}
      - KC_DB_PASSWORD=${POSTGRES_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "datasource" "mysql"}}
      - KC_DB=mysql
      - KC_DB_URL=jdbc:mysql://mysql:3306/db_keycloak
      - KC_DB_USERNAME=${MYSQL_USER:-atlas}
      - KC_DB_PASSWORD=${MYSQL_PASSWORD:-Atlas@123456}
      {{/hasService}}
    volumes:
      - ./files/keycloak/import:/opt/keycloak/data/import:ro
    command:
      - start-dev
      - --import-realm
    healthcheck:
      test:
        - "CMD-SHELL"
        - |
          exec 3<>/dev/tcp/127.0.0.1/9000 || exit 1;
          echo -e "GET /health/ready HTTP/1.0\r\nHost: localhost\r\n\r\n" >&3;
          if timeout 3 cat <&3 | grep -q "\"status\": \"UP\""; then
            exit 0
          else
            exit 1
          fi
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 300s
    depends_on:
      {{#hasService "datasource" "postgres"}}
      postgres:
        condition: service_healthy
      {{/hasService}}
      {{#hasService "datasource" "mysql"}}
      mysql:
        condition: service_healthy
      {{/hasService}}
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasService "search" "elasticsearch"}}
  elasticsearch:
    container_name: elasticsearch
    image: docker.elastic.co/elasticsearch/elasticsearch:9.2.5
    ports:
      - "9200:9200"
      - "9300:9300"
    environment:
      - discovery.type=single-node
      - xpack.security.enabled=false
      - "ES_JAVA_OPTS=-Xms512m -Xmx1g"
    volumes:
      - elasticsearch-data:/usr/share/elasticsearch/data
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS --max-time 5 -u elastic:${ELASTIC_PASSWORD} http://127.0.0.1:9200/_cluster/health?wait_for_status=yellow&timeout=1s > /dev/null || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 60s
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasService "storage" "minio"}}
  minio:
    container_name: minio
    image: minio/minio:latest
    ports:
      - "9000:9000"
      - "9001:9001"
    environment:
      - MINIO_ROOT_USER=${MINIO_ROOT_USER:-atlas}
      - MINIO_ROOT_PASSWORD=${MINIO_ROOT_PASSWORD:-Atlas@123456}
    volumes:
      - minio-data:/data
    command: server /data --console-address ":9001"
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:9000/minio/health/live"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasService "notification.email" "spring"}}
  smtp4dev:
    container_name: smtp4dev
    image: rnwood/smtp4dev:latest
    ports:
      - "5000:80"
      - "25:25"
    environment:
      - ServerOptions__HostName=smtp4dev
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:80/ || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasService "observability.metrics" "prometheus"}}
  prometheus:
    container_name: prometheus
    image: prom/prometheus:main
    ports:
      - "9090:9090"
    volumes:
      - ./files/prometheus/config.yml:/etc/prometheus/config.yml:ro
      - prometheus-data:/prometheus
    command:
      - '--config.file=/etc/prometheus/config.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--web.console.libraries=/usr/share/prometheus/console_libraries'
      - '--web.console.templates=/usr/share/prometheus/consoles'
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:9090/-/healthy"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasService "observability.logging.stack" "loki"}}
  loki:
    container_name: loki
    image: grafana/loki:main
    ports:
      - "3100:3100"
    volumes:
      - loki-data:/loki
    command: -config.file=/etc/loki/local-config.yaml
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:3100/ready"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - {{dotenv.PROJECT_NAME}}-network

  promtail:
    container_name: promtail
    image: grafana/promtail:main
    command: -config.file=/etc/promtail/config.yml
    volumes:
      - ./files/promtail/config.yml:/etc/promtail/config.yml
      {{#unless infraOnly}}
      - eureka-server-log:/var/log/eureka-server
      - authorization-server-log:/var/log/authorization-server
      - catalog-service-log:/var/log/catalog-service
      - inventory-service-log:/var/log/inventory-service
      - order-service-log:/var/log/order-service
      - payment-service-log:/var/log/payment-service
      - api-gateway-log:/var/log/api-gateway
      {{/unless}}
    depends_on:
      - loki
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:9080/ready"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasService "observability.tracing" "zipkin"}}
  zipkin:
    container_name: zipkin
    image: openzipkin/zipkin:latest
    ports:
      - "9411:9411"
    environment:
      - STORAGE_TYPE=mem
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:9411/health"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasService "observability.tracing" "tempo"}}
  tempo:
    container_name: tempo
    image: grafana/tempo:2.9.1
    ports:
      - "3200:3200"   # Tempo API
      - "4317:4317"   # OTLP gRPC
    command:
      - --config.file=/etc/tempo/config.yaml
    volumes:
      - ./files/tempo/tempo-config.yaml:/etc/tempo/config.yaml:ro
      - tempo-data:/var/tempo
    healthcheck:
      test: ["CMD", "/busybox/wget", "-q", "-O-", "http://127.0.0.1:3200/ready"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - {{dotenv.PROJECT_NAME}}-network

  otel-collector:
    container_name: otel-collector
    image: otel/opentelemetry-collector-contrib:latest
    ports:
      - "4318:4318"
    volumes:
      - ./files/otel-collector/otel-collector-config.yaml:/etc/otelcol-contrib/config.yaml:ro
    command:
      - --config=/etc/otelcol-contrib/config.yaml
    depends_on:
      tempo:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:13133/ || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#hasGrafana}}
  grafana:
    container_name: grafana
    image: grafana/grafana-oss:main
    ports:
      - "3000:3000"
    environment:
      - GF_SECURITY_ADMIN_USER=${GRAFANA_ADMIN_USER:-atlas}
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD:-Atlas@123456}
      - GF_PLUGIN_CATALOG_SKIP_TLS_VERIFY=true
    volumes:
      - grafana-data:/var/lib/grafana
      - ./files/grafana/provisioning:/etc/grafana/provisioning:ro
      - ./files/grafana/dashboards:/etc/grafana/dashboards:ro
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:3000/api/health"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 60s
    depends_on:
      {{#hasService "observability.logging.stack" "loki"}}
      - loki
      {{/hasService}}
      {{#hasService "observability.metrics" "prometheus"}}
      - prometheus
      {{/hasService}}
      {{#hasService "observability.tracing" "tempo"}}
      - tempo
      {{/hasService}}
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasGrafana}}

{{#hasService "ai.vectorstore.qdrant" "true"}}
  qdrant:
    container_name: qdrant
    image: qdrant/qdrant:v1.13.0
    ports:
      - "6333:6333" # HTTP port
      - "6334:6334" # gRPC port
    volumes:
      - qdrant-storage:/qdrant/storage
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:6333/healthz"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - {{dotenv.PROJECT_NAME}}-network
{{/hasService}}

{{#unless infraOnly}}
  user-service:
    container_name: user-service
    image: {{dotenv.PROJECT_NAME}}/user-service:latest
    build:
      context: ../../services/user-service/user-bootstrap
      dockerfile: Dockerfile
    ports:
      - "8081:8081"
    environment:
      - SPRING_PROFILES_ACTIVE=dev
      - EUREKA_CLIENT_SERVICE_URL_DEFAULT_ZONE=http://eureka-server:8761/eureka/
      {{#hasService "datasource" "mysql"}}
      - SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/db_user?createDatabaseIfNotExist=true
      - SPRING_DATASOURCE_USERNAME=${MYSQL_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "datasource" "postgres"}}
      - SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/db_user
      - SPRING_DATASOURCE_USERNAME=${POSTGRES_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "idp" "keycloak"}}
      - KEYCLOAK_BASE_URL=http://keycloak:8080
      - KEYCLOAK_REALM=${KEYCLOAK_REALM:-default}
      - KEYCLOAK_ADMIN_CLIENT_ID=${KEYCLOAK_ADMIN_CLIENT_ID:-admin-client}
      - KEYCLOAK_ADMIN_CLIENT_SECRET=${KEYCLOAK_ADMIN_CLIENT_SECRET:-9cvF5MPJnwfhEOCwNnQ79RmlkckAsDCj}
      {{/hasService}}
      {{#hasService "observability.tracing" "zipkin"}}
      - MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://zipkin:9411/api/v2/spans
      {{/hasService}}
      {{#hasService "observability.tracing" "tempo"}}
      - OTEL_COLLECTOR_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
      {{/hasService}}
    volumes:
      - user-service-log:/var/log/user-service
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:8081/actuator/health/readiness"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 180s
    depends_on:
      eureka-server:
        condition: service_healthy
      {{#hasService "datasource" "mysql"}}
      mysql:
        condition: service_healthy
      {{/hasService}}
      {{#hasService "datasource" "postgres"}}
      postgres:
        condition: service_healthy
      {{/hasService}}
    networks:
      - {{dotenv.PROJECT_NAME}}-network

  catalog-service:
    container_name: catalog-service
    image: {{dotenv.PROJECT_NAME}}/catalog-service:latest
    build:
      context: ../../services/catalog-service/catalog-bootstrap
      dockerfile: Dockerfile
    ports:
      - "8082:8082"
    environment:
      - SPRING_PROFILES_ACTIVE=dev
      - EUREKA_CLIENT_SERVICE_URL_DEFAULT_ZONE=http://eureka-server:8761/eureka/
      {{#hasService "ai.vectorstore" "qdrant"}}
      - QDRANT_HOST=qdrant
      - QDRANT_PORT=6334
      {{/hasService}}
      {{#hasService "datasource" "mysql"}}
      - SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/db_catalog?createDatabaseIfNotExist=true
      - SPRING_DATASOURCE_USERNAME=${MYSQL_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "datasource" "postgres"}}
      - SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/db_catalog
      - SPRING_DATASOURCE_USERNAME=${POSTGRES_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "kv-store" "redis"}}
      - SPRING_DATA_REDIS_HOST=redis
      - SPRING_DATA_REDIS_PORT=6379
      {{/hasService}}
      {{#hasService "messaging" "kafka"}}
      - SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
      {{/hasService}}
      {{#hasService "messaging" "rabbitmq"}}
      - SPRING_RABBITMQ_HOST=rabbitmq
      - SPRING_RABBITMQ_PORT=5672
      - SPRING_RABBITMQ_USERNAME=${RABBITMQ_USER:-atlas}
      - SPRING_RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "search" "elasticsearch"}}
      - ELASTICSEARCH_HOST=elasticsearch
      - ELASTICSEARCH_PORT=9200
      - ELASTICSEARCH_USERNAME=elastic
      - ELASTICSEARCH_PASSWORD=${ELASTICSEARCH_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "storage" "minio"}}
      - MINIO_ENDPOINT=http://minio:9000
      - MINIO_ACCESS_KEY=${MINIO_ROOT_USER:-atlas}
      - MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "observability.tracing" "zipkin"}}
      - MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://zipkin:9411/api/v2/spans
      {{/hasService}}
      {{#hasService "observability.tracing" "tempo"}}
      - OTEL_COLLECTOR_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
      {{/hasService}}
    volumes:
      - catalog-service-log:/var/log/catalog-service
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:8082/actuator/health/readiness"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 180s
    depends_on:
      eureka-server:
        condition: service_healthy
      {{#hasService "datasource" "mysql"}}
      mysql:
        condition: service_healthy
      {{/hasService}}
      {{#hasService "datasource" "postgres"}}
      postgres:
        condition: service_healthy
      {{/hasService}}
      {{#hasService "search" "elasticsearch"}}
      elasticsearch:
        condition: service_healthy
      {{/hasService}}
    networks:
      - {{dotenv.PROJECT_NAME}}-network

  inventory-service:
    container_name: inventory-service
    image: {{dotenv.PROJECT_NAME}}/inventory-service:latest
    build:
      context: ../../services/inventory-service/inventory-bootstrap
      dockerfile: Dockerfile
    ports:
      - "8083:8083"
    environment:
      - SPRING_PROFILES_ACTIVE=dev
      - EUREKA_CLIENT_SERVICE_URL_DEFAULT_ZONE=http://eureka-server:8761/eureka/
      {{#hasService "datasource" "mysql"}}
      - SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/db_inventory?createDatabaseIfNotExist=true
      - SPRING_DATASOURCE_USERNAME=${MYSQL_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "datasource" "postgres"}}
      - SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/db_inventory
      - SPRING_DATASOURCE_USERNAME=${POSTGRES_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "kv-store" "redis"}}
      - SPRING_DATA_REDIS_HOST=redis
      - SPRING_DATA_REDIS_PORT=6379
      {{/hasService}}
      {{#hasService "messaging" "kafka"}}
      - SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
      {{/hasService}}
      {{#hasService "messaging" "rabbitmq"}}
      - SPRING_RABBITMQ_HOST=rabbitmq
      - SPRING_RABBITMQ_PORT=5672
      - SPRING_RABBITMQ_USERNAME=${RABBITMQ_USER:-atlas}
      - SPRING_RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD:-Atlas@123456}
      {{/hasService}}
      {{#hasService "observability.tracing" "zipkin"}}
      - MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://zipkin:9411/api/v2/spans
      {{/hasService}}
      {{#hasService "observability.tracing" "tempo"}}
      - OTEL_COLLECTOR_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
      {{/hasService}}
    volumes:
      - inventory-service-log:/var/log/inventory-service
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:8083/actuator/health/readiness"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 180s
    depends_on:
      eureka-server:
        condition: service_healthy
      {{#hasService "datasource" "mysql"}}
      mysql:
        condition: service_healthy
      {{/hasService}}
      {{#hasService "datasource" "postgres"}}
      postgres:
        condition: service_healthy
      {{/hasService}}
    networks:
      - {{dotenv.PROJECT_NAME}}-network

  order-service:
    container_name: order-service
    image: {{dotenv.PROJECT_NAME}}/order-service:latest
    build:
      context: ../../services/order-service/order-bootstrap
      dockerfile: Dockerfile
    ports:
      - "8084:8084"
    environment:
      - SPRING_PROFILES_ACTIVE=dev
      - EUREKA_CLIENT_SERVICE_URL_DEFAULT_ZONE=http://eureka-server:8761/eureka/
      {{#hasService "datasource" "mysql"}}
