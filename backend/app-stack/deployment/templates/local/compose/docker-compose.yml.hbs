      {{/hasService}}
      {{#hasService "internal" "grpc"}}
      - API_CLIENT_GRPC_CATALOG_SERVICE_ADDRESS=static://catalog-service:50052
      {{/hasService}}
      {{#hasService "internal" "rest"}}
      - INTERNAL_REST_CATALOG_SERVICE_BASE_URL=http://catalog-service:8082
      {{/hasService}}
    volumes:
      - order-service-log:/var/log/order-service
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:8084/actuator/health/readiness"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 180s
    depends_on:
      eureka-server:
        condition: service_healthy
      {{#hasService "datasource" "mysql"}}
      mysql:
        condition: service_healthy
      {{/hasService}}
      {{#hasService "datasource" "postgres"}}
      postgres:
        condition: service_healthy
      {{/hasService}}
    networks:
      - {{dotenv.PROJECT_NAME}}-network

  payment-service:
    container_name: payment-service
