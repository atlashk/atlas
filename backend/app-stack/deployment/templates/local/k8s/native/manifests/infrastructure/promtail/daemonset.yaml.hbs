{{#hasService "observability.logging.stack" "loki"}}
# DaemonSet ensures Promtail runs on every node in the cluster
# This is necessary because logs are stored locally on each node
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: promtail
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: promtail
spec:
  selector:
    matchLabels:
      app: promtail
  template:
    metadata:
      labels:
        app: promtail
    spec:
      serviceAccountName: promtail
      containers:
        - name: promtail
          image: grafana/promtail:main
          args:
            - -config.file=/etc/promtail/config.yml
          env:
            # Make node name available as environment variable for labeling logs with the node they came from
            - name: HOSTNAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
          ports:
            - name: http
              containerPort: 9080
          # No need startupProbe because Promtail is fast to start
          livenessProbe:
            httpGet:
              path: /ready
              port: http
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /ready
              port: http
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          resources:
            requests:
              cpu: "50m"
              memory: "64Mi"
            limits:
              cpu: "100m"
              memory: "128Mi"
          volumeMounts:
            # Mount configuration from ConfigMap
            - name: config
              mountPath: /etc/promtail
            - name: positions
              mountPath: /run/promtail
            # Mount host's /var/log to read container logs
            - name: varlog
              mountPath: /var/log
              readOnly: true  # Read-only access for security
            # Mount Docker container directory (if using Docker runtime)
            - name: varlibdockercontainers
              mountPath: /var/lib/docker/containers
              readOnly: true  # Read-only access for security
      volumes:
        # Configuration volume from ConfigMap
        - name: config
          configMap:
            name: promtail
        - name: positions
          emptyDir: {}
        # Host path volumes to access log files
        - name: varlog
          hostPath:
            path: /var/log
        - name: varlibdockercontainers
          hostPath:
            path: /var/lib/docker/containers
      terminationGracePeriodSeconds: 10
{{/hasService}}
