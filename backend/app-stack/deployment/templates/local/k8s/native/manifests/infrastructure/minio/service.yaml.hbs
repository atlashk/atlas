{{#hasService "storage" "minio"}}
apiVersion: v1
kind: Service
metadata:
  name: minio
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: minio
spec:
  clusterIP: None
  selector:
    app: minio
  ports:
    - name: s3
      port: 9000
      targetPort: s3
    - name: console
      port: 9001
      targetPort: console
{{/hasService}}
