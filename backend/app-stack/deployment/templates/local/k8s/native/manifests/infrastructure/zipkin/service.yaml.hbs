{{#hasService "observability.tracing" "zipkin"}}
apiVersion: v1
kind: Service
metadata:
  name: zipkin
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: zipkin
spec:
  type: ClusterIP
  selector:
    app: zipkin
  ports:
    - name: http
      port: 9411
      targetPort: http
{{/hasService}}
