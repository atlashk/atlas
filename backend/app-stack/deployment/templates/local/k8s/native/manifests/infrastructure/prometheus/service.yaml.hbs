{{#hasService "observability.metrics" "prometheus"}}
apiVersion: v1
kind: Service
metadata:
  name: prometheus
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: prometheus
spec:
  clusterIP: None
  selector:
    app: prometheus
  ports:
    - name: http
      port: 9090
      targetPort: http
{{/hasService}}
