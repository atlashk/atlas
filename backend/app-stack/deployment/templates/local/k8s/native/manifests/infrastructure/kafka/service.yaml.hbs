{{#hasService "messaging" "kafka"}}
apiVersion: v1
kind: Service
metadata:
  name: kafka
  namespace: {{dotenv.PROJECT_NAME}}
  labels:
    app: kafka
spec:
  clusterIP: None
  selector:
    app: kafka
  ports:
    - port: 9092
      targetPort: 9092
      name: kafka
    - port: 29092
      targetPort: 29092
      name: kafka-internal
    - port: 29093
      targetPort: 29093
      name: controller
    - port: 9101
      targetPort: 9101
      name: jmx
{{/hasService}}
