apiVersion: 1

datasources:
{{#ifObservability "prometheus"}}
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    uid: DS_PROMETHEUS
    isDefault: true
    editable: true
    jsonData:
      timeInterval: 5s
      queryTimeout: 60s
      httpMethod: POST
    secureJsonData: {}
{{/ifObservability}}

{{#ifObservability "loki"}}
  - name: Loki
    type: loki
    access: proxy
    url: http://loki:3100
    uid: DS_LOKI
    editable: true
    jsonData:
      maxLines: 1000
    secureJsonData: {}
{{/ifObservability}}
