<%
  const iam = (stack['iam'] || '').toLowerCase();
  const datasource = (stack.datasource || '').toLowerCase();
  const fullTextSearch = (stack['full-text-search'] || '').toLowerCase();
  const kvStore = (stack['kv-store'] || '').toLowerCase();
  const messaging = (stack.messaging || '').toLowerCase();
  const notificationEmail = (stack.notification.email || '').toLowerCase();
  const observabilityLoggingStack = (stack.observability.logging.stack || '').toLowerCase();
  const observabilityMetrics = (stack.observability.metrics || '').toLowerCase();
  const observabilityTracing = (stack.observability.tracing || '').toLowerCase();
  const reverseProxy = (stack['reverse-proxy'] || '').toLowerCase();
  const storage = (stack.storage || '').toLowerCase();

  const hasMysql = datasource === 'mysql';
  const hasPostgres = datasource === 'postgres';
  const hasRedis = kvStore === 'redis';
  const hasKafka = messaging === 'kafka';
  const hasRabbitmq = messaging === 'rabbitmq';
  const hasKeycloak = iam === 'keycloak';
  const hasElasticsearch = fullTextSearch === 'elasticsearch';
  const hasMinio = storage === 'minio';
  const hasLoki = observabilityLoggingStack === 'loki';
  const hasPrometheus = observabilityMetrics === 'prometheus';
  const hasZipkin = observabilityTracing === 'zipkin';
  const hasGrafana = hasLoki || hasPrometheus || hasZipkin;
  const hasSmtp4dev = notificationEmail === 'spring';
  const hasNginx = reverseProxy === 'nginx';

  const observabilityServices = [];
  if (hasPrometheus) observabilityServices.push('prometheus');
  if (hasLoki) observabilityServices.push('loki', 'promtail');
  if (hasGrafana) observabilityServices.push('grafana');
  if (hasZipkin) observabilityServices.push('zipkin');

  const infraServices = [];
  if (hasMysql) infraServices.push('mysql');
  if (hasPostgres) infraServices.push('postgres');
  if (hasRedis) infraServices.push('redis');
  if (hasKafka) infraServices.push('kafka');
  if (hasRabbitmq) infraServices.push('rabbitmq');
  if (hasKeycloak) infraServices.push('keycloak');
  if (hasElasticsearch) infraServices.push('elasticsearch');
  if (hasMinio) infraServices.push('minio');
  if (hasSmtp4dev) infraServices.push('smtp4dev');
  if (hasPrometheus) infraServices.push('prometheus');
  if (hasLoki) infraServices.push('loki', 'promtail');
  if (hasGrafana) infraServices.push('grafana');
  if (hasZipkin) infraServices.push('zipkin');
  if (hasNginx) infraServices.push('nginx');

  const infraServicesToRun = infraServices.join(' ');
  const observabilityServicesToRun = observabilityServices.join(' ');
%>

#!/usr/bin/env bash

# =============================================================================
# Atlas Docker Compose Deployment Script (Template, Simplified)
# =============================================================================
# This script checks prerequisites, builds services, starts the current Compose
# stack, and shows a deployment summary.
# =============================================================================

set -euo pipefail
SECONDS=0

# =============================================================================
# PROJECT CONFIGURATION
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../../../../" && pwd)"
PROJECT_NAME="atlas"
COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yml"

# Docker Compose command (will be set by check_docker_compose)
DOCKER_COMPOSE_CMD="docker-compose"
 
# Default flags
SKIP_BUILD=false
INFRA_ONLY=false
ENABLE_OBSERVABILITY=true

# =============================================================================
# PREREQUISITE CHECKS
# =============================================================================

check_java_version() {
    if ! command -v java &> /dev/null; then
        echo "Java is not installed. Please install Java 17 or later." >&2
        return 1
    fi

    local java_version
    java_version=$(java -version 2>&1 | awk -F\" '/version/ {print $2; exit}')
    if [[ -z "$java_version" ]]; then
        echo "Failed to detect Java version. Please check your Java installation." >&2
        return 1
    fi

    local major_version
    if [[ "$java_version" =~ ^1\.([0-9]+) ]]; then
        major_version="${BASH_REMATCH[1]}"
    elif [[ "$java_version" =~ ^([0-9]+) ]]; then
        major_version="${BASH_REMATCH[1]}"
    else
        major_version=""
    fi

    if [[ $major_version -lt 17 ]]; then
        echo "Java version $java_version is not supported. Please install Java 17 or later." >&2
        return 1
    fi
    
    echo "Java found: $java_version"
    return 0
}

check_docker() {
    if ! docker info > /dev/null 2>&1; then
        echo "Docker is not running. Please start Docker and try again." >&2
        return 1
    fi
    echo "Docker found and running"
    return 0
}

check_docker_compose() {
    # Check for both docker-compose and docker compose (newer version)
    if command -v docker-compose &> /dev/null; then
        DOCKER_COMPOSE_CMD="docker-compose"
        echo "Docker Compose (standalone) found"
        return 0
    elif docker compose version &> /dev/null; then
        DOCKER_COMPOSE_CMD="docker compose"
        echo "Docker Compose (plugin) found"
        return 0
    else
        echo "Docker Compose is not installed or not available" >&2
        echo "Please install Docker Compose or ensure Docker Desktop is running"
        return 1
    fi
}

check_prerequisites() {
    echo "Checking prerequisites..."
    if [[ "$SKIP_BUILD" == "false" && "$INFRA_ONLY" == "false" ]]; then
        check_java_version || exit 1
    fi
    check_docker || exit 1
    check_docker_compose || exit 1
    echo "Prerequisites check passed"
}

# =============================================================================
# ARGUMENT PARSING
# =============================================================================

show_usage() {
    echo "Usage: $(basename "$0") [options]"
    echo
    echo "Options:"
    echo "  --skip-build      Skip service build step"
    echo "  --infra-only      Start only infrastructure services"
    echo "  --enable-observability <true|false>"
    echo "  -h, --help        Show this help and exit"
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --skip-build|skip-build)
                SKIP_BUILD=true
                shift
                ;;
            --infra-only|infra-only)
                INFRA_ONLY=true
                SKIP_BUILD=true
                shift
                ;;
            --enable-observability)
                shift
                if [[ $# -eq 0 || "$1" == -* ]]; then
                    echo "Missing value for --enable-observability" >&2
                    exit 1
                fi
                ENABLE_OBSERVABILITY="$1"
                shift
                ;;
            --enable-observability=*)
                ENABLE_OBSERVABILITY="${1#--enable-observability=}"
                if [[ -z "$ENABLE_OBSERVABILITY" ]]; then
                    echo "Missing value for --enable-observability" >&2
                    exit 1
                fi
                shift
                ;;
            -h|--help)
                show_usage
                exit 0
                ;;
            *)
                shift
                ;;
        esac
    done
    ENABLE_OBSERVABILITY="$(echo "$ENABLE_OBSERVABILITY" | tr '[:upper:]' '[:lower:]')"
    if [[ "$ENABLE_OBSERVABILITY" != "true" && "$ENABLE_OBSERVABILITY" != "false" ]]; then
        echo "Invalid value for --enable-observability: $ENABLE_OBSERVABILITY" >&2
        exit 1
    fi
}

# =============================================================================
# BUILD FUNCTIONS
# =============================================================================

build_services() {
    echo "Building services..."

    local build_script="$PROJECT_ROOT/backend/scripts/buildSrc/build.sh"
    if [[ ! -f "$build_script" ]]; then
        echo "Build script not found: $build_script" >&2
        exit 1
    fi

    echo "Granting execute permissions to build scripts..."
    chmod +x "$PROJECT_ROOT/backend/scripts/buildSrc/"*.sh

    echo "Invoking build script..."
    if "$build_script"; then
        echo "Build completed successfully"
    else
        echo "Build failed" >&2
        exit 1
    fi
    echo
}

# =============================================================================
# DEPLOYMENT FUNCTIONS
# =============================================================================

deploy_services() {
    echo "Deploying services using compose file: $COMPOSE_FILE"
    if [[ "$INFRA_ONLY" == "true" ]]; then
        local INFRA_SERVICES="<%= infraServicesToRun %>"
        local SERVICES_TO_RUN="$INFRA_SERVICES"
        if [[ "$ENABLE_OBSERVABILITY" == "false" ]]; then
            local OBS_SERVICES="<%= observabilityServicesToRun %>"
            SERVICES_TO_RUN="$(filter_services "$SERVICES_TO_RUN" "$OBS_SERVICES")"
        fi
        SERVICES_TO_RUN="$(echo "$SERVICES_TO_RUN" | awk '{$1=$1};1')"
        if [[ -z "$SERVICES_TO_RUN" ]]; then
            echo "No services configured for infra-only mode" >&2
            exit 1
        fi
        if $DOCKER_COMPOSE_CMD -f "$COMPOSE_FILE" -p "$PROJECT_NAME" up -d $SERVICES_TO_RUN; then
            echo "Compose stack started"
        else
            echo "Failed to start compose stack" >&2
            echo "You can check logs with: $DOCKER_COMPOSE_CMD -f $COMPOSE_FILE -p $PROJECT_NAME logs"
            exit 1
        fi
    else
        if [[ "$ENABLE_OBSERVABILITY" == "false" ]]; then
            local SERVICES_TO_RUN
            SERVICES_TO_RUN="$($DOCKER_COMPOSE_CMD -f "$COMPOSE_FILE" -p "$PROJECT_NAME" config --services)"
            SERVICES_TO_RUN="$(echo "$SERVICES_TO_RUN" | tr '\n' ' ')"
            local OBS_SERVICES="<%= observabilityServicesToRun %>"
            SERVICES_TO_RUN="$(filter_services "$SERVICES_TO_RUN" "$OBS_SERVICES")"
            if [[ -z "$SERVICES_TO_RUN" ]]; then
                echo "No services configured after disabling observability" >&2
                exit 1
            fi
            if $DOCKER_COMPOSE_CMD -f "$COMPOSE_FILE" -p "$PROJECT_NAME" up -d $SERVICES_TO_RUN; then
                echo "Compose stack started"
            else
                echo "Failed to start compose stack" >&2    
                echo "You can check logs with: $DOCKER_COMPOSE_CMD -f $COMPOSE_FILE -p $PROJECT_NAME logs"
                exit 1
            fi
        else
            if $DOCKER_COMPOSE_CMD -f "$COMPOSE_FILE" -p "$PROJECT_NAME" up -d; then
                echo "Compose stack started"
            else
                echo "Failed to start compose stack" >&2    
                echo "You can check logs with: $DOCKER_COMPOSE_CMD -f $COMPOSE_FILE -p $PROJECT_NAME logs"
                exit 1
            fi
        fi
    fi
    echo
}

filter_services() {
    local services="$1"
    local skip_list="$2"
    local filtered="$services"
    for svc in $skip_list; do
        filtered="$(echo "$filtered" | tr ' ' '\n' | grep -v "^${svc}$" | tr '\n' ' ')"
    done
    echo "$filtered" | awk '{$1=$1};1'
}

print_total_time() {
    local d=$SECONDS
    local h=$((d/3600))
    local m=$(((d%3600)/60))
    local s=$((d%60))
    printf "Total runtime: %02d:%02d:%02d\n" "$h" "$m" "$s"
}
trap print_total_time EXIT

# =============================================================================
# MAIN EXECUTION
# =============================================================================

main() {
    parse_args "$@"
    check_prerequisites

    if [[ "$SKIP_BUILD" == "true" || "$INFRA_ONLY" == "true" ]]; then
        if [[ "$INFRA_ONLY" == "true" ]]; then
            echo "Infra-only mode enabled; skipping build step"
        else
            echo "Skip build enabled; skipping build step"
        fi
    else
        build_services
    fi

    deploy_services
}

# Execute main function
main "$@"
