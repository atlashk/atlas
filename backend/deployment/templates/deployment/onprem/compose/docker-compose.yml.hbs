{{!-- 
  Docker Compose Template for Atlas Platform
  Generated using Handlebars template engine
--}}
services:

{{#hasService "mysql"}}
  mysql:
    container_name: mysql
    image: mysql:8.0
    ports:
      - "3306:3306"
    environment:
      - MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD:-secret123456}
      - MYSQL_USER=${MYSQL_USER:-atlas}
      - MYSQL_PASSWORD=${MYSQL_PASSWORD:-secret123456}
    volumes:
      - ./config/mysql/initdb.sh:/docker-entrypoint-initdb.d/initdb.sh
      - mysql-data:/var/lib/mysql
    command: --default-authentication-plugin=mysql_native_password
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h localhost -u root -p\"$MYSQL_ROOT_PASSWORD\" || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - atlas-network

{{/hasService}}
{{#hasService "postgres"}}
  postgres:
    container_name: postgres
    image: postgres:14
    ports:
      - "5432:5432"
    environment:
      - POSTGRES_USER=${POSTGRES_USER:-atlas}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-secret123456}
    volumes:
      - ./config/postgres/initdb.sh:/docker-entrypoint-initdb.d/initdb.sh
      - postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $POSTGRES_USER"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    networks:
      - atlas-network

{{/hasService}}
{{#hasService "redis"}}
  redis:
    container_name: redis
    image: redis:7-alpine
    ports:
      - "6379:6379"
    command: redis-server --appendonly yes
    volumes:
      - redis-data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - atlas-network

{{/hasService}}
{{#hasService "kafka"}}
  kafka:
    container_name: kafka
    image: confluentinc/cp-kafka:7.5.0
    ports:
      - "9092:9092"
      - "9093:9093"
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: 'CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT'
      KAFKA_ADVERTISED_LISTENERS: 'PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092'
      KAFKA_PROCESS_ROLES: 'broker,controller'
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_CONTROLLER_QUORUM_VOTERS: '1@kafka:29093'
      KAFKA_LISTENERS: 'PLAINTEXT://kafka:29092,CONTROLLER://kafka:29093,PLAINTEXT_HOST://0.0.0.0:9092'
      KAFKA_INTER_BROKER_LISTENER_NAME: 'PLAINTEXT'
      KAFKA_CONTROLLER_LISTENER_NAMES: 'CONTROLLER'
      CLUSTER_ID: 'MkU3OEVBNTcwNTJENDM2Qk'
    volumes:
      - kafka-data:/var/lib/kafka/data
    healthcheck:
      test: ["CMD-SHELL", "kafka-broker-api-versions --bootstrap-server localhost:9092 || exit 1"]
      interval: 10s
      timeout: 10s
      retries: 5
      start_period: 30s
    networks:
      - atlas-network

{{/hasService}}
{{#hasService "rabbitmq"}}
  rabbitmq:
    container_name: rabbitmq
    image: rabbitmq:3-management-alpine
    ports:
      - "5672:5672"
      - "15672:15672"
    environment:
      - RABBITMQ_DEFAULT_USER=${RABBITMQ_USER:-atlas}
      - RABBITMQ_DEFAULT_PASS=${RABBITMQ_PASSWORD:-secret123456}
    volumes:
      - rabbitmq-data:/var/lib/rabbitmq
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - atlas-network

{{/hasService}}
{{#hasService "keycloak"}}
  keycloak:
    container_name: keycloak
    image: quay.io/keycloak/keycloak:23.0
    ports:
      - "8080:8080"
    environment:
      - KEYCLOAK_ADMIN=${KEYCLOAK_ADMIN:-admin}
      - KEYCLOAK_ADMIN_PASSWORD=${KEYCLOAK_ADMIN_PASSWORD:-secret123456}
      - KC_DB=postgres
      - KC_DB_URL=jdbc:postgresql://postgres:5432/db_keycloak
      - KC_DB_USERNAME=${POSTGRES_USER:-atlas}
      - KC_DB_PASSWORD=${POSTGRES_PASSWORD:-secret123456}
    command: start-dev
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - atlas-network

{{/hasService}}
{{#hasService "elasticsearch"}}
  elasticsearch:
    container_name: elasticsearch
    image: docker.elastic.co/elasticsearch/elasticsearch:8.11.0
    ports:
      - "9200:9200"
      - "9300:9300"
    environment:
      - discovery.type=single-node
      - xpack.security.enabled=false
      - "ES_JAVA_OPTS=-Xms512m -Xmx512m"
    volumes:
      - elasticsearch-data:/usr/share/elasticsearch/data
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:9200/_cluster/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 60s
    networks:
      - atlas-network

{{/hasService}}
{{#hasService "minio"}}
  minio:
    container_name: minio
    image: minio/minio:latest
    ports:
      - "9000:9000"
      - "9001:9001"
    environment:
      - MINIO_ROOT_USER=${MINIO_ROOT_USER:-minioadmin}
      - MINIO_ROOT_PASSWORD=${MINIO_ROOT_PASSWORD:-secret123456}
    command: server /data --console-address ":9001"
    volumes:
      - minio-data:/data
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000/minio/health/live"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - atlas-network

{{/hasService}}
{{#hasService "smtp4dev"}}
  smtp4dev:
    container_name: smtp4dev
    image: rnwood/smtp4dev:latest
    ports:
      - "5000:80"
      - "25:25"
    environment:
      - ServerOptions__HostName=smtp4dev
    networks:
      - atlas-network

{{/hasService}}
{{#ifObservability "prometheus"}}
  prometheus:
    container_name: prometheus
    image: prom/prometheus:main
    ports:
      - "9090:9090"
    volumes:
      - ./config/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--web.console.libraries=/usr/share/prometheus/console_libraries'
      - '--web.console.templates=/usr/share/prometheus/consoles'
    networks:
      - atlas-network

{{/ifObservability}}
{{#ifObservability "loki"}}
  loki:
    container_name: loki
    image: grafana/loki:main
    ports:
      - "3100:3100"
    command: -config.file=/etc/loki/local-config.yaml
    volumes:
      - loki-data:/loki
    networks:
      - atlas-network

  promtail:
    container_name: promtail
    image: grafana/promtail:main
    volumes:
      - ./config/promtail/promtail.yml:/etc/promtail/promtail.yml:ro
      - /var/log:/var/log:ro
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
    command: -config.file=/etc/promtail/promtail.yml
    depends_on:
      - loki
    networks:
      - atlas-network

{{/ifObservability}}
{{#ifObservability "zipkin"}}
  zipkin:
    container_name: zipkin
    image: openzipkin/zipkin:latest
    ports:
      - "9411:9411"
    environment:
      - STORAGE_TYPE=mem
    networks:
      - atlas-network

{{/ifObservability}}
{{#ifObservability "grafana"}}
  grafana:
    container_name: grafana
    image: grafana/grafana-oss:main
    ports:
      - "3000:3000"
    environment:
      - GF_SECURITY_ADMIN_USER=${GRAFANA_ADMIN_USER:-atlas}
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD:-secret123456}
      - GF_INSTALL_PLUGINS=grafana-piechart-panel
    volumes:
      - grafana-data:/var/lib/grafana
      - ./config/grafana/provisioning:/etc/grafana/provisioning:ro
    {{#ifObservability "prometheus"}}
    depends_on:
      - prometheus
    {{/ifObservability}}
    {{#ifObservability "loki"}}
    depends_on:
      - loki
    {{/ifObservability}}
    networks:
      - atlas-network

{{/ifObservability}}
{{#hasService "nginx"}}
  nginx:
    container_name: nginx
    image: nginx:alpine
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./config/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./config/nginx/conf.d:/etc/nginx/conf.d:ro
    networks:
      - atlas-network

{{/hasService}}
{{#unless infraOnly}}
  eureka-server:
    container_name: eureka-server
    image: atlas/eureka-server:latest
    build:
      context: ../../platform/discovery-server/eureka-server
      dockerfile: Dockerfile
    ports:
      - "8761:8761"
    environment:
      - SPRING_PROFILES_ACTIVE=dev
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8761/actuator/health"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 60s
    networks:
      - atlas-network

  iam-service:
    container_name: iam-service
    image: atlas/iam-service:latest
    build:
      context: ../../services/iam-service/iam-bootstrap
      dockerfile: Dockerfile
    ports:
      - "8881:8081"
    environment:
      - SPRING_PROFILES_ACTIVE=dev
      {{#hasService "mysql"}}
      - SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/db_iam?createDatabaseIfNotExist=true
      - SPRING_DATASOURCE_USERNAME=${MYSQL_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD:-secret123456}
      {{/hasService}}
      {{#hasService "postgres"}}
      - SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/db_iam
      - SPRING_DATASOURCE_USERNAME=${POSTGRES_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD:-secret123456}
      {{/hasService}}
      {{#hasService "redis"}}
      - SPRING_DATA_REDIS_HOST=redis
      - SPRING_DATA_REDIS_PORT=6379
      {{/hasService}}
      {{#hasService "kafka"}}
      - SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
      {{/hasService}}
      {{#hasService "rabbitmq"}}
      - SPRING_RABBITMQ_HOST=rabbitmq
      - SPRING_RABBITMQ_PORT=5672
      - SPRING_RABBITMQ_USERNAME=${RABBITMQ_USER:-atlas}
      - SPRING_RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD:-secret123456}
      {{/hasService}}
      {{#ifObservability "zipkin"}}
      - MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://zipkin:9411/api/v2/spans
      {{/ifObservability}}
      - EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka/
    depends_on:
      eureka-server:
        condition: service_healthy
      {{#hasService "mysql"}}
      mysql:
        condition: service_healthy
      {{/hasService}}
      {{#hasService "postgres"}}
      postgres:
        condition: service_healthy
      {{/hasService}}
    networks:
      - atlas-network

  product-service:
    container_name: product-service
    image: atlas/product-service:latest
    build:
      context: ../../services/product-service/product-bootstrap
      dockerfile: Dockerfile
    ports:
      - "8082:8082"
    environment:
      - SPRING_PROFILES_ACTIVE=dev
      {{#hasService "mysql"}}
      - SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/db_product?createDatabaseIfNotExist=true
      - SPRING_DATASOURCE_USERNAME=${MYSQL_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD:-secret123456}
      {{/hasService}}
      {{#hasService "postgres"}}
      - SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/db_product
      - SPRING_DATASOURCE_USERNAME=${POSTGRES_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD:-secret123456}
      {{/hasService}}
      {{#hasService "redis"}}
      - SPRING_DATA_REDIS_HOST=redis
      - SPRING_DATA_REDIS_PORT=6379
      {{/hasService}}
      {{#hasService "kafka"}}
      - SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
      {{/hasService}}
      {{#hasService "rabbitmq"}}
      - SPRING_RABBITMQ_HOST=rabbitmq
      - SPRING_RABBITMQ_PORT=5672
      - SPRING_RABBITMQ_USERNAME=${RABBITMQ_USER:-atlas}
      - SPRING_RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD:-secret123456}
      {{/hasService}}
      {{#ifObservability "zipkin"}}
      - MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://zipkin:9411/api/v2/spans
      {{/ifObservability}}
      - EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka/
    depends_on:
      eureka-server:
        condition: service_healthy
      {{#hasService "mysql"}}
      mysql:
        condition: service_healthy
      {{/hasService}}
      {{#hasService "postgres"}}
      postgres:
        condition: service_healthy
      {{/hasService}}
    networks:
      - atlas-network

  order-service:
    container_name: order-service
    image: atlas/order-service:latest
    build:
      context: ../../services/order-service/order-bootstrap
      dockerfile: Dockerfile
    ports:
      - "8083:8083"
    environment:
      - SPRING_PROFILES_ACTIVE=dev
      {{#hasService "mysql"}}
      - SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/db_order?createDatabaseIfNotExist=true
      - SPRING_DATASOURCE_USERNAME=${MYSQL_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD:-secret123456}
      {{/hasService}}
      {{#hasService "postgres"}}
      - SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/db_order
      - SPRING_DATASOURCE_USERNAME=${POSTGRES_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD:-secret123456}
      {{/hasService}}
      {{#hasService "redis"}}
      - SPRING_DATA_REDIS_HOST=redis
      - SPRING_DATA_REDIS_PORT=6379
      {{/hasService}}
      {{#hasService "kafka"}}
      - SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
      {{/hasService}}
      {{#hasService "rabbitmq"}}
      - SPRING_RABBITMQ_HOST=rabbitmq
      - SPRING_RABBITMQ_PORT=5672
      - SPRING_RABBITMQ_USERNAME=${RABBITMQ_USER:-atlas}
      - SPRING_RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD:-secret123456}
      {{/hasService}}
      {{#ifObservability "zipkin"}}
      - MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://zipkin:9411/api/v2/spans
      {{/ifObservability}}
      - EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka/
    depends_on:
      eureka-server:
        condition: service_healthy
      {{#hasService "mysql"}}
      mysql:
        condition: service_healthy
      {{/hasService}}
      {{#hasService "postgres"}}
      postgres:
        condition: service_healthy
      {{/hasService}}
    networks:
      - atlas-network

  payment-service:
    container_name: payment-service
    image: atlas/payment-service:latest
    build:
      context: ../../services/payment-service/payment-bootstrap
      dockerfile: Dockerfile
    ports:
      - "8084:8084"
    environment:
      - SPRING_PROFILES_ACTIVE=dev
      {{#hasService "mysql"}}
