{{/hasService}}
{{#hasService "redis"}}
  redis-data:
{{/hasService}}
{{#hasService "kafka"}}
  kafka-data:
{{/hasService}}
{{#hasService "rabbitmq"}}
  rabbitmq-data:
{{/hasService}}
{{#hasService "elasticsearch"}}
  elasticsearch-data:
{{/hasService}}
{{#hasService "minio"}}
  minio-data:
{{/hasService}}
{{#ifObservability "prometheus"}}
  prometheus-data:
{{/ifObservability}}
{{#ifObservability "loki"}}
  loki-data:
{{/ifObservability}}
{{#ifObservability "grafana"}}
  grafana-data:
{{/ifObservability}}
