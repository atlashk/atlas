      - SPRING_DATASOURCE_USERNAME=${POSTGRES_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD:-secret123456}
      {{/hasService}}
      {{#hasService "redis"}}
      - SPRING_DATA_REDIS_HOST=redis
      - SPRING_DATA_REDIS_PORT=6379
      {{/hasService}}
      {{#hasService "kafka"}}
      - SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
      {{/hasService}}
      {{#hasService "rabbitmq"}}
      - SPRING_RABBITMQ_HOST=rabbitmq
      - SPRING_RABBITMQ_PORT=5672
      - SPRING_RABBITMQ_USERNAME=${RABBITMQ_USER:-atlas}
      - SPRING_RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD:-secret123456}
      {{/hasService}}
      {{#ifObservability "zipkin"}}
      - MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://zipkin:9411/api/v2/spans
      {{/ifObservability}}
      - EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka/
    depends_on:
      eureka-server:
        condition: service_healthy
      {{#hasService "mysql"}}
      mysql:
        condition: service_healthy
      {{/hasService}}
      {{#hasService "postgres"}}
      postgres:
        condition: service_healthy
      {{/hasService}}
    networks:
      - atlas-network

  notification-service:
    container_name: notification-service
    image: atlas/notification-service:latest
    build:
      context: ../../services/notification-service/notification-bootstrap
      dockerfile: Dockerfile
    ports:
      - "8085:8085"
    environment:
      - SPRING_PROFILES_ACTIVE=dev
      {{#hasService "mysql"}}
      - SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/db_notification?createDatabaseIfNotExist=true
      - SPRING_DATASOURCE_USERNAME=${MYSQL_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD:-secret123456}
      {{/hasService}}
      {{#hasService "postgres"}}
      - SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/db_notification
      - SPRING_DATASOURCE_USERNAME=${POSTGRES_USER:-atlas}
      - SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD:-secret123456}
      {{/hasService}}
      {{#hasService "redis"}}
      - SPRING_DATA_REDIS_HOST=redis
      - SPRING_DATA_REDIS_PORT=6379
      {{/hasService}}
      {{#hasService "kafka"}}
      - SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
      {{/hasService}}
      {{#hasService "rabbitmq"}}
      - SPRING_RABBITMQ_HOST=rabbitmq
      - SPRING_RABBITMQ_PORT=5672
      - SPRING_RABBITMQ_USERNAME=${RABBITMQ_USER:-atlas}
