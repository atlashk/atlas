# =============================================================================
HELP.md
target/
.gradle
!gradle/wrapper/gradle-wrapper.jar
build/
!**/src/main/**/build/
!**/src/test/**/build/
!scripts/build/

### STS ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/
!backend/scripts/deploy/aws/ecs/cdk/bin/

# =============================================================================
# Node.js / Frontend (Vue.js)
# =============================================================================
# Dependencies
node_modules/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Build outputs
frontend/dist/
frontend/build/
backend/scripts/deploy/aws/ecs/cdk/cdk.out/

# Environment files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Logs
logs
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
.nyc_output/

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# =============================================================================
# AWS CDK
# =============================================================================
# Compiled JavaScript and TypeScript declaration files
backend/scripts/deploy/aws/ecs/cdk/**/*.js
!backend/scripts/deploy/aws/ecs/cdk/jest.config.js
backend/scripts/deploy/aws/ecs/cdk/**/*.d.ts

# CDK asset staging directory
backend/scripts/deploy/aws/ecs/cdk/.cdk.staging/

