# Staging Environment Configuration
COMPOSE_PROJECT_NAME=atlas-stg
ENVIRONMENT=stg

# Database Configuration
MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD_STG}
MYSQL_DATABASE=atlas_staging
MYSQL_USER=atlas_stg
MYSQL_PASSWORD=${MYSQL_PASSWORD_STG}

# Redis Configuration
REDIS_PASSWORD=${REDIS_PASSWORD_STG}

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=${RABBITMQ_PASSWORD_STG}

# Application Configuration
SPRING_PROFILES_ACTIVE=stg
LOG_LEVEL=WARN

# Resource Limits (production-like for staging)
MYSQL_MEMORY=2g
REDIS_MEMORY=1g
RABBITMQ_MEMORY=2g
KAFKA_MEMORY=2g

# Port Configuration (production ports)
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
KAFKA_PORT=9092
ZIPKIN_PORT=9411
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3 