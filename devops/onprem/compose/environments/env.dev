# Development Environment Configuration
COMPOSE_PROJECT_NAME=atlas-dev
ENVIRONMENT=dev

# Database Configuration
MYSQL_ROOT_PASSWORD=root123dev
MYSQL_DATABASE=atlas_dev
MYSQL_USER=atlas_dev
MYSQL_PASSWORD=atlas123dev

# Redis Configuration
REDIS_PASSWORD=redis123dev

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin123dev

# Application Configuration
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=INFO

# Resource Limits (higher for dev environment)
MYSQL_MEMORY=1g
REDIS_MEMORY=512m
RABBITMQ_MEMORY=1g
KAFKA_MEMORY=1g

# Port Configuration (different ports to avoid conflicts)
MYSQL_PORT=3307
REDIS_PORT=6380
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
KAFKA_PORT=9093
ZIPKIN_PORT=9412
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001 