# Production Environment Configuration
COMPOSE_PROJECT_NAME=atlas-prod
ENVIRONMENT=prod

# Database Configuration
MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD_PROD}
MYSQL_DATABASE=atlas_production
MYSQL_USER=atlas_prod
MYSQL_PASSWORD=${MYSQL_PASSWORD_PROD}

# Redis Configuration
REDIS_PASSWORD=${REDIS_PASSWORD_PROD}

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=${RABBITMQ_PASSWORD_PROD}

# Application Configuration
SPRING_PROFILES_ACTIVE=prod
LOG_LEVEL=ERROR

# Resource Limits (high for production)
MYSQL_MEMORY=4g
REDIS_MEMORY=2g
RABBITMQ_MEMORY=4g
KAFKA_MEMORY=4g

# Port Configuration
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
KAFKA_PORT=9092
ZIPKIN_PORT=9411
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=5

# Security Configuration
ENABLE_TLS=true
TLS_CERT_PATH=/etc/ssl/certs
TLS_KEY_PATH=/etc/ssl/private

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30 