# Local Development Environment Configuration
COMPOSE_PROJECT_NAME=atlas-local
ENVIRONMENT=local

# Database Configuration
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=atlas
MYSQL_USER=atlas
MYSQL_PASSWORD=atlas123

# Redis Configuration
REDIS_PASSWORD=redis123

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin123

# Application Configuration
SPRING_PROFILES_ACTIVE=local
LOG_LEVEL=DEBUG

# Resource Limits (minimal for local development)
MYSQL_MEMORY=512m
REDIS_MEMORY=256m
RABBITMQ_MEMORY=512m
KAFKA_MEMORY=512m

# Port Configuration (for local development)
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
KAFKA_PORT=9092
ZIPKIN_PORT=9411
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000 